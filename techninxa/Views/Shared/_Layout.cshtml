@{
        var pageTitle = ViewData["Title"] as string
                        ?? "Custom Software & Web Development";

        var pageDescription = ViewData["Description"] as string
            ?? "Cytech Engineering develops custom software, web applications, mobile apps, and IoT solutions for businesses.";

        var canonicalUrl = ViewData["CanonicalUrl"] as string
            ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        var socialImageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Content("~/assets/cytechlogo.jpg")}";

        // The corporate site is separate from the existing IT & IoT website.
        var requestPath = Context.Request.Path.Value ?? "/";
        var isItLanding = requestPath.Equals("/it-iot-services", StringComparison.OrdinalIgnoreCase);
        var isItProjects = requestPath.StartsWith("/Projects", StringComparison.OrdinalIgnoreCase);
        var isProducts = requestPath.StartsWith("/products", StringComparison.OrdinalIgnoreCase);
        var isServices = requestPath.StartsWith("/services", StringComparison.OrdinalIgnoreCase);
        var activeDivision = ViewData["ActiveDivision"] as string
            ?? (isItLanding || isItProjects ? "it" : "none");
        var showItRail = activeDivision == "it" && (isItLanding || isItProjects);
        var primarySection = requestPath.Equals("/", StringComparison.OrdinalIgnoreCase) ? "home"
            : requestPath.Equals("/about", StringComparison.OrdinalIgnoreCase) ? "about"
            : requestPath.Equals("/contact", StringComparison.OrdinalIgnoreCase) ? "contact"
            : requestPath.Equals("/blog", StringComparison.OrdinalIgnoreCase) ? "blog"
            : isProducts ? "products"
            : isServices ? "services"
            : isItLanding || isItProjects ? "it"
            : activeDivision == "electrical" || activeDivision == "manpower"
              || activeDivision == "networking" ? "services"
            : "";


    }

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">



    <title>@pageTitle | Cytech Engineering</title>

    <meta name="description" content="@pageDescription">
    <meta name="robots" content="index, follow">

    <link rel="canonical" href="@canonicalUrl">

    <!-- Social media preview -->
    <meta property="og:site_name" content="Cytech">
    <meta property="og:type" content="website">
    <meta property="og:title" content="@pageTitle | Cytech Engineering">
    <meta property="og:description" content="@pageDescription">
    <meta property="og:url" content="@canonicalUrl">
    <meta property="og:image"
          content="@socialImageUrl">
    <meta name="google-site-verification" content="y4NSCTT8C5WLkgLRCcTODIJyCbic9nwkGvaivFHx128" />
    <!-- Favicon -->
    <link rel="icon" type="image/jpeg"
          href="~/assets/cytechlogo.jpg">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
          rel="stylesheet">

    <!-- Main stylesheet -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
    <!-- Keep this last: overrides legacy page-level blue styling consistently. -->
    <link rel="stylesheet" href="~/css/cytech-theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/cytech-divisions.css" asp-append-version="true">
    @if (ViewData["IsCorporatePage"] is true)
    {
        <link rel="stylesheet" href="~/css/cytech-corporate.css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/cytech-catalogue.css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/cytech-visual-refresh.css" asp-append-version="true">
    }
</head>
<body class="@(showItRail ? "has-it-rail" : "")">

    <div class="page-noise"></div>
    @if (ViewData["IsCorporatePage"] is true)
    {
        <div class="cy-corp-eyebrow">
            <div class="container">
                <span>CYTECH ENGINEERING <strong>/ CORPORATE EXPERIENCE</strong></span>
                <span>ENGINEERING · PEOPLE · TECHNOLOGY</span>
            </div>
        </div>
    }

    <!-- HEADER -->
    <header class="site-header" id="siteHeader">
        <div class="container nav-wrap">

            <a class="brand" href="/" aria-label="Cytech Engineering — Home">
                <img src="~/assets/cytechlogo.jpg" alt="Cytech Engineering logo">
                <span class="brand-wordmark"><strong>CYTECH</strong><small>ENGINEERING</small></span>
            </a>

            <button class="menu-toggle" type="button" aria-label="Toggle main navigation"
                    aria-controls="corporateNav" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>

            <!-- Verified industrial services and catalogue, with the existing software portfolio retained. -->
            <nav class="main-nav corporate-nav" id="corporateNav" aria-label="Cytech main navigation">
                <a href="/" data-primary-nav="home" class="@(primarySection == "home" ? "active" : "")" aria-current="@(primarySection == "home" ? "page" : null)">Home</a>
                <a href="/about" data-primary-nav="about" class="@(primarySection == "about" ? "active" : "")" aria-current="@(primarySection == "about" ? "page" : null)">About</a>
                <a href="/products" data-primary-nav="products" class="@(primarySection == "products" ? "active" : "")" aria-current="@(primarySection == "products" ? "page" : null)">Products</a>
                <div class="cy-dropdown" id="cyServices">
                    <button class="cy-dropdown__toggle @(primarySection == "services" ? "active" : "")" type="button" aria-expanded="false" aria-controls="cyServicesMenu" aria-haspopup="true">
                        Services <span class="cy-dropdown__chevron" aria-hidden="true"></span>
                    </button>
                    <div class="cy-dropdown__menu" id="cyServicesMenu" aria-label="Cytech engineering services">
                        <a href="/services">All Engineering Services</a>
                        <a href="/services#industrial-products">Industrial Product Supply</a>
                        <a href="/services#system-integration">System Integration</a>
                        <a href="/services#installation-commissioning">Installation &amp; Commissioning</a>
                        <a href="/services#maintenance-support">Maintenance &amp; Support</a>
                        <a href="/services#technical-consultation">Technical Consultation</a>
                        <a href="/networking-services">Networking Equipment</a>
                        <a href="/electrical-supply-installation">Electrical Equipment</a>
                    </div>
                </div>
                <a href="/it-iot-services" data-primary-nav="it" class="@(isItLanding || isItProjects ? "active" : "")">IT &amp; IoT</a>
                <a href="/contact" data-primary-nav="contact" class="@(primarySection == "contact" ? "active" : "")" aria-current="@(primarySection == "contact" ? "page" : null)">Contact</a>
            </nav>

            @if (ViewData["IsCorporatePage"] is true)
            {
                <a class="nav-cta" href="/contact">Request a Quote <span>↗</span></a>
            }
            else
            {
                <a class="nav-cta" href="tel:+8801711015660">Let's Talk <span>↗</span></a>
            }

        </div>
    </header>


    @if (showItRail)
    {
        <!-- IT & IoT section navigation: floating capsule on desktop, bottom dock on mobile -->
        <nav class="cy-it-rail" aria-label="IT and IoT section navigation">
            <span class="cy-it-rail__caption">IT / IoT</span>
            <a href="/it-iot-services" data-it-section="home" class="cy-it-rail__link">
                <span class="cy-it-rail__icon" aria-hidden="true">⌂</span><span>Home</span>
            </a>
            <a href="/it-iot-services#services" data-it-section="services" class="cy-it-rail__link">
                <span class="cy-it-rail__icon" aria-hidden="true">◈</span><span>Services</span>
            </a>
            <a href="/Projects" data-it-section="projects" class="cy-it-rail__link">
                <span class="cy-it-rail__icon" aria-hidden="true">▤</span><span>Projects</span>
            </a>
            <a href="/it-iot-services#about" data-it-section="about" class="cy-it-rail__link">
                <span class="cy-it-rail__icon" aria-hidden="true">ⓘ</span><span>About</span>
            </a>
            <a href="/it-iot-services#contact" data-it-section="contact" class="cy-it-rail__link">
                <span class="cy-it-rail__icon" aria-hidden="true">✉</span><span>Contact</span>
            </a>
        </nav>
    }

    <!-- PAGE CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    @if (ViewData["IsCorporatePage"] is true)
    {
        <footer class="cy-corp-footer" aria-label="Cytech corporate footer">
        <div class="container cy-corp-footer__main">
            <div>
                <a class="cy-corp-footer__logo" href="/" aria-label="Cytech Engineering Home">
                    <img src="~/assets/cytechlogo.jpg" alt="">
                    <div>CYTECH<span>ENGINEERING</span></div>
                </a>
                <p>Industrial products, automation, electrical instrumentation, networking, safety and power solutions.</p>
                <p>Industrial product supply, integration, installation, commissioning and support.</p>
            </div>
            <div>
                <h4>COMPANY</h4>
                <a href="/">Home</a><a href="/about">About</a><a href="/contact">Contact</a>
                <a href="/products">Products</a><a href="/services">Services</a>
            </div>
            <div>
                <h4>PRODUCTS &amp; SERVICES</h4>
                <a href="/products">Industrial Products</a>
                <a href="/services">Engineering Services</a>
                <a href="/networking-services">Industrial Networking</a>
                <a href="/electrical-supply-installation">Electrical Supply</a>
                <a href="/it-iot-services">IT &amp; IoT Portfolio</a>
            </div>
            <div>
                <h4>BUSINESS INQUIRIES</h4>
                <p><a href="tel:+8801711015660">01711015660</a><a href="mailto:info&#64;cytechbd.com">info&#64;cytechbd.com</a><span>Dhaka, Bangladesh</span></p><p>Share your requirements using the contact form for a quotation.</p>
                <a href="/contact" style="color:#ff9366;font-weight:750">Discuss a requirement ↗</a>
            </div>
        </div>
        <div class="container cy-corp-footer__bottom">
            <span>© @DateTime.UtcNow.Year Cytech Engineering. All rights reserved.</span>
            <span>Industrial products. Integrated engineering solutions.</span>
        </div>
    </footer>
    }
    else
    {
    <footer class="footer">
        <div class="container footer-top">

            <div class="footer-brand">
                <img src="~/assets/cytechlogo.jpg" alt="Cytech">
                <p>Innovate. Build. Elevate.</p>
            </div>

            <div class="footer-col">
                <h4>Company</h4>
                <a href="/">Home</a>
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
                <a href="/services">Services</a>
                <a href="/products">Products</a>
            </div>

            <div class="footer-col">
                <h4>Our Divisions</h4>
                <a href="/electrical-supply-installation">Electrical Supply &amp; Installation</a>
                <a href="/manpower-services">Manpower Services</a>
                <a href="/networking-services">Networking Services</a>
                <a href="/it-iot-services">IT &amp; IoT Services</a>
            </div>

            <div class="footer-col">
                <h4>Connect</h4>
                 <a href="https://www.facebook.com/profile.php?id=61591767248196"
                   target="_blank"
                   rel="noopener noreferrer">
                    Facebook
                </a>
                <a href="https://www.linkedin.com/company/techninxa/posts/?feedView=all"
                   target="_blank"
                   rel="noopener noreferrer">
                    LinkedIn
                </a>
                <a href="https://www.instagram.com/techninxa?mdxt=MXhwN21lOThyZDZhdA%3D%3D"
                   target="_blank"
                   rel="noopener noreferrer">
                    Instagram
                </a>
                <a href="https://mail.google.com/mail/?view=cm&fs=1&to=ashik@techninxa.com"
                   target="_blank"
                   rel="noopener noreferrer">
                    Mail to CEO
                </a>

                <a href="https://mail.google.com/mail/?view=cm&fs=1&to=labib@techninxa.com"
                   target="_blank"
                   rel="noopener noreferrer">
                    Mail To: Labib (Team Member)
                </a>

                <a href="https://mail.google.com/mail/?view=cm&fs=1&to=adittya@techninxa.com"
                   target="_blank"
                   rel="noopener noreferrer">
                    Mail To: Adittya (Team Member)
                </a>
            </div>

        </div>

        <div class="container footer-bottom">
            <span>© <span id="year"></span> Cytech Engineering. All rights reserved.</span>
            <span>Designed &amp; built with intention.</span>
        </div>
    </footer>
    }

    <!-- BACK TO TOP + CURSOR -->
    <button class="back-to-top" id="backToTop" type="button" aria-label="Back to top" title="Back to top">
        <span>↑</span>
    </button>

    <div class="cursor-dot"></div>
    <div class="cursor-ring"></div>

    <!-- SCRIPTS -->
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/js/cytech-navigation.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>