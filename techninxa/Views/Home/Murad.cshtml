
@{
    Layout = null;

    ViewData["Title"] = "Murad Hossain — UI/UX Design Case Study | Techninxa";
    ViewData["Description"] = "Explore Murad Hossain's UI/UX design case study featuring a task management dashboard, SaaS interface design, user experience strategy, wireframes, and design systems.";

    var memberName = ViewBag.MemberName as string ?? "Murad Hossain";
    var memberRole = ViewBag.MemberRole as string ?? "Senior UI/UX Designer";
    var memberImage = ViewBag.MemberImage as string ?? "/uploads/teams/66ee5c6f556a4df68dde77c535745ef5.jpg";

    var projects = new[]
    {
        new {
            Number = "01",
            Name = "Task Management Dashboard",
            Category = "SaaS / PRODUCT DESIGN",
            Description = "A productivity-focused workspace designed to help teams organize projects, manage priorities, track progress, and collaborate without friction.",
            Image = "/images/muradtask.png"
        },
        new {
            Number = "02",
            Name = "SaaS Dashboard Systems",
            Category = "MOBILE APP / UX",
            Description = "A mobile-first experience connecting job seekers with relevant opportunities through intuitive discovery, clear information architecture, and simplified application flows.",
            Image = "/images/muradtask2.png"
        },
        new {
            Number = "03",
            Name = "SaaS Dashboard Systems",
            Category = "WEB APP / DESIGN SYSTEM",
            Description = "Scalable dashboard interfaces with reusable components, structured layouts, data visualization, and consistent interaction patterns.",
            Image = "/images/muradtask3.png"
        }
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090d" />
    <meta name="description" content="@ViewData["Description"]" />
    <link rel="canonical" href="https://techninxa.com/" />

    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg: #09090d;
            --surface: #101015;
            --surface-2: #15151c;
            --text: #f4f3fa;
            --muted: #9695a5;
            --line: rgba(255,255,255,.1);
            --accent: #a78bfa;
            --accent-2: #7656ed;
            --green: #b4f4d0;
            --radius: 22px;
            --max: 1240px;
        }

        *, *::before, *::after { box-sizing: border-box; }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 100px;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background:
                radial-gradient(ellipse at 12% 5%, rgba(118,86,237,.13), transparent 35%),
                radial-gradient(ellipse at 88% 42%, rgba(80,65,150,.09), transparent 35%);
        }

        a { color: inherit; text-decoration: none; }
        button { font: inherit; }
        img { display: block; max-width: 100%; }

        .container {
            width: min(var(--max), calc(100% - 64px));
            margin-inline: auto;
        }

        .topbar {
            height: 82px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--line);
            background: rgba(9,9,13,.78);
            backdrop-filter: blur(18px);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            font-family: Manrope, sans-serif;
            font-weight: 800;
            letter-spacing: -.7px;
            font-size: 20px;
        }

        .brand-mark {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            background: var(--accent);
            color: #100b20;
            border-radius: 11px;
            font-size: 18px;
        }

        .nav-center {
            display: flex;
            align-items: center;
            gap: 30px;
            color: #aaa8b8;
            font-size: 13px;
        }

        .nav-center a, .footer-link { transition: color .25s; }
        .nav-center a:hover, .footer-link:hover { color: white; }

        .nav-cta, .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: 1px solid var(--line);
            border-radius: 100px;
            padding: 13px 19px;
            font-size: 13px;
            font-weight: 600;
            transition: transform .25s, background .25s, border-color .25s;
        }

        .nav-cta:hover, .button:hover { transform: translateY(-3px); }

        .button-primary {
            background: var(--accent);
            color: #151022;
            border-color: var(--accent);
        }

        .button-primary:hover { background: #c2b0ff; }

        .button-ghost:hover { border-color: var(--accent); }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--accent);
            text-transform: uppercase;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .eyebrow::before {
            content: "";
            width: 23px;
            height: 1px;
            background: currentColor;
        }

        .hero {
            padding: 108px 0 70px;
            position: relative;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1fr .74fr;
            gap: 60px;
            align-items: center;
        }

        h1, h2, h3, p { margin-top: 0; }

        h1, h2, h3 {
            font-family: Manrope, sans-serif;
            letter-spacing: -.055em;
        }

        h1 {
            max-width: 780px;
            margin: 25px 0;
            font-size: clamp(48px, 6.3vw, 83px);
            line-height: 1.03;
            font-weight: 700;
        }

        .gradient-text {
            background: linear-gradient(110deg, #d9ceff, #9879ff 50%, #e6c5ff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .hero-description {
            max-width: 590px;
            color: var(--muted);
            font-size: 16px;
            line-height: 1.9;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
        }

        .profile-card {
            position: relative;
            overflow: hidden;
            min-height: 450px;
            padding: 28px;
            border: 1px solid var(--line);
            border-radius: 28px;
            background: linear-gradient(145deg, #1c1927, #111116 65%);
            transform-style: preserve-3d;
            transition: transform .18s ease-out;
        }

        .profile-card::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: -80px;
            top: -80px;
            background: var(--accent-2);
            opacity: .2;
            filter: blur(85px);
        }

        .profile-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            position: relative;
        }

        .availability {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            color: #c3c1ce;
        }

        .availability i {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #82e4b0;
            box-shadow: 0 0 12px #82e4b0;
        }

        .pro-label {
            border: 1px solid rgba(167,139,250,.35);
            color: var(--accent);
            padding: 7px 10px;
            border-radius: 100px;
            font-size: 10px;
        }

        .avatar-wrap {
            width: 155px;
            height: 155px;
            margin: 46px auto 24px;
            border-radius: 50%;
            padding: 5px;
            background: linear-gradient(140deg, #c9b7ff, #6042c4, #292333);
            box-shadow: 0 0 65px rgba(139,92,246,.18);
        }

        .avatar-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            background: #22202a;
        }

        .profile-card h2 {
            font-size: 29px;
            text-align: center;
            margin-bottom: 7px;
            letter-spacing: -.04em;
        }

        .profile-role {
            color: var(--muted);
            text-align: center;
            font-size: 13px;
        }

        .profile-handle {
            text-align: center;
            color: var(--accent);
            font-size: 12px;
            margin-top: 13px;
        }

        .profile-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            margin-top: 30px;
            padding-top: 22px;
            border-top: 1px solid var(--line);
        }

        .profile-stats > div {
            text-align: center;
            border-right: 1px solid var(--line);
        }

        .profile-stats > div:last-child { border: 0; }

        .stat-number {
            font-family: Manrope, sans-serif;
            font-size: 22px;
            font-weight: 800;
        }

        .stat-label {
            display: block;
            color: var(--muted);
            font-size: 10px;
            margin-top: 5px;
        }

        .trust-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            margin-top: 72px;
            border: 1px solid var(--line);
            border-radius: 18px;
            background: rgba(255,255,255,.018);
        }

        .trust-item {
            padding: 23px;
            border-right: 1px solid var(--line);
        }

        .trust-item:last-child { border: 0; }

        .trust-item strong {
            display: block;
            font-family: Manrope, sans-serif;
            font-size: 25px;
            margin-bottom: 7px;
        }

        .trust-item span {
            color: var(--muted);
            font-size: 11px;
        }

        section { padding: 100px 0; }

        .section-head {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 30px;
            margin-bottom: 45px;
        }

        h2.section-title {
            font-size: clamp(35px, 4.4vw, 56px);
            line-height: 1.1;
            margin: 16px 0 0;
        }

        .section-intro {
            max-width: 400px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.9;
            margin-bottom: 4px;
        }

        .featured-project {
            border: 1px solid var(--line);
            background: var(--surface);
            border-radius: 26px;
            overflow: hidden;
        }

        .project-cover {
            position: relative;
            padding: 36px;
            background:
                radial-gradient(ellipse at 50% 45%, rgba(137,101,244,.17), transparent 60%),
                #14131b;
            overflow: hidden;
        }

        .project-cover img {
            width: 100%;
            aspect-ratio: 16 / 7;
            object-fit: cover;
            border-radius: 13px;
            border: 1px solid rgba(255,255,255,.12);
            box-shadow: 0 28px 90px rgba(0,0,0,.4);
            transition: transform .7s cubic-bezier(.2,.8,.2,1);
        }

        .featured-project:hover .project-cover img {
            transform: scale(1.025);
        }

        .cover-tag {
            position: absolute;
            z-index: 2;
            top: 54px;
            left: 54px;
            padding: 9px 12px;
            border: 1px solid rgba(255,255,255,.2);
            background: rgba(12,12,17,.76);
            backdrop-filter: blur(12px);
            border-radius: 100px;
            font-size: 10px;
            letter-spacing: .7px;
        }

        .project-info {
            display: grid;
            grid-template-columns: 1fr .65fr;
            gap: 45px;
            padding: 35px 40px 40px;
        }

        .project-info h3 {
            font-size: clamp(28px, 3.5vw, 43px);
            margin: 12px 0;
        }

        .project-info p {
            max-width: 640px;
            color: var(--muted);
            line-height: 1.9;
            font-size: 14px;
        }

        .project-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 20px;
        }

        .project-tags span, .skill-tag {
            border: 1px solid var(--line);
            padding: 9px 12px;
            border-radius: 8px;
            color: #d1cedb;
            font-size: 11px;
        }

        .project-meta {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            align-content: center;
        }

        .meta-item {
            padding-bottom: 15px;
            border-bottom: 1px solid var(--line);
        }

        .meta-item span {
            display: block;
            color: var(--muted);
            font-size: 11px;
            margin-bottom: 9px;
        }

        .meta-item strong { font-size: 14px; }

        .project-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 22px;
            margin-top: 24px;
        }

        .project-card {
            overflow: hidden;
            border: 1px solid var(--line);
            background: var(--surface);
            border-radius: 21px;
            transition: border-color .3s, transform .3s;
        }

        .project-card:hover {
            transform: translateY(-6px);
            border-color: rgba(167,139,250,.5);
        }

        .project-card-image {
            background: #181720;
            overflow: hidden;
        }

        .project-card-image img {
            width: 100%;
            height: 290px;
            object-fit: cover;
            transition: transform .6s;
        }

        .project-card:hover img { transform: scale(1.045); }

        .project-card-body { padding: 25px; }

        .project-card-body h3 {
            font-size: 25px;
            margin: 12px 0;
        }

        .project-card-body p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.8;
        }

        .project-card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 22px;
            color: var(--accent);
            font-size: 12px;
        }

        .project-card-footer span:last-child {
            font-size: 22px;
            transition: transform .25s;
        }

        .project-card:hover .project-card-footer span:last-child {
            transform: translate(3px,-3px);
        }

        .dark-panel {
            border: 1px solid var(--line);
            background: linear-gradient(135deg, #17141f, #101015);
            border-radius: 26px;
            padding: 48px;
        }

        .split-grid {
            display: grid;
            grid-template-columns: .8fr 1fr;
            gap: 75px;
            align-items: start;
        }

        .split-copy {
            position: sticky;
            top: 120px;
        }

        .split-copy p {
            color: var(--muted);
            line-height: 1.9;
            font-size: 14px;
            margin-top: 22px;
        }

        .process-list {
            border-top: 1px solid var(--line);
        }

        .process-item {
            display: grid;
            grid-template-columns: 52px 1fr;
            gap: 20px;
            padding: 25px 0;
            border-bottom: 1px solid var(--line);
        }

        .process-number {
            color: var(--accent);
            font-family: Manrope, sans-serif;
            font-size: 12px;
            padding-top: 4px;
        }

        .process-item h3 {
            font-size: 20px;
            margin-bottom: 9px;
            letter-spacing: -.03em;
        }

        .process-item p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.85;
            margin-bottom: 0;
        }

        .challenge-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 17px;
        }

        .challenge-card {
            border: 1px solid var(--line);
            border-radius: 18px;
            background: var(--surface);
            padding: 27px;
        }

        .challenge-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            color: var(--accent);
            background: rgba(167,139,250,.1);
            border-radius: 12px;
            font-size: 19px;
            margin-bottom: 23px;
        }

        .challenge-card h3 {
            font-size: 19px;
            margin-bottom: 12px;
        }

        .challenge-card p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.85;
            margin-bottom: 0;
        }

        .flow-wrap {
            padding: 32px;
            background: #0d0d12;
            border: 1px solid var(--line);
            border-radius: 22px;
            overflow: hidden;
        }

        .flow-label {
            color: var(--muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 28px;
        }

        .flow {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            align-items: center;
        }

        .flow-node {
            position: relative;
            display: grid;
            place-items: center;
            min-height: 92px;
            text-align: center;
            padding: 13px;
            border: 1px solid rgba(167,139,250,.3);
            border-radius: 13px;
            background: rgba(167,139,250,.07);
            font-size: 12px;
            line-height: 1.6;
        }

        .flow-node:not(:last-child)::after {
            content: "→";
            position: absolute;
            right: -13px;
            color: var(--accent);
            font-size: 17px;
            z-index: 2;
        }

        .flow-node small {
            display: block;
            color: var(--muted);
            font-size: 10px;
            margin-top: 5px;
        }

        .design-system {
            display: grid;
            grid-template-columns: .85fr 1fr;
            gap: 45px;
            align-items: center;
        }

        .design-system h3 {
            font-size: 31px;
            margin: 15px 0;
        }

        .design-system p {
            color: var(--muted);
            line-height: 1.9;
            font-size: 14px;
        }

        .design-board {
            border: 1px solid var(--line);
            background: #111116;
            border-radius: 22px;
            padding: 25px;
        }

        .board-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--line);
            font-size: 12px;
        }

        .board-header span:last-child { color: var(--muted); }

        .board-section { padding-top: 22px; }

        .board-section > span {
            display: block;
            font-size: 10px;
            color: var(--muted);
            margin-bottom: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .swatches {
            display: flex;
            gap: 10px;
        }

        .swatch {
            flex: 1;
            height: 65px;
            border-radius: 9px;
            border: 1px solid rgba(255,255,255,.12);
        }

        .type-sample {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding: 12px 0;
            border-bottom: 1px solid var(--line);
        }

        .type-sample strong {
            font-family: Manrope, sans-serif;
            font-size: 22px;
        }

        .type-sample small {
            color: var(--muted);
            font-size: 10px;
        }

        .component-row {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .component {
            padding: 10px 13px;
            border-radius: 9px;
            font-size: 11px;
            border: 1px solid var(--line);
        }

        .component.primary {
            color: #161021;
            background: var(--accent);
            border-color: var(--accent);
        }

        .component.status {
            color: var(--green);
            background: rgba(180,244,208,.08);
            border-color: rgba(180,244,208,.2);
        }

        .skills {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .skill-tag {
            padding: 12px 16px;
            border-radius: 100px;
            background: rgba(255,255,255,.025);
        }

        .testimonial {
            text-align: center;
            max-width: 860px;
            margin: auto;
        }

        .quote-mark {
            font-family: Georgia, serif;
            color: var(--accent);
            font-size: 70px;
            line-height: 1;
        }

        .testimonial blockquote {
            font-family: Manrope, sans-serif;
            font-size: clamp(23px, 3.5vw, 39px);
            line-height: 1.5;
            letter-spacing: -.035em;
            margin: 22px 0 30px;
        }

        .testimonial-note {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.8;
        }

        .testimonial-note strong { color: var(--text); }

        .cta-panel {
            text-align: center;
            padding: 75px 30px;
            border: 1px solid rgba(167,139,250,.25);
            border-radius: 28px;
            background:
                radial-gradient(ellipse at 50% 100%, rgba(118,86,237,.2), transparent 60%),
                #111016;
        }

        .cta-panel h2 {
            font-size: clamp(38px, 5.5vw, 64px);
            line-height: 1.1;
            max-width: 760px;
            margin: 20px auto;
        }

        .cta-panel p {
            color: var(--muted);
            max-width: 510px;
            margin: 0 auto 27px;
            line-height: 1.9;
            font-size: 14px;
        }

        footer {
            padding: 35px 0;
            border-top: 1px solid var(--line);
        }

        .footer-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 22px;
        }

        .footer-note {
            color: var(--muted);
            font-size: 11px;
        }

        .footer-links {
            display: flex;
            gap: 22px;
            color: #c2bfce;
            font-size: 12px;
        }

        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1);
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .delay-1 { transition-delay: .1s; }
        .delay-2 { transition-delay: .2s; }
        .delay-3 { transition-delay: .3s; }

        .scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--accent);
            z-index: 200;
        }

        @@media (min-width: 1500px) {
            .hero { padding-top: 130px; }
        }

        @@media (max-width: 950px) {
            .hero-grid { grid-template-columns: 1fr .8fr; gap: 28px; }
            .profile-card { min-height: 420px; padding: 22px; }
            .project-info { grid-template-columns: 1fr; gap: 22px; }
            .split-grid { grid-template-columns: 1fr; gap: 35px; }
            .split-copy { position: static; }
            .design-system { grid-template-columns: 1fr; }
            .challenge-grid { grid-template-columns: 1fr 1fr; }
            .flow { grid-template-columns: 1fr; }
            .flow-node:not(:last-child)::after {
                content: "↓";
                right: 50%;
                top: auto;
                bottom: -19px;
                transform: translateX(50%);
            }
        }

        @@media (max-width: 650px) {
            .container { width: calc(100% - 36px); }
            .topbar { height: 70px; }
            .nav-center { display: none; }
            .nav-cta { padding: 10px 13px; font-size: 11px; }
            .brand { font-size: 18px; }
            .hero { padding: 70px 0 45px; }
            .hero-grid { grid-template-columns: 1fr; gap: 35px; }
            h1 { font-size: clamp(45px, 13vw, 68px); }
            .hero-description { font-size: 14px; }
            .profile-card { min-height: 405px; }
            .avatar-wrap { margin-top: 35px; width: 130px; height: 130px; }
            .trust-row { grid-template-columns: 1fr 1fr; margin-top: 38px; }
            .trust-item:nth-child(2) { border-right: 0; }
            .trust-item:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
            section { padding: 68px 0; }
            .section-head { align-items: start; flex-direction: column; gap: 18px; margin-bottom: 28px; }
            .project-cover { padding: 15px; }
            .project-cover img { aspect-ratio: 4 / 3; }
            .cover-tag { top: 27px; left: 27px; }
            .project-info { padding: 25px 20px; }
            .project-meta { gap: 15px; }
            .project-grid { grid-template-columns: 1fr; }
            .project-card-image img { height: 245px; }
            .dark-panel { padding: 25px 20px; }
            .challenge-grid { grid-template-columns: 1fr; }
            .flow-wrap { padding: 20px; }
            .design-board { padding: 18px; }
            .swatch { height: 45px; }
            .footer-inner { align-items: start; flex-direction: column; }
            .footer-links { flex-wrap: wrap; }
            .cta-panel { padding: 55px 20px; }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                scroll-behavior: auto !important;
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
            .reveal { opacity: 1; transform: none; }
        }
    </style>
</head>
<body>
    <div class="scroll-progress" id="scrollProgress"></div>

    <header class="topbar">
        <div class="container nav">
            <a class="brand" href="/" aria-label="Techninxa home">
                <span class="brand-mark">T.</span>
                <span>techninxa</span>
            </a>

            <nav class="nav-center" aria-label="Main navigation">
                <a href="#overview">Overview</a>
                <a href="#projects">Projects</a>
                <a href="#process">Process</a>
                <a href="#design-system">Design system</a>
            </nav>

            <a class="nav-cta" href="#contact">Let's collaborate <span>↗</span></a>
        </div>
    </header>

    <main>
        <section class="hero" id="overview">
            <div class="container">
                <div class="hero-grid">
                    <div class="hero-copy reveal">
                        <span class="eyebrow">Designer spotlight / 001</span>

                        <h1>
                            Designing digital products that
                            <span class="gradient-text">feel effortless.</span>
                        </h1>

                        <p class="hero-description">
                            Meet @@uxmurad — Murad Hossain, a UI/UX designer focused on
                            transforming complex product requirements into clear,
                            intuitive and visually engaging digital experiences.
                        </p>

                        <div class="hero-actions">
                            <a class="button button-primary" href="#projects">
                                Explore selected work <span>↗</span>
                            </a>
                            <a class="button button-ghost" href="#process">
                                Discover the process <span>↓</span>
                            </a>
                        </div>
                    </div>

                    <aside class="profile-card reveal delay-2" id="profileCard">
                        <div class="profile-top">
                            <span class="availability"><i></i> Designer profile</span>
                            <span class="pro-label">FIVERR PRO · VETTED</span>
                        </div>

                        <div class="avatar-wrap">
                            <img src="@memberImage" alt="Portrait of @memberName" />
                        </div>

                        <h2>@memberName</h2>
                        <p class="profile-role">@memberRole · Bangladesh</p>
                        <div class="profile-handle">@@uxmurad</div>

                        <div class="profile-stats">
                            <div>
                                <div class="stat-number">4.9<span style="color:var(--accent)">★</span></div>
                                <span class="stat-label">Client rating</span>
                            </div>
                            <div>
                                <div class="stat-number">387</div>
                                <span class="stat-label">Reviews</span>
                            </div>
                            <div>
                                <div class="stat-number">5+</div>
                                <span class="stat-label">Years' experience</span>
                            </div>
                        </div>
                    </aside>
                </div>

                <div class="trust-row reveal">
                    <div class="trust-item">
                        <strong>387</strong>
                        <span>Published Fiverr reviews</span>
                    </div>
                    <div class="trust-item">
                        <strong>4.9/5</strong>
                        <span>Reported overall rating</span>
                    </div>
                    <div class="trust-item">
                        <strong>UI/UX</strong>
                        <span>Product design expertise</span>
                    </div>
                    <div class="trust-item">
                        <strong>Figma</strong>
                        <span>Interface & prototyping</span>
                    </div>
                </div>
            </div>
        </section>

        <section id="projects">
            <div class="container">
                <div class="section-head reveal">
                    <div>
                        <span class="eyebrow">Selected work</span>
                        <h2 class="section-title">Thoughtful design.<br /><span class="gradient-text">Real product thinking.</span></h2>
                    </div>
                    <p class="section-intro">
                        A closer look at the product experiences, interface patterns,
                        and design challenges represented in Murad's portfolio.
                    </p>
                </div>

                <article class="featured-project reveal">
                    <div class="project-cover">
                        <span class="cover-tag">FEATURED CASE STUDY · 01</span>
                        <img src="@projects[0].Image"
                             alt="Dashboard and data visualization concept for a task management SaaS product"
                             loading="lazy" />
                    </div>

                    <div class="project-info">
                        <div>
                            <span class="eyebrow">SaaS · Web application</span>
                            <h3>@projects[0].Name</h3>
                            <p>@projects[0].Description</p>

                            <div class="project-tags">
                                <span>User experience</span>
                                <span>Dashboard UI</span>
                                <span>Information architecture</span>
                                <span>Prototyping</span>
                            </div>
                        </div>

                        <div class="project-meta">
                            <div class="meta-item">
                                <span>Project category</span>
                                <strong>Product design</strong>
                            </div>
                            <div class="meta-item">
                                <span>Platform</span>
                                <strong>Web / Desktop</strong>
                            </div>
                            <div class="meta-item">
                                <span>Core focus</span>
                                <strong>Team productivity</strong>
                            </div>
                            <div class="meta-item">
                                <span>Design tool</span>
                                <strong>Figma</strong>
                            </div>
                        </div>
                    </div>
                </article>

                <div class="project-grid">
                    @foreach (var project in projects.Skip(1))
                    {
                        <article class="project-card reveal">
                            <div class="project-card-image">
                                <img src="@project.Image" alt="@project.Name interface concept" loading="lazy" />
                            </div>
                            <div class="project-card-body">
                                <span class="eyebrow">@project.Category</span>
                                <h3>@project.Name</h3>
                                <p>@project.Description</p>
                                <div class="project-card-footer">
                                    <span>Explore design concept</span>
                                    <span>↗</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>

        <section id="challenges">
            <div class="container">
                <div class="section-head reveal">
                    <div>
                        <span class="eyebrow">The design challenge</span>
                        <h2 class="section-title">Less friction.<br /><span class="gradient-text">More meaningful work.</span></h2>
                    </div>
                    <p class="section-intro">
                        A task management product must help people understand what matters,
                        what is happening, and what to do next — without adding more complexity.
                    </p>
                </div>

                <div class="challenge-grid">
                    <article class="challenge-card reveal">
                        <div class="challenge-icon">◈</div>
                        <h3>Information overload</h3>
                        <p>Organize projects, deadlines, assignees and task states into a structured hierarchy that makes important information easier to scan.</p>
                    </article>
                    <article class="challenge-card reveal delay-1">
                        <div class="challenge-icon">↗</div>
                        <h3>Unclear priorities</h3>
                        <p>Use clear status indicators, visual grouping and prioritization patterns to help teams identify the next action.</p>
                    </article>
                    <article class="challenge-card reveal delay-2">
                        <div class="challenge-icon">◎</div>
                        <h3>Fragmented collaboration</h3>
                        <p>Bring task ownership, progress and project context together to support a more transparent team workflow.</p>
                    </article>
                </div>
            </div>
        </section>

        <section id="process">
            <div class="container">
                <div class="dark-panel reveal">
                    <div class="split-grid">
                        <div class="split-copy">
                            <span class="eyebrow">Design methodology</span>
                            <h2 class="section-title">From messy workflows to <span class="gradient-text">clear experiences.</span></h2>
                            <p>
                                A product design process connects user needs with business goals.
                                The following framework illustrates how a task-management
                                dashboard can be approached from discovery through handoff.
                            </p>
                        </div>

                        <div class="process-list">
                            <div class="process-item">
                                <span class="process-number">01 / DISCOVER</span>
                                <div>
                                    <h3>Understand the problem</h3>
                                    <p>Identify user types, recurring workflow issues, business priorities, and the information people need to make decisions.</p>
                                </div>
                            </div>
                            <div class="process-item">
                                <span class="process-number">02 / DEFINE</span>
                                <div>
                                    <h3>Structure the experience</h3>
                                    <p>Map the information architecture, establish navigation, group related tasks, and define essential dashboard views.</p>
                                </div>
                            </div>
                            <div class="process-item">
                                <span class="process-number">03 / DESIGN</span>
                                <div>
                                    <h3>Build the interface</h3>
                                    <p>Develop wireframes, establish a visual hierarchy, create reusable UI components, and refine responsive layouts.</p>
                                </div>
                            </div>
                            <div class="process-item">
                                <span class="process-number">04 / VALIDATE</span>
                                <div>
                                    <h3>Test the interactions</h3>
                                    <p>Review navigation, task creation, filtering, status changes, and key flows. Iterate on findings from usability feedback.</p>
                                </div>
                            </div>
                            <div class="process-item">
                                <span class="process-number">05 / DELIVER</span>
                                <div>
                                    <h3>Prepare developer handoff</h3>
                                    <p>Organize components, document states and spacing, prepare prototypes, and communicate interaction behavior to developers.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="user-flow">
            <div class="container">
                <div class="section-head reveal">
                    <div>
                        <span class="eyebrow">Experience architecture</span>
                        <h2 class="section-title">A workflow that makes sense.</h2>
                    </div>
                    <p class="section-intro">
                        Example user journey for a team member managing work in a task dashboard.
                    </p>
                </div>

                <div class="flow-wrap reveal">
                    <div class="flow-label">Illustrative task management user flow</div>
                    <div class="flow">
                        <div class="flow-node">Dashboard<small>Review overview</small></div>
                        <div class="flow-node">My tasks<small>Find assigned work</small></div>
                        <div class="flow-node">Task details<small>Check context</small></div>
                        <div class="flow-node">Update progress<small>Change task status</small></div>
                        <div class="flow-node">Team overview<small>Review progress</small></div>
                    </div>
                </div>
            </div>
        </section>

        <section id="design-system">
            <div class="container">
                <div class="section-head reveal">
                    <div>
                        <span class="eyebrow">UI foundations</span>
                        <h2 class="section-title">Consistency is a <span class="gradient-text">feature.</span></h2>
                    </div>
                    <p class="section-intro">
                        A reusable design language helps teams extend a product without
                        sacrificing clarity or visual consistency.
                    </p>
                </div>

                <div class="design-system">
                    <div class="reveal">
                        <span class="eyebrow">A scalable UI language</span>
                        <h3>Designed as a system, not a collection of screens.</h3>
                        <p>
                            Color, typography, spacing, components and interaction states
                            work together to make the interface predictable and maintainable.
                            This board is a visual demonstration of a possible dashboard
                            design system, not a verified export from Murad's original Figma file.
                        </p>
                        <div class="skills">
                            <span class="skill-tag">Visual hierarchy</span>
                            <span class="skill-tag">Reusable components</span>
                            <span class="skill-tag">Responsive UI</span>
                            <span class="skill-tag">Interaction states</span>
                            <span class="skill-tag">Developer handoff</span>
                        </div>
                    </div>

                    <div class="design-board reveal delay-2">
                        <div class="board-header">
                            <strong>Product UI / Foundations</strong>
                            <span>Preview · 01.0</span>
                        </div>

                        <div class="board-section">
                            <span>Color palette</span>
                            <div class="swatches">
                                <div class="swatch" style="background:#7756e8"></div>
                                <div class="swatch" style="background:#252238"></div>
                                <div class="swatch" style="background:#f4f3fa"></div>
                                <div class="swatch" style="background:#a2e8bd"></div>
                                <div class="swatch" style="background:#f4c66c"></div>
                            </div>
                        </div>

                        <div class="board-section">
                            <span>Type scale</span>
                            <div class="type-sample">
                                <strong>Ag Product heading</strong>
                                <small>24 / 32 · Semibold</small>
                            </div>
                            <div class="type-sample">
                                <span>Readable interface text</span>
                                <small>14 / 22 · Regular</small>
                            </div>
                        </div>

                        <div class="board-section">
                            <span>Component examples</span>
                            <div class="component-row">
                                <span class="component primary">+ New task</span>
                                <span class="component">In progress</span>
                                <span class="component status">Completed</span>
                                <span class="component">Filter ↓</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="expertise">
            <div class="container">
                <div class="section-head reveal">
                    <div>
                        <span class="eyebrow">Capabilities</span>
                        <h2 class="section-title">Where design meets usability.</h2>
                    </div>
                    <p class="section-intro">
                        Design disciplines aligned with the services described in Murad's profile.
                    </p>
                </div>

                <div class="skills reveal">
                    <span class="skill-tag">UI/UX Design</span>
                    <span class="skill-tag">Web Application Design</span>
                    <span class="skill-tag">SaaS Dashboards</span>
                    <span class="skill-tag">Mobile App UI</span>
                    <span class="skill-tag">Desktop Interfaces</span>
                    <span class="skill-tag">Tablet Interfaces</span>
                    <span class="skill-tag">Wireframing</span>
                    <span class="skill-tag">Interactive Prototyping</span>
                    <span class="skill-tag">Figma</span>
                    <span class="skill-tag">Frontend Collaboration</span>
                </div>
            </div>
        </section>

        <section id="approach">
            <div class="container">
                <div class="testimonial reveal">
                    <div class="quote-mark">“</div>
                    <blockquote>
                        Great product design isn't just about how an interface looks.
                        It's about how naturally people can use it to accomplish something meaningful.
                    </blockquote>
                    <p class="testimonial-note">
                        <strong>Our design philosophy</strong><br />
                        Clear structure. Thoughtful interactions. Human-centered experiences.
                    </p>
                </div>
            </div>
        </section>

        <section id="contact">
            <div class="container">
                <div class="cta-panel reveal">
                    <span class="eyebrow">Have a product in mind?</span>
                    <h2>Let's make complex ideas <span class="gradient-text">feel simple.</span></h2>
                    <p>
                        Building a SaaS platform, business dashboard or mobile application?
                        Let's discuss the product experience your users deserve.
                    </p>
                    <a class="button button-primary" href="mailto:support@techninxa.com">
                        Start a conversation <span>↗</span>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container footer-inner">
            <a class="brand" href="/">
                <span class="brand-mark">T.</span>
                <span>techninxa</span>
            </a>

            <p class="footer-note">
                © @DateTime.Now.Year Cytech Enginnering. Crafted with intention.
            </p>

            <div class="footer-links">
                <a class="footer-link" href="/">Home</a>
                <a class="footer-link" href="/#team">Our team</a>
                <a class="footer-link" href="/#contact">Contact</a>
            </div>
        </div>
    </footer>

    <script>
        (() => {
            const progress = document.getElementById('scrollProgress');
            const profileCard = document.getElementById('profileCard');
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            const updateProgress = () => {
                const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
                const percentage = maxScroll > 0 ? (window.scrollY / maxScroll) * 100 : 0;
                progress.style.width = percentage + '%';
            };

            window.addEventListener('scroll', updateProgress, { passive: true });
            updateProgress();

            const revealItems = document.querySelectorAll('.reveal');

            if ('IntersectionObserver' in window && !reduceMotion) {
                const observer = new IntersectionObserver((entries, obs) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('visible');
                            obs.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.12, rootMargin: '0px 0px -35px 0px' });

                revealItems.forEach(item => observer.observe(item));
            } else {
                revealItems.forEach(item => item.classList.add('visible'));
            }

            if (profileCard && window.matchMedia('(hover: hover) and (pointer: fine)').matches && !reduceMotion) {
                profileCard.addEventListener('mousemove', event => {
                    const rect = profileCard.getBoundingClientRect();
                    const x = (event.clientX - rect.left) / rect.width - 0.5;
                    const y = (event.clientY - rect.top) / rect.height - 0.5;

                    profileCard.style.transform =
                        `perspective(1000px) rotateY(${x * 5}deg) rotateX(${-y * 5}deg)`;
                });

                profileCard.addEventListener('mouseleave', () => {
                    profileCard.style.transform =
                        'perspective(1000px) rotateY(0deg) rotateX(0deg)';
                });
            }
        })();
    </script>
</body>
</html>
