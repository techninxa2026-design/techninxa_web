<script>
(() => {
 const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 const items = document.querySelectorAll('.jp-reveal');
 if ('IntersectionObserver' in window && !reduceMotion) {
  const observer = new IntersectionObserver((entries, obs) => {
   entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); obs.unobserve(entry.target); } });
  }, { threshold: .12, rootMargin: '0px 0px -35px 0px' });
  items.forEach(item => observer.observe(item));
 } else { items.forEach(item => item.classList.add('is-visible')); }

 const box = document.querySelector('.jp-lightbox');
 const boxImg = box?.querySelector('img');
 const close = box?.querySelector('.jp-lightbox-close');
 const art = document.querySelector('[data-jp-lightbox]');
 function openBox() {
  const img = art?.querySelector('img');
  if (!box || !img || !boxImg) return;
  boxImg.src = img.currentSrc || img.src;
  box.classList.add('is-open'); box.setAttribute('aria-hidden', 'false');
  document.body.classList.add('jp-lock'); close?.focus();
 }
 function closeBox() {
  if (!box) return;
  box.classList.remove('is-open'); box.setAttribute('aria-hidden', 'true');
  document.body.classList.remove('jp-lock');
 }
 art?.addEventListener('click', openBox); close?.addEventListener('click', closeBox);
 box?.addEventListener('click', e => { if (e.target === box) closeBox(); });
 document.addEventListener('keydown', e => { if (e.key === 'Escape') closeBox(); });

 const hero = document.querySelector('.jp-hero');
 const heroImage = document.querySelector('.jp-hero-art img');
 if (hero && heroImage && !reduceMotion && window.matchMedia('(pointer:fine)').matches) {
  hero.addEventListener('pointermove', e => {
   const r = hero.getBoundingClientRect();
   const x = (e.clientX-r.left)/r.width-.5, y = (e.clientY-r.top)/r.height-.5;
   heroImage.style.transform = `scale(1.06) translate(${x*-9}px,${y*-7}px)`;
  });
  hero.addEventListener('pointerleave', () => heroImage.style.transform = 'scale(1.04)');
 }
})();
</script>
