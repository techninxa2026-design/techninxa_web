
@{
    ViewData["Title"] = "NestJS Backend API | Cytech Engineering Case Study";
    ViewData["Description"] = "Explore a NestJS backend API showcase featuring modular architecture, REST endpoints, authentication, database integration, validation and API documentation.";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050b18" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Description"]" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>
        :root {
            --bg: #050b18;
            --bg-soft: #081326;
            --panel: #0b1930;
            --panel-2: #0d203c;
            --text: #f2f7ff;
            --muted: #9eb1cd;
            --line: rgba(121, 174, 255, .17);
            --accent: #1687ff;
            --accent-2: #32d6ff;
            --purple: #865cff;
            --green: #42e6ad;
        }

        * { box-sizing: border-box; }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 30px;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: Inter, sans-serif;
        }

        body::selection {
            background: var(--accent);
            color: white;
        }

        a { color: inherit; }

        .nx-case {
            position: relative;
            isolation: isolate;
            overflow: hidden;
            background:
                radial-gradient(ellipse at 80% 4%, rgba(22,135,255,.13), transparent 35%),
                var(--bg);
        }

        .nx-case::before {
            content: "";
            position: absolute;
            z-index: -1;
            inset: 0;
            pointer-events: none;
            opacity: .17;
            background-image:
                linear-gradient(rgba(95,157,255,.12) 1px, transparent 1px),
                linear-gradient(90deg, rgba(95,157,255,.12) 1px, transparent 1px);
            background-size: 52px 52px;
            mask-image: linear-gradient(to bottom, black, transparent 85%);
        }

        .nx-wrap {
            width: min(1180px, calc(100% - 44px));
            margin: auto;
        }

        .nx-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            padding: 24px 0;
            border-bottom: 1px solid var(--line);
        }

        .nx-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            letter-spacing: -.04em;
        }

        .nx-brand-mark {
            display: grid;
            place-items: center;
            width: 39px;
            height: 39px;
            border: 1px solid rgba(50,214,255,.4);
            border-radius: 12px;
            background: linear-gradient(135deg, #146fff, #101b46);
            color: white;
            font-family: "Space Grotesk", sans-serif;
        }

        .nx-brand small {
            display: block;
            margin-top: 3px;
            color: var(--muted);
            font-size: .67rem;
            font-weight: 500;
            letter-spacing: .06em;
        }

        .nx-toplink {
            text-decoration: none;
            color: #d9e8ff;
            font-size: .84rem;
            transition: color .2s;
        }

        .nx-toplink:hover { color: var(--accent-2); }

        .nx-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--accent-2);
            font-size: .72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .17em;
        }

        .nx-eyebrow::before {
            content: "";
            width: 24px;
            height: 1px;
            background: currentColor;
        }

        .nx-hero {
            position: relative;
            padding: 82px 0 78px;
        }

        .nx-hero-grid {
            display: grid;
            grid-template-columns: .95fr 1.05fr;
            align-items: center;
            gap: 58px;
        }

        .nx-hero h1,
        .nx-section h2,
        .nx-cta h2 {
            font-family: "Space Grotesk", sans-serif;
            letter-spacing: -.065em;
        }

        .nx-hero h1 {
            margin: 24px 0;
            font-size: clamp(3.3rem, 7vw, 6.5rem);
            font-weight: 700;
            line-height: .94;
        }

        .nx-hero h1 span {
            color: var(--accent);
            background: linear-gradient(95deg, #1687ff, #32d6ff 60%, #9a7bff);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nx-lead {
            max-width: 560px;
            color: #b4c6e0;
            font-size: 1.02rem;
            line-height: 1.9;
        }

        .nx-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            margin: 25px 0;
        }

        .nx-tags span {
            padding: 9px 12px;
            border: 1px solid var(--line);
            border-radius: 99px;
            background: rgba(255,255,255,.025);
            color: #d6e5fb;
            font-size: .74rem;
        }

        .nx-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
        }

        .nx-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 47px;
            padding: 13px 18px;
            border: 1px solid transparent;
            border-radius: 12px;
            font-size: .84rem;
            font-weight: 750;
            text-decoration: none;
            transition: transform .25s, border-color .25s, background .25s;
        }

        .nx-btn:hover { transform: translateY(-3px); }

        .nx-btn-primary {
            color: white;
            background: linear-gradient(110deg, #126dff, #1687ff);
            box-shadow: 0 10px 32px rgba(22,135,255,.2);
        }

        .nx-btn-ghost {
            border-color: var(--line);
            background: rgba(255,255,255,.025);
            color: var(--text);
        }

        .nx-btn-ghost:hover { border-color: var(--accent); }

        .nx-visual {
            position: relative;
            perspective: 1100px;
        }

        .nx-poster-frame {
            position: relative;
            padding: 9px;
            overflow: hidden;
            border: 1px solid rgba(129,177,255,.27);
            border-radius: 22px;
            background: linear-gradient(145deg, #142947, #070d1b);
            box-shadow: 0 35px 100px rgba(0,0,0,.42),
                        0 0 65px rgba(22,135,255,.09);
            transform: rotateY(-5deg) rotateX(2deg);
            transition: transform .65s cubic-bezier(.2,.8,.2,1);
        }

        .nx-visual:hover .nx-poster-frame {
            transform: rotateY(0) rotateX(0) translateY(-5px);
        }

        .nx-poster-frame img {
            display: block;
            width: 100%;
            height: auto;
            border-radius: 14px;
            cursor: zoom-in;
        }

        .nx-float {
            position: absolute;
            z-index: 2;
            max-width: 220px;
            padding: 14px 16px;
            border: 1px solid rgba(108,169,255,.24);
            border-radius: 14px;
            background: rgba(7,20,40,.9);
            box-shadow: 0 18px 50px rgba(0,0,0,.3);
            backdrop-filter: blur(15px);
            animation: nxFloat 5s ease-in-out infinite;
        }

        .nx-float strong {
            display: block;
            font-size: .78rem;
        }

        .nx-float small {
            display: block;
            margin-top: 5px;
            color: var(--muted);
            font-size: .68rem;
            line-height: 1.5;
        }

        .nx-float.one { top: 8%; right: -20px; }

        .nx-float.two {
            bottom: 8%;
            left: -22px;
            animation-delay: -2.5s;
        }

        @@keyframes nxFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .nx-metrics {
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            background: rgba(8,19,38,.86);
        }

        .nx-metric-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
        }

        .nx-metric {
            padding: 26px 20px;
            border-right: 1px solid var(--line);
        }

        .nx-metric:last-child { border-right: 0; }

        .nx-metric b {
            display: block;
            margin-bottom: 7px;
            font-family: "Space Grotesk", sans-serif;
            font-size: 1.15rem;
        }

        .nx-metric span {
            color: var(--muted);
            font-size: .76rem;
        }

        .nx-section {
            position: relative;
            padding: 94px 0;
        }

        .nx-section.alt { background: rgba(8,19,38,.72); }

        .nx-section-head {
            max-width: 740px;
            margin-bottom: 40px;
        }

        .nx-section h2,
        .nx-cta h2 {
            margin: 15px 0;
            font-size: clamp(2.15rem, 4.5vw, 4rem);
            line-height: 1.05;
        }

        .nx-section-head p,
        .nx-copy p {
            color: var(--muted);
            line-height: 1.9;
        }

        .nx-two-col {
            display: grid;
            grid-template-columns: .85fr 1.15fr;
            align-items: start;
            gap: 52px;
        }

        .nx-list {
            padding: 0;
            margin: 24px 0;
            list-style: none;
        }

        .nx-list li {
            display: flex;
            gap: 12px;
            margin: 15px 0;
            color: #d8e5f7;
            font-size: .9rem;
            line-height: 1.7;
        }

        .nx-list li::before {
            content: "↗";
            flex-shrink: 0;
            color: var(--accent-2);
            font-weight: 900;
        }

        .nx-card-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .nx-card {
            min-height: 190px;
            padding: 23px;
            border: 1px solid var(--line);
            border-radius: 17px;
            background: linear-gradient(145deg, rgba(18,43,76,.72), rgba(8,19,38,.7));
            transition: transform .3s, border-color .3s, background .3s;
        }

        .nx-card:hover {
            transform: translateY(-6px);
            border-color: rgba(50,214,255,.55);
            background: linear-gradient(145deg, rgba(22,64,115,.65), rgba(8,19,38,.9));
        }

        .nx-icon {
            display: grid;
            place-items: center;
            width: 43px;
            height: 43px;
            margin-bottom: 20px;
            border: 1px solid rgba(50,214,255,.25);
            border-radius: 13px;
            background: rgba(22,135,255,.12);
            color: var(--accent-2);
            font-size: 1.2rem;
        }

        .nx-card h3 {
            margin: 0 0 10px;
            font-size: .98rem;
        }

        .nx-card p {
            margin: 0;
            color: var(--muted);
            font-size: .81rem;
            line-height: 1.75;
        }

        .nx-code-panel {
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: 19px;
            background: #06101f;
            box-shadow: 0 20px 65px rgba(0,0,0,.2);
        }

        .nx-code-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 16px 19px;
            border-bottom: 1px solid var(--line);
            background: #0b1b32;
            color: #dce9ff;
            font-size: .79rem;
        }

        .nx-dots { display: flex; gap: 6px; }

        .nx-dots i {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #4b77a8;
        }

        .nx-code {
            overflow-x: auto;
            padding: 23px;
            color: #c9dcf7;
            font-family: Consolas, "Courier New", monospace;
            font-size: .79rem;
            line-height: 1.95;
            white-space: pre;
        }

        .nx-code .kw { color: #bb9aff; }
        .nx-code .fn { color: #58caff; }
        .nx-code .str { color: #75e6ba; }
        .nx-code .cm { color: #657e9f; }

        .nx-architecture {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .nx-diagram {
            min-width: 0;
            padding: 23px;
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: 20px;
            background: linear-gradient(145deg, #0b1b31, #07101e);
        }

        .nx-diagram h3 {
            margin: 0 0 7px;
            font-family: "Space Grotesk", sans-serif;
            font-size: 1.08rem;
        }

        .nx-diagram > p {
            margin: 0 0 24px;
            color: var(--muted);
            font-size: .78rem;
            line-height: 1.7;
        }

        .nx-flow {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 9px;
        }

        .nx-flow-node {
            padding: 14px;
            border: 1px solid rgba(106,164,255,.25);
            border-radius: 12px;
            background: rgba(18,44,80,.56);
            text-align: center;
        }

        .nx-flow-node b {
            display: block;
            font-size: .86rem;
        }

        .nx-flow-node small {
            display: block;
            margin-top: 5px;
            color: var(--muted);
            font-size: .73rem;
            line-height: 1.6;
        }

        .nx-flow-node.primary {
            border-color: rgba(50,214,255,.52);
            background: linear-gradient(105deg, rgba(16,95,205,.45), rgba(93,63,194,.3));
        }

        .nx-flow-arrow {
            color: var(--accent-2);
            text-align: center;
            font-size: 1.1rem;
        }

        .nx-flow-split {
            display: grid;
            grid-template-columns: repeat(2, minmax(0,1fr));
            gap: 9px;
        }

        .nx-table-wrap { overflow-x: auto; }

        .nx-er {
            display: grid;
            grid-template-columns: repeat(2, minmax(0,1fr));
            gap: 13px;
            min-width: 0;
        }

        .nx-entity {
            min-width: 0;
            overflow: hidden;
            border: 1px solid rgba(50,214,255,.25);
            border-radius: 12px;
            background: rgba(7,18,34,.86);
        }

        .nx-entity h4 {
            margin: 0;
            padding: 12px 13px;
            border-bottom: 1px solid var(--line);
            background: rgba(22,135,255,.1);
            color: var(--accent-2);
            font-size: .83rem;
        }

        .nx-entity ul {
            padding: 12px 13px;
            margin: 0;
            list-style: none;
        }

        .nx-entity li {
            margin: 7px 0;
            color: #bfd0e8;
            font-family: Consolas, monospace;
            font-size: .69rem;
            overflow-wrap: anywhere;
        }

        .nx-entity li.key { color: #9dceff; }

        .nx-relation-note {
            margin-top: 18px;
            color: var(--muted);
            font-size: .76rem;
            line-height: 1.8;
        }

        .nx-stack {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .nx-stack-item {
            padding: 19px;
            border: 1px solid var(--line);
            border-radius: 14px;
            background: rgba(12,30,54,.75);
        }

        .nx-stack-item small {
            display: block;
            margin-bottom: 10px;
            color: var(--accent-2);
            font-size: .67rem;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .nx-stack-item b { font-size: .9rem; }

        .nx-stack-item p {
            margin-bottom: 0;
            color: var(--muted);
            font-size: .77rem;
            line-height: 1.7;
        }

        .nx-poster-section {
            display: grid;
            grid-template-columns: .75fr 1.25fr;
            gap: 45px;
            align-items: center;
        }

        .nx-poster-section img {
            display: block;
            width: 100%;
            height: auto;
            border: 1px solid var(--line);
            border-radius: 16px;
            cursor: zoom-in;
            box-shadow: 0 25px 70px #0004;
            transition: transform .35s;
        }

        .nx-poster-section img:hover { transform: scale(1.012); }

        .nx-cta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            padding: 55px;
            border: 1px solid rgba(50,214,255,.22);
            border-radius: 25px;
            background:
                radial-gradient(ellipse at 90% 0%, rgba(22,135,255,.19), transparent 45%),
                #0a1930;
        }

        .nx-cta h2 { font-size: clamp(2rem, 4vw, 3.3rem); }

        .nx-cta p {
            max-width: 620px;
            color: var(--muted);
            line-height: 1.8;
        }

        .nx-footer {
            padding: 28px 0;
            border-top: 1px solid var(--line);
            color: var(--muted);
            font-size: .76rem;
        }

        .nx-footer-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .nx-reveal {
            opacity: 0;
            transform: translateY(23px);
            transition: opacity .7s ease, transform .7s ease;
        }

        .nx-reveal.is-visible {
            opacity: 1;
            transform: translateY(0);
        }

        .nx-lightbox {
            position: fixed;
            z-index: 99999;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: rgba(2,6,15,.94);
            backdrop-filter: blur(12px);
        }

        .nx-lightbox.open { display: flex; }

        .nx-lightbox img {
            max-width: min(1000px, 94vw);
            max-height: 88vh;
            object-fit: contain;
            border-radius: 12px;
        }

        .nx-lightbox button {
            position: absolute;
            top: 18px;
            right: 22px;
            width: 44px;
            height: 44px;
            border: 1px solid var(--line);
            border-radius: 50%;
            background: #10203a;
            color: white;
            font-size: 1.5rem;
            cursor: pointer;
        }

        @@media (max-width: 900px) {
            .nx-hero-grid,
            .nx-two-col,
            .nx-poster-section {
                grid-template-columns: 1fr;
                gap: 34px;
            }

            .nx-hero { padding-top: 60px; }
            .nx-visual { max-width: 680px; margin: auto; width: 100%; }
            .nx-float.one { right: -5px; }
            .nx-float.two { left: -5px; }

            .nx-card-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
            .nx-stack { grid-template-columns: repeat(2, minmax(0,1fr)); }
            .nx-architecture { grid-template-columns: 1fr; }
            .nx-section { padding: 70px 0; }
            .nx-cta { padding: 35px; }
        }

        @@media (max-width: 560px) {
            .nx-wrap { width: calc(100% - 28px); }
            .nx-topbar { padding: 18px 0; }
            .nx-toplink { font-size: .74rem; }
            .nx-hero h1 { font-size: clamp(3rem, 15vw, 4.5rem); }
            .nx-lead { font-size: .93rem; }
            .nx-float { padding: 10px 12px; max-width: 180px; }
            .nx-float strong { font-size: .7rem; }
            .nx-float small { font-size: .62rem; }
            .nx-metric-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
            .nx-metric { padding: 19px 12px; }
            .nx-metric:nth-child(2) { border-right: 0; }
            .nx-metric:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
            .nx-metric b { font-size: .98rem; }
            .nx-metric span { font-size: .69rem; }
            .nx-card-grid { grid-template-columns: 1fr; }
            .nx-card { min-height: 0; }
            .nx-stack { grid-template-columns: repeat(2, minmax(0,1fr)); }
            .nx-stack-item { padding: 14px; }
            .nx-section { padding: 58px 0; }
            .nx-section h2 { font-size: 2.45rem; }
            .nx-diagram { padding: 16px; }
            .nx-er { gap: 8px; }
            .nx-entity h4 { padding: 10px; font-size: .75rem; }
            .nx-entity ul { padding: 9px; }
            .nx-entity li { font-size: .61rem; }
            .nx-code { padding: 16px; font-size: .7rem; }
            .nx-cta { padding: 25px; align-items: flex-start; flex-direction: column; }
            .nx-footer-inner { align-items: flex-start; flex-direction: column; }
        }

        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .nx-case *, .nx-case *::before, .nx-case *::after {
                animation: none !important;
                transition: none !important;
            }
            .nx-reveal { opacity: 1; transform: none; }
        }
    </style>
</head>

<body>
<main class="nx-case" id="nxTop">

    <div class="nx-wrap">
        <header class="nx-topbar">
            <a class="nx-brand" href="/" aria-label="Cytech Engineering home" style="text-decoration:none">
                <span class="nx-brand-mark">T</span>
                <span>
                    Cytech Engineering
                    <small>IDEAS · CODE · IMPACT</small>
                </span>
            </a>
            <a class="nx-toplink" href="/#projects">← Back to projects</a>
        </header>
    </div>

    <!-- HERO -->
    <section class="nx-hero">
        <div class="nx-wrap nx-hero-grid">

            <div class="nx-reveal">
                <span class="nx-eyebrow">Backend engineering · Case study</span>

                <h1>
                    Built to<br />
                    <span>scale.</span>
                </h1>

                <p class="nx-lead">
                    A modern backend API concept built around NestJS, designed to
                    demonstrate clean architecture, structured endpoints, secure
                    access patterns, database integration and maintainable server-side
                    development.
                </p>

                <div class="nx-tags">
                    <span>NestJS</span>
                    <span>REST API</span>
                    <span>TypeScript</span>
                    <span>Authentication</span>
                    <span>Database Design</span>
                </div>

                <div class="nx-actions">
                    <a class="nx-btn nx-btn-primary" href="#nx-features">
                        Explore capabilities <span>↘</span>
                    </a>
                    <a class="nx-btn nx-btn-ghost" href="#nx-architecture">
                        Explore architecture
                    </a>
                </div>
            </div>

            <div class="nx-visual nx-reveal">
                <div class="nx-float one">
                    <strong>⚡ Modular by design</strong>
                    <small>Organized controllers, providers and modules</small>
                </div>

                <div class="nx-poster-frame">
                    <img src="~/images/ashik/backend.png"
                         alt="Cytech Engineering NestJS backend API project poster"
                         class="nx-zoom" />
                </div>

                <div class="nx-float two">
                    <strong>◈ API-first engineering</strong>
                    <small>Designed for maintainability and integration</small>
                </div>
            </div>

        </div>
    </section>

    <!-- PROJECT SUMMARY -->
