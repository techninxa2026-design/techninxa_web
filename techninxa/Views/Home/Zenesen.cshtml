@{
    ViewData["Title"] = "Zenesen | MH Anik — Design Case Study";
    ViewData["Description"] = "Zenesen visual design case study by MH Anik, showcasing creative direction, graphic composition, visual systems and digital communication.";
    Layout = null;
}
<style>
:root{--zs-bg:#100b19;--zs-panel:#191126;--zs-panel2:#211630;--zs-text:#fff8ff;--zs-muted:#bcaec8;--zs-line:rgba(242,222,255,.14);--zs-accent:#c4ff4d;--zs-accent2:#d8a7ff}
.zenesen-case{background:var(--zs-bg);color:var(--zs-text);overflow:hidden;margin:-1rem calc(50% - 50vw) 0;font-family:inherit}
.zenesen-case *{box-sizing:border-box}.zs-wrap{width:min(1180px,calc(100% - 44px));margin:auto}
.zs-eyebrow{display:inline-flex;gap:10px;align-items:center;color:var(--zs-accent);font-size:.76rem;letter-spacing:.18em;text-transform:uppercase;font-weight:800}.zs-eyebrow:before{content:"";width:26px;height:1px;background:currentColor}
.zs-hero{position:relative;padding:110px 0 76px;isolation:isolate;background:radial-gradient(ellipse at 80% 18%,rgba(196,255,77,.15),transparent 34%),radial-gradient(ellipse at 12% 85%,rgba(216,167,255,.12),transparent 34%),linear-gradient(140deg,#100b19,#1b1027 60%,#100b19)}
.zs-grid-bg{position:absolute;inset:0;z-index:-1;opacity:.17;background-image:linear-gradient(var(--zs-line) 1px,transparent 1px),linear-gradient(90deg,var(--zs-line) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(to bottom,black,transparent)}
.zs-hero-layout{display:grid;grid-template-columns:1.02fr .98fr;gap:56px;align-items:center}
.zs-hero h1{font-size:clamp(3.1rem,7vw,6.5rem);line-height:.92;letter-spacing:-.075em;margin:22px 0 24px;font-weight:850}.zs-hero h1 span{color:var(--zs-accent)}
.zs-lead{font-size:clamp(1rem,1.5vw,1.2rem);line-height:1.8;color:#d0c3d8;max-width:600px}
.zs-tags{display:flex;flex-wrap:wrap;gap:9px;margin:26px 0}.zs-tags span{border:1px solid var(--zs-line);background:rgba(255,255,255,.035);border-radius:99px;padding:8px 13px;color:#eadff0;font-size:.78rem}
.zs-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.zs-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:13px 19px;border-radius:12px;text-decoration:none;font-weight:750;font-size:.9rem;transition:transform .25s,background .25s}.zs-btn:hover{transform:translateY(-3px)}.zs-btn-primary{background:var(--zs-accent);color:#17200b}.zs-btn-ghost{border:1px solid var(--zs-line);color:var(--zs-text)}
.zs-visual{position:relative;perspective:1000px}.zs-screen-frame{position:relative;border:1px solid rgba(255,255,255,.18);border-radius:24px;padding:9px;background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.025));box-shadow:0 35px 100px rgba(0,0,0,.4);transform:rotateY(-7deg) rotateX(2deg);transition:transform .7s cubic-bezier(.2,.8,.2,1)}.zs-visual:hover .zs-screen-frame{transform:rotateY(0) rotateX(0) translateY(-6px)}.zs-screen-frame img{display:block;width:100%;height:auto;max-height:620px;object-fit:contain;border-radius:16px}
.zs-sticker{position:absolute;z-index:3;top:-25px;right:-13px;width:104px;aspect-ratio:1;border-radius:50%;display:grid;place-items:center;text-align:center;background:var(--zs-accent);color:#17200b;font-size:.68rem;line-height:1.45;letter-spacing:.08em;font-weight:900;transform:rotate(11deg);box-shadow:0 14px 35px #0005}
.zs-float{position:absolute;z-index:2;padding:13px 16px;border-radius:14px;background:rgba(31,20,44,.9);border:1px solid var(--zs-line);backdrop-filter:blur(16px);box-shadow:0 16px 35px #0003;animation:zsFloat 5s ease-in-out infinite}.zs-float strong{display:block;font-size:.85rem}.zs-float small{color:var(--zs-muted);font-size:.7rem}.zs-float.one{top:8%;right:-5%}.zs-float.two{bottom:7%;left:-7%;animation-delay:-2.3s}
@@keyframes zsFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.zs-metrics{border-top:1px solid var(--zs-line);border-bottom:1px solid var(--zs-line);background:#140d20}.zs-metric-grid{display:grid;grid-template-columns:repeat(4,1fr)}.zs-metric{padding:26px 20px;border-right:1px solid var(--zs-line)}.zs-metric:last-child{border:0}.zs-metric b{display:block;font-size:1.35rem;letter-spacing:-.04em}.zs-metric span{font-size:.78rem;color:var(--zs-muted)}
.zs-section{padding:100px 0;position:relative}.zs-section.alt{background:#140d20}.zs-section-head{max-width:760px;margin-bottom:42px}.zs-section h2{font-size:clamp(2.1rem,4.3vw,4rem);line-height:1.03;letter-spacing:-.06em;margin:15px 0}.zs-section-head p{color:var(--zs-muted);line-height:1.8}
.zs-two-col{display:grid;grid-template-columns:.85fr 1.15fr;gap:45px;align-items:start}.zs-copy p{color:var(--zs-muted);line-height:1.9}.zs-list{list-style:none;padding:0;margin:22px 0}.zs-list li{display:flex;gap:12px;margin:14px 0;color:#e5d9ec;line-height:1.6}.zs-list li:before{content:"↗";color:var(--zs-accent);font-weight:900}
.zs-card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.zs-card{padding:23px;border:1px solid var(--zs-line);background:linear-gradient(150deg,rgba(255,255,255,.045),rgba(255,255,255,.015));border-radius:18px;min-height:190px;transition:transform .3s,border-color .3s,background .3s;transform-style:preserve-3d}.zs-card:hover{transform:translateY(-6px);border-color:rgba(196,255,77,.65);background:rgba(255,255,255,.06)}.zs-icon{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;background:rgba(196,255,77,.12);color:var(--zs-accent);font-size:1.15rem;margin-bottom:21px}.zs-card h3{font-size:1rem;margin:0 0 10px}.zs-card p{font-size:.86rem;color:var(--zs-muted);line-height:1.7;margin:0}
.zs-shot{border:1px solid var(--zs-line);border-radius:22px;padding:10px;background:#1b1228;overflow:hidden}.zs-shot img{width:100%;height:auto;display:block;border-radius:14px;cursor:zoom-in;transition:transform .4s}.zs-shot:hover img{transform:scale(1.012)}.zs-caption{display:flex;justify-content:space-between;gap:15px;padding:14px 5px 4px;color:var(--zs-muted);font-size:.78rem}
.zs-diagram{border:1px solid var(--zs-line);border-radius:20px;background:linear-gradient(135deg,#1b1228,#110b19);padding:24px;overflow-x:auto}.zs-diagram svg{width:100%;min-width:720px;height:auto;display:block}.zs-diagram-note{font-size:.8rem;color:var(--zs-muted);line-height:1.7;margin-top:15px}
.zs-stack{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.zs-stack-item{border:1px solid var(--zs-line);border-radius:14px;padding:18px;background:#1a1125}.zs-stack-item small{display:block;color:var(--zs-accent);text-transform:uppercase;font-size:.68rem;letter-spacing:.13em;margin-bottom:9px}.zs-stack-item b{font-size:.95rem}.zs-stack-item p{font-size:.78rem;color:var(--zs-muted);line-height:1.65;margin-bottom:0}
.zs-process{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.zs-step{padding:20px;border:1px solid var(--zs-line);border-radius:15px;background:#ffffff06}.zs-step b{display:block;color:var(--zs-accent);font-size:.75rem;letter-spacing:.12em;margin-bottom:18px}.zs-step h3{margin:0 0 9px;font-size:1rem}.zs-step p{color:var(--zs-muted);font-size:.83rem;line-height:1.75;margin:0}
.zs-cta{padding:62px;border-radius:26px;background:radial-gradient(circle at 90% 0%,rgba(196,255,77,.13),transparent 45%),#1b1228;border:1px solid var(--zs-line);display:flex;justify-content:space-between;align-items:center;gap:25px}.zs-cta h2{font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-.06em;margin:12px 0}.zs-cta p{color:var(--zs-muted);line-height:1.7;max-width:580px}
.zs-reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}.zs-reveal.is-visible{opacity:1;transform:translateY(0)}.zs-lightbox{position:fixed;inset:0;background:rgba(5,2,10,.94);z-index:99999;display:none;align-items:center;justify-content:center;padding:24px}.zs-lightbox.open{display:flex}.zs-lightbox img{max-width:min(1200px,95vw);max-height:88vh;border-radius:12px}.zs-lightbox button{position:absolute;top:18px;right:22px;border:1px solid #ffffff55;background:#211630;color:white;border-radius:50%;width:44px;height:44px;font-size:1.4rem;cursor:pointer}
@@media(max-width:850px){.zs-hero{padding:78px 0 55px}.zs-hero-layout,.zs-two-col{grid-template-columns:1fr;gap:35px}.zs-visual{max-width:720px;margin:0 auto;width:100%}.zs-float.one{right:0}.zs-float.two{left:0}.zs-card-grid{grid-template-columns:repeat(2,1fr)}.zs-stack{grid-template-columns:repeat(2,1fr)}.zs-cta{padding:35px;align-items:flex-start;flex-direction:column}.zs-section{padding:72px 0}}
@@media(max-width:560px){.zs-wrap{width:min(100% - 28px,1180px)}.zs-hero h1{font-size:clamp(3rem,15vw,4.5rem)}.zs-metric-grid{grid-template-columns:repeat(2,1fr)}.zs-metric:nth-child(2){border-right:0}.zs-metric:nth-child(-n+2){border-bottom:1px solid var(--zs-line)}.zs-card-grid,.zs-process{grid-template-columns:1fr}.zs-card{min-height:0}.zs-stack{grid-template-columns:1fr 1fr}.zs-stack-item{padding:14px}.zs-section{padding:60px 0}.zs-cta{padding:25px}.zs-caption{flex-direction:column;gap:5px}.zs-sticker{width:82px;right:-5px}}
@@media(prefers-reduced-motion:reduce){.zenesen-case *{animation:none!important;transition:none!important;scroll-behavior:auto!important}.zs-reveal{opacity:1;transform:none}}
</style>

<main class="zenesen-case" id="zenesenCaseStudy">
    <section class="zs-hero">
        <div class="zs-grid-bg"></div>
        <div class="zs-wrap zs-hero-layout">
            <div class="zs-reveal">
                <span class="zs-eyebrow">MH Anik / Selected project</span>
                <h1>Zenesen.<br><span>Designed to be remembered.</span></h1>
                <p class="zs-lead">A visual design case study exploring how composition, typography, colour and a consistent creative direction can give a brand a distinctive voice across digital touchpoints.</p>
                <div class="zs-tags"><span>Visual design</span><span>Graphic design</span><span>Creative direction</span><span>Digital communication</span></div>
                <div class="zs-actions">
                    <a class="zs-btn zs-btn-primary" href="#zenesen-features">Explore the work <span aria-hidden="true">↘</span></a>
                    <a class="zs-btn zs-btn-ghost" href="#zenesen-system">View visual system</a>
                </div>
            </div>
            <div class="zs-visual zs-reveal">
                <div class="zs-sticker">VISUAL<br>STORYTELLING<br>✳</div>
                <div class="zs-float one"><strong>One visual language</strong><small>Consistency across touchpoints</small></div>
                <div class="zs-screen-frame"><img src="@Url.Content("~/assets/projects/anik/zenesen-cover.jpg")" alt="Zenesen featured visual design by MH Anik" /></div>
                <div class="zs-float two"><strong>Design / Direction</strong><small>Type · Colour · Composition</small></div>
            </div>
        </div>
    </section>

    <section class="zs-metrics"><div class="zs-wrap zs-metric-grid">
        <div class="zs-metric"><b>Visual identity</b><span>Creative focus</span></div>
        <div class="zs-metric"><b>Digital-first</b><span>Presentation format</span></div>
        <div class="zs-metric"><b>Design system</b><span>Visual consistency</span></div>
        <div class="zs-metric"><b>MH Anik</b><span>Designer portfolio</span></div>
    </div></section>

    <section class="zs-section"><div class="zs-wrap zs-two-col">
        <div class="zs-section-head zs-reveal"><span class="zs-eyebrow">01 / The brief</span><h2>Give the brand a visual voice.</h2></div>
        <div class="zs-copy zs-reveal">
            <p>Zenesen is presented here as a visual design project from MH Anik’s portfolio. The case study puts the creative work first, then explains the design decisions that help a piece of communication feel clear, intentional and recognizable.</p>
            <p>The goal of this presentation is to show the thinking behind the visuals—not to invent campaign results or claim deliverables that have not been confirmed.</p>
            <ul class="zs-list"><li>Create a memorable first impression through a clear visual focal point.</li><li>Use typography and spacing to establish a confident reading order.</li><li>Balance colour, imagery and supporting graphic elements.</li><li>Keep the visual direction flexible enough for different digital placements.</li></ul>
        </div>
    </div></section>

    <section class="zs-section alt" id="zenesen-features"><div class="zs-wrap">
        <div class="zs-section-head zs-reveal"><span class="zs-eyebrow">02 / Creative capabilities</span><h2>More than a graphic.<br>A connected visual experience.</h2><p>These focus areas explain how a well-considered visual design can communicate a message and support a consistent brand presence.</p></div>
        <div class="zs-card-grid">
            <article class="zs-card zs-reveal"><div class="zs-icon">Aa</div><h3>Typography & hierarchy</h3><p>Use type scale, weight and spacing to make the primary message clear and the supporting information easy to scan.</p></article>
            <article class="zs-card zs-reveal"><div class="zs-icon">◒</div><h3>Colour direction</h3><p>Build a considered palette that creates mood, supports contrast and gives the creative a recognizable tone.</p></article>
            <article class="zs-card zs-reveal"><div class="zs-icon">▧</div><h3>Composition & balance</h3><p>Arrange the visual elements with intentional alignment, rhythm and negative space.</p></article>
            <article class="zs-card zs-reveal"><div class="zs-icon">✳</div><h3>Graphic language</h3><p>Use shapes, accents and details to add personality while keeping the main message in focus.</p></article>
            <article class="zs-card zs-reveal"><div class="zs-icon">▣</div><h3>Digital adaptability</h3><p>Consider how a composition can translate across screen sizes and different content placements.</p></article>
            <article class="zs-card zs-reveal"><div class="zs-icon">↗</div><h3>Visual consistency</h3><p>Apply repeatable design rules so individual pieces can feel connected without becoming repetitive.</p></article>
        </div>
    </div></section>

    <section class="zs-section"><div class="zs-wrap zs-two-col">
        <div class="zs-section-head zs-reveal"><span class="zs-eyebrow">03 / Featured artwork</span><h2>Look closer at the details.</h2><p>The original project artwork should remain the centrepiece. Use a high-resolution export to let the audience inspect the layout, type and graphic details.</p>
            <ul class="zs-list"><li>Observe the order in which the headline, imagery and supporting content attract attention.</li><li>Check that text remains readable against its background.</li><li>Look at the balance between filled space and breathing room.</li><li>Compare the visual tone across any additional original project pieces.</li></ul>
        </div>
        <div class="zs-shot zs-reveal"><img class="zs-zoom" src="@Url.Content("~/assets/projects/anik/zenesen-cover.jpg")" alt="Full-size Zenesen project artwork" /><div class="zs-caption"><span>Zenesen / Featured visual</span><span>Click to enlarge ↗</span></div></div>
    </div></section>

    <section class="zs-section alt" id="zenesen-system"><div class="zs-wrap">
        <div class="zs-section-head zs-reveal"><span class="zs-eyebrow">04 / Visual system map</span><h2>See how the design pieces connect.</h2><p>A visual design project can be understood as a system: the message guides the hierarchy, the visual language shapes the look, and layout rules help the work stay consistent across formats.</p></div>
        <div class="zs-diagram zs-reveal">
            <svg viewBox="0 0 1000 540" role="img" aria-label="Zenesen conceptual visual design system diagram">
                <defs><marker id="zsArrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="#c4ff4d"/></marker></defs>
                <text x="28" y="30" fill="#fff8ff" font-size="20" font-weight="700">Zenesen · Conceptual visual design system</text>
                <text x="28" y="52" fill="#bcaec8" font-size="12">A communication framework for presenting the creative decisions</text>
                <path d="M500 148 V190 M500 190 H170 V228 M500 190 V228 M500 190 H830 V228 M170 342 V385 H500 V410 M500 342 V410 M830 342 V385 H500" fill="none" stroke="#c4ff4d" stroke-opacity=".7" stroke-width="1.8" marker-end="url(#zsArrow)"/>
                <rect x="330" y="78" width="340" height="70" rx="12" fill="#2a1c3b" stroke="#c4ff4d" stroke-opacity=".85"/><text x="500" y="106" text-anchor="middle" fill="#c4ff4d" font-size="14" font-weight="700">CORE MESSAGE</text><text x="500" y="127" text-anchor="middle" fill="#fff8ff" font-size="12">Purpose · Audience · Tone</text>
                <rect x="35" y="228" width="270" height="114" rx="12" fill="#211630" stroke="#d8a7ff" stroke-opacity=".85"/><text x="170" y="255" text-anchor="middle" fill="#d8a7ff" font-size="14" font-weight="700">VISUAL LANGUAGE</text><text x="170" y="280" text-anchor="middle" fill="#fff8ff" font-size="12">Colour palette</text><text x="170" y="300" text-anchor="middle" fill="#bcaec8" font-size="12">Graphic details · Mood</text><text x="170" y="320" text-anchor="middle" fill="#bcaec8" font-size="12">Imagery direction</text>
                <rect x="365" y="228" width="270" height="114" rx="12" fill="#211630" stroke="#c4ff4d" stroke-opacity=".85"/><text x="500" y="255" text-anchor="middle" fill="#c4ff4d" font-size="14" font-weight="700">INFORMATION HIERARCHY</text><text x="500" y="280" text-anchor="middle" fill="#fff8ff" font-size="12">Headline · Supporting copy</text><text x="500" y="300" text-anchor="middle" fill="#bcaec8" font-size="12">Type scale · Contrast</text><text x="500" y="320" text-anchor="middle" fill="#bcaec8" font-size="12">Reading order</text>
                <rect x="695" y="228" width="270" height="114" rx="12" fill="#211630" stroke="#d8a7ff" stroke-opacity=".85"/><text x="830" y="255" text-anchor="middle" fill="#d8a7ff" font-size="14" font-weight="700">COMPOSITION</text><text x="830" y="280" text-anchor="middle" fill="#fff8ff" font-size="12">Grid · Alignment</text><text x="830" y="300" text-anchor="middle" fill="#bcaec8" font-size="12">Spacing · Negative space</text><text x="830" y="320" text-anchor="middle" fill="#bcaec8" font-size="12">Focal point · Balance</text>
                <rect x="260" y="410" width="480" height="78" rx="12" fill="#c4ff4d" fill-opacity=".12" stroke="#c4ff4d" stroke-opacity=".9"/><text x="500" y="440" text-anchor="middle" fill="#c4ff4d" font-size="14" font-weight="700">FINISHED DIGITAL CREATIVE</text><text x="500" y="463" text-anchor="middle" fill="#fff8ff" font-size="12">Consistent · Legible · Adaptable · Recognizable</text>
            </svg>
        </div>
        <p class="zs-diagram-note">This is a conceptual design-system illustration for explaining the project. Replace or refine the labels to reflect the actual brief, source files and design decisions for Zenesen.</p>
        <div style="height:28px"></div>
        <div class="zs-stack zs-reveal">
            <div class="zs-stack-item"><small>01 / Strategy</small><b>Message & audience</b><p>Clarify what the design needs to say, who it is for and the tone it should communicate.</p></div>
            <div class="zs-stack-item"><small>02 / Visuals</small><b>Colour & imagery</b><p>Define the mood and supporting visual cues that shape the creative direction.</p></div>
            <div class="zs-stack-item"><small>03 / Layout</small><b>Type & composition</b><p>Organize content through scale, alignment, contrast and deliberate spacing.</p></div>
            <div class="zs-stack-item"><small>04 / Delivery</small><b>Format & consistency</b><p>Prepare the artwork for its intended placement and keep visual rules consistent.</p></div>
        </div>
    </div></section>

    <section class="zs-section"><div class="zs-wrap">
        <div class="zs-section-head zs-reveal"><span class="zs-eyebrow">05 / Design process</span><h2>From intent to a finished visual.</h2><p>A clear way to communicate the creative workflow to potential clients, from understanding the brief through refinement and delivery.</p></div>
        <div class="zs-process">
            <article class="zs-step zs-reveal"><b>STEP 01</b><h3>Understand</h3><p>Define the audience, communication goal, content and tone before making visual choices.</p></article>
            <article class="zs-step zs-reveal"><b>STEP 02</b><h3>Explore</h3><p>Compare reference directions, palette options, typography and possible compositions.</p></article>
            <article class="zs-step zs-reveal"><b>STEP 03</b><h3>Compose</h3><p>Bring the selected direction together with intentional hierarchy and visual balance.</p></article>
            <article class="zs-step zs-reveal"><b>STEP 04</b><h3>Refine</h3><p>Review legibility, spacing and consistency, then prepare the artwork for its intended use.</p></article>
        </div>
    </div></section>

    <section class="zs-section alt"><div class="zs-wrap">
        <div class="zs-section-head zs-reveal"><span class="zs-eyebrow">06 / Design principles</span><h2>Every choice should earn its place.</h2></div>
        <div class="zs-card-grid">
            <article class="zs-card zs-reveal"><div class="zs-icon">01</div><h3>Message before decoration</h3><p>Visual impact should reinforce the communication goal instead of distracting from it.</p></article>
            <article class="zs-card zs-reveal"><div class="zs-icon">02</div><h3>Hierarchy creates clarity</h3><p>Scale, contrast and spacing help viewers understand what matters first.</p></article>
            <article class="zs-card zs-reveal"><div class="zs-icon">03</div><h3>Consistency builds recognition</h3><p>Repeatable rules help related pieces feel like parts of one coherent visual world.</p></article>
        </div>
    </div></section>

    <section class="zs-section"><div class="zs-wrap zs-cta zs-reveal">
        <div><span class="zs-eyebrow">Work with MH Anik</span><h2>Make your next idea<br>visually memorable.</h2><p>Looking for thoughtful graphic design, a clearer creative direction or engaging digital visuals? Start a conversation with Anik about your project brief.</p></div>
        <a class="zs-btn zs-btn-primary" href="mailto:mhanik417@gmail.com">Contact Anik <span aria-hidden="true">↗</span></a>
    </div></section>
</main>

<div class="zs-lightbox" id="zsLightbox" role="dialog" aria-modal="true" aria-label="Expanded Zenesen artwork">
    <button type="button" aria-label="Close image" id="zsLightboxClose">×</button>
    <img src="" alt="Expanded Zenesen artwork" id="zsLightboxImage" />
</div>
<script>
(() => {
    const root = document.querySelector('.zenesen-case');
    if (!root) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealEls = root.querySelectorAll('.zs-reveal');
    if ('IntersectionObserver' in window && !reduceMotion) {
        const observer = new IntersectionObserver(entries => entries.forEach(entry => {
            if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
        }), { threshold: .12 });
        revealEls.forEach(el => observer.observe(el));
    } else revealEls.forEach(el => el.classList.add('is-visible'));

    if (!reduceMotion && window.matchMedia('(pointer:fine)').matches) {
        const visual = root.querySelector('.zs-visual');
        const frame = root.querySelector('.zs-screen-frame');
        if (visual && frame) {
            visual.addEventListener('pointermove', e => {
                const r = visual.getBoundingClientRect();
                const x = (e.clientX - r.left) / r.width - .5;
                const y = (e.clientY - r.top) / r.height - .5;
                frame.style.transform = `rotateY(${x * 10 - 3}deg) rotateX(${-y * 6}deg) translateY(-4px)`;
            });
            visual.addEventListener('pointerleave', () => frame.style.transform = '');
        }
    }

    const box = document.getElementById('zsLightbox');
    const boxImg = document.getElementById('zsLightboxImage');
    const close = document.getElementById('zsLightboxClose');
    root.querySelectorAll('.zs-zoom').forEach(img => img.addEventListener('click', () => {
        boxImg.src = img.src; boxImg.alt = img.alt; box.classList.add('open'); document.body.style.overflow = 'hidden'; close.focus();
    }));
    const closeBox = () => { box.classList.remove('open'); document.body.style.overflow = ''; boxImg.src = ''; };
    close.addEventListener('click', closeBox);
    box.addEventListener('click', e => { if (e.target === box) closeBox(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && box.classList.contains('open')) closeBox(); });
})();
</script>
