/* === Interactive motion layer: parallax, depth, cursor and scroll feedback === */
:root{--scroll-progress:0%;--pointer-x:50%;--pointer-y:50%}
html{scroll-behavior:smooth}
body{cursor:auto}
.motion-progress{position:fixed;z-index:100;top:0;left:0;height:2px;width:var(--scroll-progress);background:linear-gradient(90deg,var(--red),var(--cyan));box-shadow:0 0 15px #ff303b80;pointer-events:none;transform-origin:left center}
.cursor-aura,.cursor-core{position:fixed;z-index:99;left:0;top:0;pointer-events:none;border-radius:50%;opacity:0;transform:translate(-50%,-50%);transition:opacity .25s,border-color .2s,background .2s}
.cursor-aura{width:38px;height:38px;border:1px solid #ff596480;background:#ff303b08;mix-blend-mode:screen}
.cursor-core{width:5px;height:5px;background:var(--red);box-shadow:0 0 12px #ff303b}
body.has-pointer .cursor-aura,body.has-pointer .cursor-core{opacity:1}
body.cursor-hover .cursor-aura{width:58px;height:58px;border-color:#64e5ffbb;background:#64e5ff12}
body.cursor-hover .cursor-core{transform:translate(-50%,-50%) scale(1.6);background:var(--cyan)}
.hero{--hero-shift:0px;overflow:hidden}
.hero-grid{perspective:1200px}
.hero-visual{transform:translate3d(var(--visual-x,0px),var(--visual-y,0px),0);transform-style:preserve-3d;will-change:transform}
.hero-image-shell{transform-style:preserve-3d;will-change:transform;transition:box-shadow .35s,border-color .35s}
.hero-image-shell:hover{border-color:#ffffff50;box-shadow:0 42px 110px #000b,0 0 50px #ff303b12}
.float-card{will-change:transform;transition:border-color .25s}
.hero-halo{transform:translate3d(0,var(--halo-y,0px),0) scale(var(--halo-scale,1));will-change:transform}
#scene{will-change:transform}
.section,.section-light,.workflow,.stack-section,.cta{isolation:isolate;overflow:hidden}
.section-orb{position:absolute;z-index:-1;pointer-events:none;width:clamp(220px,32vw,480px);aspect-ratio:1;border-radius:50%;filter:blur(85px);opacity:.1;transform:translate3d(0,var(--orb-y,0px),0);will-change:transform}
.section-orb.orb-red{right:-12%;top:8%;background:var(--red)}
.section-orb.orb-cyan{left:-15%;bottom:2%;background:#3978ff;opacity:.08}
.section-light .section-orb{opacity:.06}
.reveal{will-change:transform,opacity}
.visual-card,.feature-card,.stat,.stack-item,.flow-step,.concept-card,.entity{transform-style:preserve-3d;backface-visibility:hidden}
.visual-card,.feature-card,.stat,.stack-item,.flow-step{transition:transform .35s cubic-bezier(.2,.75,.25,1),border-color .3s,box-shadow .3s;will-change:transform}
.feature-card:hover,.visual-card:hover{box-shadow:0 28px 65px #0002;border-color:#ff303b70}
.stack-item:hover{border-color:#ff303b60;box-shadow:0 12px 35px #0003}
.feature-card .feature-icon,.stack-symbol,.arch-icon{transition:transform .35s cubic-bezier(.2,.8,.2,1)}
.feature-card:hover .feature-icon,.stack-item:hover .stack-symbol{transform:translateZ(22px) rotate(-7deg) scale(1.08)}
.button,.nav-cta{position:relative;isolation:isolate;overflow:hidden}
.button:before,.nav-cta:before{content:"";position:absolute;z-index:-1;inset:-2px;background:linear-gradient(110deg,transparent 25%,#ffffff2b 48%,transparent 68%);transform:translateX(-130%);transition:transform .7s cubic-bezier(.2,.7,.2,1)}
.button:hover:before,.nav-cta:hover:before{transform:translateX(130%)}
.button .arrow{display:inline-block;transition:transform .25s}
.button:hover .arrow{transform:translate(3px,-2px)}
.visual-card img,.journey-image img,.hero-image-shell img{transition:transform .8s cubic-bezier(.2,.7,.2,1),filter .5s}
.visual-card:hover img,.journey-image:hover img{transform:scale(1.025);filter:saturate(1.08)}
.section-head h2 em,.cta h2 em{display:inline-block;transition:letter-spacing .5s}
.section-head:hover h2 em{letter-spacing:-.025em}
/* Soft pointer-following spotlight on dark content panels */
.stat,.feature-card,.stack-item,.flow-step,.concept-card{background-image:radial-gradient(260px circle at var(--pointer-x) var(--pointer-y),rgba(255,255,255,.055),transparent 60%),linear-gradient(140deg,#15181e,#0d0f13)}
.section-light .feature-card{background-image:radial-gradient(260px circle at var(--pointer-x) var(--pointer-y),rgba(255,48,59,.07),transparent 60%);background-color:#fff}
/* Architecture layers subtly lift into focus as they enter view */
.arch-node,.arch-connector,.entity{transition:transform .45s cubic-bezier(.2,.75,.25,1),box-shadow .35s,border-color .35s}
.arch-node:hover,.entity:hover{transform:translateY(-4px) scale(1.015);box-shadow:0 18px 35px #0003;border-color:#ff303b90}
.flow-arrow{display:inline-block;animation:flowPulse 2.2s ease-in-out infinite}
@@keyframes flowPulse{0%,100%{opacity:.45;transform:translateX(0)}50%{opacity:1;transform:translateX(4px)}}
