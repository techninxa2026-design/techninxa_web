<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r152/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>
<script>
(() => {
 const $ = (s,root=document) => root.querySelector(s);
 const $$ = (s,root=document) => [...root.querySelectorAll(s)];
 $('#year').textContent = new Date().getFullYear();

 // Responsive navigation
 const menu = $('.menu-toggle'), nav = $('.nav');
 menu.addEventListener('click', () => {
   const open = nav.classList.toggle('open');
   menu.setAttribute('aria-expanded', String(open));
   menu.textContent = open ? '✕' : '☰';
 });
 $$('.nav a').forEach(a => a.addEventListener('click', () => {
   nav.classList.remove('open'); menu.setAttribute('aria-expanded','false'); menu.textContent='☰';
 }));

 // Reveal on scroll, with a no-JS / reduced-motion friendly fallback
 const revealItems = $$('.reveal');
 if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
   const observer = new IntersectionObserver(entries => entries.forEach(entry => {
     if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
   }), {threshold:.12, rootMargin:'0px 0px -35px 0px'});
   revealItems.forEach(el => observer.observe(el));
 } else revealItems.forEach(el => el.classList.add('is-visible'));

 // Anime.js micro-interactions
 if (window.anime && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
   anime({targets:'.hero-copy .eyebrow, .hero-copy h1, .hero-copy .hero-lead, .hero-copy .hero-actions, .hero-meta',
     opacity:[0,1], translateY:[18,0], delay:anime.stagger(110,{start:120}), duration:850, easing:'easeOutExpo'});
   anime({targets:'.hero-image-shell', opacity:[0,1], translateY:[25,0], rotate:[0,1.2], delay:300, duration:1100, easing:'easeOutExpo'});
   $$('.button').forEach(btn => {
     btn.addEventListener('mouseenter', () => anime({targets:btn,scale:1.025,duration:180,easing:'easeOutQuad'}));
     btn.addEventListener('mouseleave', () => anime({targets:btn,scale:1,duration:220,easing:'easeOutQuad'}));
   });
 }

 // Three.js abstract 3D wire sculpture — decorative only, with a safe fallback.
 const canvas = $('#scene');
 if (canvas && window.THREE && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
   try {
     const renderer = new THREE.WebGLRenderer({canvas, alpha:true, antialias:true});
     renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.7));
     const scene = new THREE.Scene();
     const camera = new THREE.PerspectiveCamera(42,1,.1,100);
     camera.position.z = 8;
     const group = new THREE.Group(); scene.add(group);
     const geometry = new THREE.TorusKnotGeometry(1.65,.005,220,12,2,5);
     const material = new THREE.MeshBasicMaterial({color:0xff303b,wireframe:true,transparent:true,opacity:.35});
     const knot = new THREE.Mesh(geometry,material); group.add(knot);
     const ringGeo = new THREE.TorusGeometry(2.35,.003,8,150);
     const ringMat = new THREE.MeshBasicMaterial({color:0x64e5ff,transparent:true,opacity:.2});
     const ring = new THREE.Mesh(ringGeo,ringMat); ring.rotation.x = 1.15; ring.rotation.y = .25; group.add(ring);
     const points = new THREE.BufferGeometry();
     const pointCount = 240, positions = new Float32Array(pointCount*3);
     for(let i=0;i<pointCount;i++){
       const radius=2.2+Math.random()*1.7, angle=Math.random()*Math.PI*2;
       positions[i*3]=Math.cos(angle)*radius;
       positions[i*3+1]=(Math.random()-.5)*4.6;
       positions[i*3+2]=Math.sin(angle)*radius*.55;
     }
     points.setAttribute('position',new THREE.BufferAttribute(positions,3));
     const stars = new THREE.Points(points,new THREE.PointsMaterial({color:0xffffff,size:.018,transparent:true,opacity:.55}));
     group.add(stars);
     const resize=()=>{
       const rect=canvas.getBoundingClientRect();
       renderer.setSize(Math.max(rect.width,1),Math.max(rect.height,1),false);
       camera.aspect=Math.max(rect.width,1)/Math.max(rect.height,1); camera.updateProjectionMatrix();
     };
     resize(); window.addEventListener('resize',resize,{passive:true});
     let pointerX=0,pointerY=0;
     window.addEventListener('pointermove',e=>{
       pointerX=(e.clientX/window.innerWidth-.5)*.25;
       pointerY=(e.clientY/window.innerHeight-.5)*.2;
     },{passive:true});
     const tick=()=>{
       group.rotation.y += .0017;
       group.rotation.x += .00055;
       group.rotation.y += (pointerX-group.rotation.y)*.002;
       knot.rotation.z += .001;
       ring.rotation.z -= .0007;
       renderer.render(scene,camera);
       requestAnimationFrame(tick);
     };
     tick();
   } catch(e) { canvas.style.display='none'; }
 } else if (canvas) canvas.style.display='none';


 // Advanced interaction layer: smooth parallax, tilt, magnetic CTAs and scroll feedback.
 const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 const finePointer = window.matchMedia('(hover:hover) and (pointer:fine)').matches;
 const progress = $('.motion-progress');
 const cursorAura = $('.cursor-aura');
 const cursorCore = $('.cursor-core');
 let pointerClientX = window.innerWidth * .5, pointerClientY = window.innerHeight * .5;
 let cursorX = pointerClientX, cursorY = pointerClientY;
 let scrollY = window.scrollY || 0, scrollTicking = false;
 const clamp = (value,min,max) => Math.min(max,Math.max(min,value));

 // Scroll progress and parallax are batched to one animation frame for smoothness.
 const updateScrollMotion = () => {
   const maxScroll = Math.max(1,document.documentElement.scrollHeight-window.innerHeight);
   if(progress) progress.style.width = `${(window.scrollY/maxScroll)*100}%`;
   scrollY = window.scrollY || 0;
   const hero = $('.hero');
   if(hero && scrollY < hero.offsetHeight + 100){
     const heroVisual = $('.hero-visual');
     const scene = $('#scene');
     const halo = $('.hero-halo');
     const ratio = clamp(scrollY/Math.max(hero.offsetHeight,1),0,1.3);
     if(heroVisual && window.innerWidth > 760) heroVisual.style.setProperty('--visual-y',`${ratio * -34}px`);
     if(scene) scene.style.transform = `translate3d(0,${ratio * 34}px,0) scale(${1 + ratio*.025})`;
     if(halo) halo.style.setProperty('--halo-y',`${ratio * 28}px`);
   }
   $$('.section-orb').forEach((orb,index)=>{
     const parent = orb.parentElement;
     if(!parent) return;
     const rect = parent.getBoundingClientRect();
     if(rect.bottom > -150 && rect.top < window.innerHeight + 150){
       const offset = (window.innerHeight*.5 - (rect.top + rect.height*.5)) * (index%2 ? .055 : .085);
       orb.style.setProperty('--orb-y',`${offset}px`);
     }
   });
   scrollTicking = false;
 };
 window.addEventListener('scroll',()=>{
   if(!scrollTicking){scrollTicking=true;requestAnimationFrame(updateScrollMotion);}
 },{passive:true});
 window.addEventListener('resize',updateScrollMotion,{passive:true});
 updateScrollMotion();

 // Decorative atmospheric orbs add depth while keeping the layout clean.
 if(!reduceMotion){
   $$('.section:not(.section-light),.workflow,.stack-section,.cta').forEach((section,index)=>{
     if(section.querySelector('.section-orb')) return;
     const orb=document.createElement('span');
     orb.className=`section-orb ${index%2?'orb-cyan':'orb-red'}`;
     orb.setAttribute('aria-hidden','true');
     section.prepend(orb);
   });
 }

 // Desktop custom cursor with delayed follow for a tactile, premium feel.
 if(finePointer && !reduceMotion && cursorAura && cursorCore){
   document.body.classList.add('interactive-cursor');
   document.addEventListener('pointermove',event=>{
     pointerClientX=event.clientX;pointerClientY=event.clientY;
     document.body.classList.add('has-pointer');
     const target=event.target.closest('a,button,.feature-card,.visual-card,.stack-item,.stat,.flow-step,.entity');
     document.body.classList.toggle('cursor-hover',!!target);
     document.documentElement.style.setProperty('--pointer-x',`${(event.clientX/window.innerWidth)*100}%`);
     document.documentElement.style.setProperty('--pointer-y',`${(event.clientY/window.innerHeight)*100}%`);
   },{passive:true});
   document.addEventListener('pointerleave',()=>document.body.classList.remove('has-pointer','cursor-hover'));
   const followCursor=()=>{
     cursorX+=(pointerClientX-cursorX)*.22;cursorY+=(pointerClientY-cursorY)*.22;
     cursorAura.style.left=`${cursorX}px`;cursorAura.style.top=`${cursorY}px`;
     cursorCore.style.left=`${pointerClientX}px`;cursorCore.style.top=`${pointerClientY}px`;
     requestAnimationFrame(followCursor);
   };followCursor();
 }

 // Perspective tilt on selected cards; disabled on touch and reduced-motion devices.
 if(finePointer && !reduceMotion){
   const tiltTargets=$$('.feature-card,.visual-card,.stat,.stack-item,.flow-step,.concept-card');
   tiltTargets.forEach(card=>{
     card.addEventListener('pointermove',event=>{
       if(event.pointerType==='touch') return;
       const rect=card.getBoundingClientRect();
       const x=(event.clientX-rect.left)/rect.width;
       const y=(event.clientY-rect.top)/rect.height;
       const rotateY=(x-.5)*7;
       const rotateX=(.5-y)*7;
       card.style.transform=`perspective(900px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-3px)`;
       card.style.setProperty('--pointer-x',`${x*100}%`);
       card.style.setProperty('--pointer-y',`${y*100}%`);
     });
     card.addEventListener('pointerleave',()=>{card.style.transform='';});
   });

   // Magnetic movement is deliberately subtle, so buttons remain easy to target.
   $$('.hero-actions .button,.cta-actions .button,.nav-cta').forEach(button=>{
     button.addEventListener('pointermove',event=>{
       const rect=button.getBoundingClientRect();
       const dx=event.clientX-(rect.left+rect.width/2);
       const dy=event.clientY-(rect.top+rect.height/2);
       button.style.transform=`translate(${dx*.07}px,${dy*.12}px) translateY(-2px)`;
     });
     button.addEventListener('pointerleave',()=>{button.style.transform='';});
   });

   // Pointer-driven 3D hero tilt and gentle independent float-card movement.
   const heroGrid=$('.hero-grid'), heroVisual=$('.hero-visual'), heroShell=$('.hero-image-shell');
   if(heroGrid && heroVisual && heroShell){
     heroGrid.addEventListener('pointermove',event=>{
       if(window.innerWidth<=760)return;
       const rect=heroGrid.getBoundingClientRect();
       const x=(event.clientX-rect.left)/rect.width-.5;
       const y=(event.clientY-rect.top)/rect.height-.5;
       heroShell.style.transform=`rotateY(${x*5}deg) rotateX(${-y*4}deg) rotateZ(1deg) translateZ(8px)`;
       heroVisual.style.setProperty('--visual-x',`${x*-9}px`);
       $$('.float-card',heroVisual).forEach((card,index)=>{
         card.style.translate=`${x*(index? -10:10)}px ${y*(index? -7:7)}px`;
       });
     });
     heroGrid.addEventListener('pointerleave',()=>{
       heroShell.style.transform='';heroVisual.style.setProperty('--visual-x','0px');
       $$('.float-card',heroVisual).forEach(card=>card.style.translate='');
     });
   }
 }

 // Active navigation hint based on the section currently in view.
 const navLinks=$$('.nav a[href^="#"]');
 const observedSections=navLinks.map(link=>$(link.getAttribute('href'))).filter(Boolean);
 if('IntersectionObserver' in window && !reduceMotion && observedSections.length){
   const navObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{
     if(!entry.isIntersecting)return;
     navLinks.forEach(link=>link.classList.toggle('is-current',link.getAttribute('href')===`#${entry.target.id}`));
   }),{rootMargin:'-28% 0px -62% 0px',threshold:0});
   observedSections.forEach(section=>navObserver.observe(section));
 }

 // Horizontal ERD pan support: native touch/trackpad scrolling is intentionally retained.
})();
</script>
