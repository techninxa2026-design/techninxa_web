@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090a0d">
<meta name="description" content="MotoServis — a Flutter motorcycle service platform concept showcasing mobile UX, service booking, workshop discovery, architecture and data modeling.">
<title>MotoServis — Flutter Product Case Study | Techninxa</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
 --bg:#090a0d;--panel:#101216;--panel2:#15181e;--ink:#f5f5f2;--muted:#a0a4ad;--muted2:#747a85;
 --line:rgba(255,255,255,.12);--red:#ff303b;--red2:#d70e1b;--cyan:#64e5ff;--lime:#c8ff74;
 --serif:Georgia,"Times New Roman",serif;--sans:"DM Sans",sans-serif;--display:"Manrope",sans-serif;--mono:"DM Mono",monospace;
 --max:1240px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;z-index:-2;pointer-events:none;background:radial-gradient(ellipse at 75% 7%,rgba(255,48,59,.11),transparent 27%),radial-gradient(ellipse at 8% 43%,rgba(63,119,255,.07),transparent 28%),#090a0d}
a{color:inherit;text-decoration:none}
button{font:inherit}
img{display:block;max-width:100%}
::selection{background:var(--red);color:white}
.container{width:min(var(--max),calc(100% - 56px));margin-inline:auto}
.eyebrow{display:flex;align-items:center;gap:10px;color:#b9bdc5;font:500 10px var(--mono);letter-spacing:.14em;text-transform:uppercase}
.eyebrow:before{content:"";width:7px;height:7px;border-radius:2px;background:var(--red);box-shadow:0 0 16px #ff303b88}
.muted{color:var(--muted)}
.serif{font-family:var(--serif);font-weight:400;font-style:italic;letter-spacing:-.055em}
.accent{color:var(--red)}
.topbar{height:74px;position:fixed;z-index:20;inset:0 0 auto;border-bottom:1px solid rgba(255,255,255,.09);background:rgba(9,10,13,.72);backdrop-filter:blur(18px)}
.topbar-inner{height:100%;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:11px;font:800 13px var(--display);letter-spacing:-.03em}
.brand-mark{width:28px;height:28px;display:grid;place-items:center;border:1px solid #ff303b88;border-radius:9px;color:var(--red);font-size:16px}
.brand small{display:block;margin-top:2px;font:9px var(--mono);letter-spacing:.12em;color:#858b95}
.nav{display:flex;align-items:center;gap:27px;color:#b5bac2;font-size:11px}
.nav a{transition:color .2s;position:relative}.nav a:hover,.nav a.is-current{color:white}.nav a.is-current:not(.nav-cta):after{content:"";position:absolute;left:0;right:0;bottom:-9px;height:2px;background:var(--red);border-radius:2px}
.nav-cta{padding:11px 15px;border:1px solid #ffffff30;border-radius:999px;color:white!important}
.menu-toggle{display:none;background:none;color:white;border:1px solid var(--line);border-radius:10px;padding:8px 11px}
.hero{min-height:840px;padding:150px 0 58px;position:relative;isolation:isolate}
#scene{position:absolute;inset:65px 0 0 35%;z-index:-1;opacity:.85;pointer-events:none}
.hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:48px;align-items:center;min-height:590px}
.hero-copy{position:relative;z-index:2}
.hero-kicker{display:flex;align-items:center;gap:10px;margin-bottom:24px}
.pill{border:1px solid var(--line);border-radius:999px;padding:8px 11px;color:#c8cbd1;font:10px var(--mono);letter-spacing:.05em}
.hero h1{font:700 clamp(60px,8vw,108px)/.92 var(--display);letter-spacing:-.09em;margin:0 0 25px;max-width:700px}
.hero h1 .line2{display:block;color:var(--red)}
.hero h1 .italic{font-family:var(--serif);font-weight:400;font-style:italic;letter-spacing:-.08em}
.hero-lead{max-width:550px;font-size:16px;line-height:1.85;color:#b0b5be}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:31px}
.button{display:inline-flex;align-items:center;justify-content:center;gap:18px;padding:14px 18px;border-radius:999px;font-size:11px;font-weight:700;transition:transform .25s,background .25s,border-color .25s}
.button:hover{transform:translateY(-3px)}
.button-primary{background:var(--red);color:white;border:1px solid var(--red);box-shadow:0 8px 30px #ff303b22}
.button-primary:hover{background:#ff4b54}
.button-ghost{border:1px solid #ffffff30;color:#f4f4f4}
.button-ghost:hover{border-color:#ffffff80}
.button .arrow{font-size:16px}
.hero-visual{position:relative;min-width:0}
.hero-halo{position:absolute;inset:12% 5%;border-radius:50%;background:#ff303b22;filter:blur(65px)}
.hero-image-shell{position:relative;padding:11px;border:1px solid #ffffff27;border-radius:24px;background:linear-gradient(140deg,#ffffff1c,#ffffff03 60%);box-shadow:0 35px 90px #0009;transform:rotate(1.2deg);overflow:hidden}
.hero-image-shell:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(120deg,transparent 35%,#ffffff10 50%,transparent 65%);transform:translateX(-100%);animation:sheen 8s ease-in-out infinite}
.hero-image-shell img{width:100%;aspect-ratio:1.2/1;object-fit:contain;border-radius:15px;background:#090b10}
.hero-image-fallback{display:none;aspect-ratio:1.2/1;place-items:center;text-align:center;background:radial-gradient(circle,#5c1218,#101116 65%);border-radius:15px}
.hero-image-fallback b{font:800 38px var(--display);letter-spacing:-.07em}.hero-image-fallback span{display:block;color:#b9bec8;font-size:11px;margin-top:8px}
.float-card{position:absolute;z-index:3;display:flex;align-items:center;gap:11px;padding:13px 15px;border:1px solid #ffffff24;border-radius:14px;background:#12151be8;box-shadow:0 15px 45px #0008;backdrop-filter:blur(14px)}
.float-one{top:7%;right:-5%}.float-two{bottom:7%;left:-7%}
.float-icon{width:34px;height:34px;display:grid;place-items:center;background:#ff303b20;color:var(--red);border-radius:10px;font-size:17px}
.float-card strong,.float-card small{display:block}.float-card strong{font-size:11px}.float-card small{margin-top:4px;color:#a1a7b1;font-size:9px}
.status-dot{width:7px;height:7px;background:var(--lime);border-radius:50%;box-shadow:0 0 0 5px #c8ff7418}
.hero-meta{display:flex;gap:30px;flex-wrap:wrap;margin-top:44px;padding-top:23px;border-top:1px solid var(--line)}
.hero-meta div{display:grid;gap:7px}.hero-meta span{font:9px var(--mono);letter-spacing:.1em;color:#747b86;text-transform:uppercase}.hero-meta b{font-size:11px;font-weight:600;color:#e4e6ea}
.hero-bottom{display:flex;align-items:center;gap:12px;margin-top:42px;color:#737985;font:9px var(--mono);letter-spacing:.15em}
.hero-bottom:before{content:"";width:7px;height:7px;background:var(--red);border-radius:50%}
.hero-bottom i{height:1px;width:100px;background:linear-gradient(90deg,var(--red),transparent)}
.section{padding:120px 0;position:relative}
.section-light{background:#f0f0ed;color:#111318}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:45px;margin-bottom:54px}
.section-head h2{font:700 clamp(39px,5.5vw,72px)/1.02 var(--display);letter-spacing:-.075em;margin:17px 0 0}
.section-head h2 em{font-family:var(--serif);font-weight:400;color:var(--red)}
.section-head>p{max-width:385px;margin:0 0 5px;color:var(--muted);font-size:13px;line-height:1.9}
.section-light .eyebrow{color:#60656d}.section-light .section-head>p{color:#666b73}
.overview-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:start}
.overview-copy h3{font:600 clamp(27px,3vw,42px)/1.13 var(--display);letter-spacing:-.055em;margin:0 0 22px}
.overview-copy p{max-width:680px;color:#a7acb5;font-size:14px;line-height:1.95}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.stat{padding:22px;border:1px solid var(--line);border-radius:15px;background:linear-gradient(140deg,#15181e,#0d0f13)}
.stat .num{font:600 32px var(--display);letter-spacing:-.06em;color:var(--red)}.stat strong{display:block;font-size:12px;margin-top:13px}.stat p{font-size:10px;color:#858c97;line-height:1.7;margin:7px 0 0}
.capability-strip{display:grid;grid-template-columns:repeat(4,1fr);margin-top:64px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.capability{padding:22px 20px 22px 0;display:flex;gap:13px;align-items:flex-start}.capability+.capability{padding-left:20px;border-left:1px solid var(--line)}
.capability .symbol{color:var(--red);font-size:18px}.capability b{display:block;font-size:11px}.capability small{display:block;color:#858b95;font-size:10px;line-height:1.6;margin-top:6px}
.journey-intro{display:grid;grid-template-columns:150px 1fr;gap:30px;align-items:start;margin-bottom:45px}
.chapter{display:flex;align-items:center;gap:10px;color:#5d626b;font:10px var(--mono);letter-spacing:.1em}
.chapter span{display:grid;place-items:center;width:36px;height:36px;background:var(--red);border-radius:50%;color:white;font:700 11px var(--display);letter-spacing:0}
.journey-intro h3{font:650 clamp(30px,4vw,48px)/1.05 var(--display);letter-spacing:-.07em;margin:0 0 16px}
.journey-intro p{max-width:730px;color:#666c75;line-height:1.9;font-size:13px;margin:0}
.journey-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:20px}.journey-tags span{border:1px solid #d7d8d8;border-radius:999px;padding:8px 11px;color:#51565e;font-size:10px}
.visual-stack{display:grid;gap:24px}
.visual-card{overflow:hidden;border:1px solid #d1d3d5;border-radius:17px;background:#fff;box-shadow:0 20px 55px #1418210d}
.visual-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 17px;background:#0e1219;color:#e8ebf0;border-bottom:1px solid #ffffff13;font:9px var(--mono);letter-spacing:.08em}
.visual-toolbar span:first-child{display:flex;align-items:center;gap:9px}.visual-toolbar i{width:7px;height:7px;border-radius:50%;background:var(--red);box-shadow:0 0 12px #ff303b88}
.visual-toolbar .count{color:#8f98a5;white-space:nowrap}
.visual-image{overflow-x:auto;background:#070b12;scrollbar-width:thin;scrollbar-color:#555e6c #101722;overscroll-behavior-x:contain}
.visual-image img{width:100%;height:auto;max-width:none;object-fit:contain}
.visual-image .wide{min-width:900px}
.visual-caption{display:flex;justify-content:space-between;gap:25px;align-items:center;padding:17px 20px;background:white}
.visual-caption strong{font:650 13px var(--display);color:#17191e}.visual-caption p{max-width:580px;margin:0;color:#70757d;font-size:10px;line-height:1.75}
.image-note{font:9px var(--mono);color:#888e96}
.app-image img{min-width:0}
.support-image img{min-width:0}
.visual-placeholder{display:none;padding:35px;color:#fff;text-align:center;background:radial-gradient(ellipse at center,#252a35,#070b12)}
.visual-placeholder strong{font:700 22px var(--display)}
.visual-placeholder p{font-size:11px;color:#9fa7b4}
.arch-section{background:#0c0e12}
.arch-section .section-head>p{color:#969da7}
.architecture{padding:30px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(145deg,#14171d,#0a0c10);overflow:hidden}
.architecture-top{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:25px}
.architecture-top h3{margin:0;font:600 17px var(--display);letter-spacing:-.03em}
.architecture-top small{font:9px var(--mono);letter-spacing:.1em;color:#8d95a1}
.arch-tree{display:grid;justify-items:center;gap:0}
.arch-node{position:relative;width:min(100%,720px);padding:17px 20px;border:1px solid #64e5ff65;border-radius:12px;background:linear-gradient(100deg,#12202a,#10141b);display:grid;grid-template-columns:40px 1fr auto;gap:13px;align-items:center;box-shadow:0 10px 30px #0002}
.arch-node:nth-of-type(3n){border-color:#e56bff66;background:linear-gradient(100deg,#21152a,#11131a)}
.arch-node:nth-of-type(4n){border-color:#ff566566;background:linear-gradient(100deg,#29151a,#11131a)}
.arch-icon{width:37px;height:37px;display:grid;place-items:center;border-radius:10px;background:#64e5ff17;color:var(--cyan);font-size:17px}
.arch-node:nth-of-type(3n) .arch-icon{color:#e56bff;background:#e56bff17}
.arch-node:nth-of-type(4n) .arch-icon{color:#ff7078;background:#ff303b17}
.arch-node b{display:block;font:650 13px var(--display)}.arch-node small{display:block;color:#8e97a4;font-size:10px;margin-top:4px}
.arch-node em{font:9px var(--mono);font-style:normal;color:#9ba4b1}
.arch-connector{height:27px;width:1px;background:linear-gradient(var(--cyan),#ffffff18);position:relative}
.arch-connector:after{content:"↓";position:absolute;bottom:-7px;left:50%;transform:translateX(-50%);color:var(--cyan);font-size:12px}
.arch-branch{width:min(100%,920px);display:grid;grid-template-columns:repeat(3,1fr);gap:13px;position:relative;padding-top:27px;margin-top:0}
.arch-branch:before{content:"";position:absolute;top:0;left:16.66%;right:16.66%;height:1px;background:#64e5ff66}
.arch-branch .arch-node{width:100%;height:100%;grid-template-columns:30px 1fr;padding:15px;gap:10px}
.arch-branch .arch-node em{grid-column:2}
.arch-note{margin:24px 0 0;color:#828a96;font-size:10px;line-height:1.8}
.architecture .arch-node{animation:floatIn .7s both}
.architecture .arch-node:nth-child(1){animation-delay:.05s}.architecture .arch-node:nth-child(3){animation-delay:.15s}.architecture .arch-node:nth-child(5){animation-delay:.25s}
.data-section{background:#f0f0ed;color:#111318}
.data-section .section-head>p{color:#676c74}
.erd-wrap{padding:25px;border:1px solid #d7d8d9;border-radius:20px;background:#e8e9e7;overflow:auto}
.erd-canvas{min-width:950px;position:relative;padding:10px 0 25px}
.erd-lines{position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
.erd-grid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(5,minmax(145px,1fr));grid-template-rows:auto 52px auto 52px auto;gap:0 16px;align-items:start}
.entity{border:1px solid #c9cbd0;border-radius:11px;background:#fff;box-shadow:0 8px 20px #1418200b;overflow:hidden;min-width:0}
.entity-head{padding:10px 12px;background:#171b23;color:white;display:flex;align-items:center;justify-content:space-between;gap:6px;font:650 10px var(--display)}
.entity-head span{color:#ff6b73;font:9px var(--mono)}
.entity-fields{padding:9px 11px}
.entity-fields div{display:flex;justify-content:space-between;gap:8px;padding:5px 0;border-bottom:1px solid #eff0f1;color:#555b65;font:9px var(--mono)}
.entity-fields div:last-child{border:0}.entity-fields b{color:#d51c2a;font-weight:500}
.e-users{grid-column:3;grid-row:1}.e-bike{grid-column:1;grid-row:3}.e-workshop{grid-column:3;grid-row:3}.e-service{grid-column:5;grid-row:3}.e-booking{grid-column:2;grid-row:5}.e-order{grid-column:4;grid-row:5}
.erd-legend{display:flex;flex-wrap:wrap;gap:20px;margin-top:20px;color:#5e646c;font-size:10px}.erd-legend span{display:flex;align-items:center;gap:7px}.erd-legend i{width:8px;height:8px;background:var(--red);border-radius:2px}
.erd-disclaimer{font-size:10px;color:#757b83;line-height:1.8;margin:18px 0 0}
.concepts{background:#0c0e12}
.concept-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}
.concept-card{min-height:220px;padding:24px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(140deg,#15181e,#0c0e12);transition:transform .3s,border-color .3s}
.concept-card:hover{transform:translateY(-5px);border-color:#ff303b66}
.concept-top{display:flex;justify-content:space-between;align-items:center}.concept-icon{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#ff303b17;color:var(--red);font-size:19px}.concept-top span{font:10px var(--mono);color:#777f8a}
.concept-card h3{font:650 17px var(--display);margin:28px 0 10px;letter-spacing:-.03em}.concept-card p{font-size:11px;line-height:1.85;color:#959ca7;margin:0}
.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.feature-card{position:relative;padding:22px;border:1px solid #d8d9da;border-radius:15px;background:#fff;min-height:220px;transition:transform .25s,box-shadow .25s}
.feature-card:hover{transform:translateY(-5px);box-shadow:0 14px 30px #0000000c}
.feature-card .index{position:absolute;right:19px;top:19px;color:#9ca0a5;font:10px var(--mono)}
.feature-icon{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#fff0f0;color:var(--red);font-size:19px}
.feature-card h3{font:650 17px var(--display);margin:27px 0 9px;letter-spacing:-.04em}.feature-card p{font-size:10px;line-height:1.8;color:#6c727a;margin:0}.feature-card small{display:block;margin-top:20px;color:#999da3;font:9px var(--mono);letter-spacing:.06em}
.workflow{background:#f0f0ed;color:#111318}
.flow-track{display:grid;grid-template-columns:repeat(7,auto);align-items:center;gap:12px}
.flow-step{min-height:128px;min-width:0;padding:17px;border:1px solid #d6d8d9;border-radius:13px;background:white}
.flow-step small{font:9px var(--mono);color:var(--red)}.flow-step b{display:block;font:650 12px var(--display);margin-top:13px}.flow-step p{font-size:9px;line-height:1.7;color:#737982;margin:7px 0 0}.flow-arrow{color:var(--red);font-size:18px}
.stack-section{background:var(--red);color:white;overflow:hidden}
.stack-section:after{content:"</>";position:absolute;right:3%;bottom:-90px;font:800 280px var(--display);letter-spacing:-.1em;color:#0000000c;pointer-events:none}
.stack-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:65px;align-items:center;position:relative;z-index:1}
.stack-section .eyebrow{color:#ffffffc4}.stack-section .eyebrow:before{background:white;box-shadow:none}
.stack-section h2{font:700 clamp(42px,5vw,66px)/1.02 var(--display);letter-spacing:-.08em;margin:20px 0}
.stack-section h2 em{font:400 italic clamp(42px,5vw,66px) var(--serif);color:#30090d}
.stack-section p{max-width:410px;font-size:12px;line-height:1.9;color:#ffffffc9}
.stack-cloud{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stack-item{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid #ffffff4d;border-radius:13px;background:#ffffff0d;backdrop-filter:blur(8px)}
.stack-symbol{width:34px;height:34px;display:grid;place-items:center;background:#fff;color:var(--red);border-radius:10px;font:800 12px var(--display)}
.stack-item b{display:block;font-size:11px}.stack-item small{display:block;font-size:9px;color:#ffffffc4;margin-top:4px}
.cta{padding:120px 0;background:radial-gradient(ellipse at 75% 45%,#ff303b22,transparent 33%),#090a0d}
.cta-inner{display:grid;grid-template-columns:1fr auto;align-items:end;gap:40px}
.cta h2{font:700 clamp(42px,6.5vw,82px)/.98 var(--display);letter-spacing:-.085em;margin:20px 0}
.cta h2 em{font:400 italic clamp(42px,6.5vw,82px) var(--serif);color:var(--red)}
.cta p{max-width:600px;color:#9ca3ad;font-size:13px;line-height:1.9}
.cta-actions{display:flex;flex-direction:column;gap:18px;align-items:flex-start;padding-bottom:8px}
.footer{border-top:1px solid var(--line);padding:25px 0;color:#747b85;font-size:10px}
.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}.footer strong{color:#e3e5e9}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .75s ease,transform .75s cubic-bezier(.2,.7,.2,1)}
.reveal.is-visible{opacity:1;transform:none}
.delay-1{transition-delay:.1s}.delay-2{transition-delay:.2s}
@@keyframes sheen{0%,65%,100%{transform:translateX(-120%)}80%{transform:translateX(120%)}}
@@keyframes floatIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@@media(max-width:950px){
 .hero{padding-top:130px}.hero-grid{gap:25px}.hero h1{font-size:clamp(55px,8vw,85px)}.float-one{right:-2%}.float-two{left:-2%}
 .overview-grid{gap:35px}.capability-strip{grid-template-columns:repeat(2,1fr)}.capability:nth-child(3){border-left:0;padding-left:0;border-top:1px solid var(--line)}.capability:nth-child(4){border-top:1px solid var(--line)}
 .feature-grid{grid-template-columns:repeat(2,1fr)}.flow-track{grid-template-columns:1fr;gap:8px}.flow-arrow{transform:rotate(90deg);justify-self:center}.flow-step{min-height:0}
 .stack-grid{gap:35px}.arch-branch{grid-template-columns:1fr}.arch-branch:before{display:none}.arch-branch .arch-node{grid-template-columns:30px 1fr}
}
@@media(max-width:700px){
