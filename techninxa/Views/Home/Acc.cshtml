@{
    Layout = null;
    ViewData["Title"] = "ACC — Luxury Brand Experience | Cytech Engineering";
    var projectTitle = "ACC";
    var projectCategory = "Luxury Brand Identity · Digital Experience";
    var coverImage = Url.Content("~/assets/projects/acc/luxury-brand.jpg");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#11100e" />
    <meta name="description" content="Explore the ACC luxury brand concept — a refined visual and digital experience for premium cigars, spirits, and accessories by Cytech Engineering." />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --acc-bg: #11100e;
            --acc-panel: #191714;
            --acc-panel-2: #211e19;
            --acc-cream: #f0e8d8;
            --acc-muted: #a49b8b;
            --acc-gold: #c9a76a;
            --acc-gold-light: #e5ce9b;
            --acc-line: rgba(226, 207, 165, .18);
            --acc-serif: "Playfair Display", Georgia, serif;
            --acc-sans: "DM Sans", Arial, sans-serif;
            --acc-width: 1240px;
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; background: var(--acc-bg); }
        body { margin: 0; color: var(--acc-cream); background: var(--acc-bg); font-family: var(--acc-sans); overflow-x: hidden; }
        body.acc-lock { overflow: hidden; }
        a { color: inherit; text-decoration: none; }
        button { font: inherit; }
        ::selection { background: var(--acc-gold); color: #17130d; }
        .acc-page { position: relative; overflow: clip; }
        .acc-wrap { width: min(var(--acc-width), calc(100% - 64px)); margin-inline: auto; }
        .acc-grain { pointer-events: none; position: fixed; inset: 0; z-index: 20; opacity: .055; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.42'/%3E%3C/svg%3E"); }
        .acc-topbar { position: absolute; z-index: 5; top: 0; left: 0; width: 100%; padding: 27px 0; border-bottom: 1px solid rgba(240,232,216,.12); }
        .acc-topbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
        .acc-wordmark { display: inline-flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 700; letter-spacing: .23em; text-transform: uppercase; }
        .acc-mark { display: grid; place-items: center; width: 35px; height: 35px; border: 1px solid var(--acc-gold); color: var(--acc-gold-light); font-family: var(--acc-serif); font-size: 17px; letter-spacing: -.05em; }
        .acc-nav { display: flex; align-items: center; gap: 30px; color: rgba(240,232,216,.72); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
        .acc-nav a { transition: color .25s ease; }
        .acc-nav a:hover { color: var(--acc-gold-light); }
        .acc-nav-cta { padding: 12px 17px; border: 1px solid var(--acc-line); color: var(--acc-cream); }

        .acc-hero { position: relative; min-height: 780px; display: flex; align-items: center; padding: 150px 0 95px; isolation: isolate; }
        .acc-hero::before { content: ""; position: absolute; z-index: -2; inset: 0; background: radial-gradient(ellipse at 75% 45%, rgba(166,116,48,.16), transparent 40%), linear-gradient(115deg, #11100e 15%, rgba(17,16,14,.91) 47%, rgba(17,16,14,.52) 100%); }
        .acc-hero-art { position: absolute; z-index: -3; top: 0; right: 0; width: 68%; height: 100%; overflow: hidden; }
        .acc-hero-art img { width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: .64; filter: saturate(.7) contrast(1.08); transform: scale(1.04); }
        .acc-hero-art::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, var(--acc-bg) 0%, rgba(17,16,14,.7) 28%, rgba(17,16,14,.08) 68%), linear-gradient(0deg, var(--acc-bg) 0%, transparent 40%, rgba(17,16,14,.2) 100%); }
        .acc-hero-content { position: relative; width: min(700px, 67%); }
        .acc-eyebrow { display: flex; align-items: center; gap: 13px; color: var(--acc-gold-light); font-size: 10px; letter-spacing: .24em; text-transform: uppercase; }
        .acc-eyebrow::before { content: ""; display: block; width: 35px; height: 1px; background: var(--acc-gold); }
        .acc-hero h1 { margin: 25px 0 20px; font-family: var(--acc-serif); font-weight: 400; font-size: clamp(76px, 12vw, 164px); line-height: .84; letter-spacing: -.065em; }
        .acc-hero h1 span { display: block; color: var(--acc-gold-light); font-style: italic; font-size: .47em; line-height: 1.5; letter-spacing: -.02em; }
        .acc-hero-copy { max-width: 470px; color: rgba(240,232,216,.72); font-size: 15px; line-height: 1.9; }
        .acc-hero-actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 34px; }
        .acc-button { display: inline-flex; align-items: center; justify-content: center; gap: 13px; min-height: 50px; padding: 0 22px; border: 1px solid var(--acc-gold); color: #19140d; background: var(--acc-gold-light); font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; transition: transform .3s ease, background .3s ease, color .3s ease; }
        .acc-button:hover { transform: translateY(-3px); background: transparent; color: var(--acc-gold-light); }
        .acc-text-link { display: inline-flex; align-items: center; gap: 10px; color: var(--acc-cream); font-size: 11px; letter-spacing: .08em; }
        .acc-text-link span { color: var(--acc-gold); font-size: 18px; transition: transform .3s ease; }
        .acc-text-link:hover span { transform: translateX(5px); }
        .acc-hero-index { position: absolute; right: 32px; bottom: 46px; display: flex; align-items: center; gap: 15px; color: rgba(240,232,216,.52); font-size: 9px; letter-spacing: .18em; text-transform: uppercase; writing-mode: vertical-rl; }
        .acc-hero-index::before { content: ""; width: 1px; height: 54px; background: var(--acc-gold); }

        .acc-meta-strip { border-top: 1px solid var(--acc-line); border-bottom: 1px solid var(--acc-line); background: #15130f; }
        .acc-meta-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
        .acc-meta-item { padding: 27px 28px; border-right: 1px solid var(--acc-line); }
        .acc-meta-item:first-child { padding-left: 0; }
        .acc-meta-item:last-child { border-right: 0; }
        .acc-meta-item small { display: block; margin-bottom: 10px; color: var(--acc-muted); font-size: 9px; letter-spacing: .18em; text-transform: uppercase; }
        .acc-meta-item strong { font-family: var(--acc-serif); font-size: 17px; font-weight: 400; }

        .acc-section { padding: 125px 0; }
        .acc-section-head { display: grid; grid-template-columns: .85fr 1.15fr; gap: 70px; align-items: end; margin-bottom: 55px; }
        .acc-kicker { margin-bottom: 17px; color: var(--acc-gold); font-size: 10px; letter-spacing: .22em; text-transform: uppercase; }
        .acc-section h2 { margin: 0; font-family: var(--acc-serif); font-size: clamp(38px, 5vw, 67px); font-weight: 400; line-height: 1.06; letter-spacing: -.04em; }
        .acc-section h2 em { color: var(--acc-gold-light); font-weight: 400; }
        .acc-section-intro { max-width: 540px; margin: 0; color: var(--acc-muted); font-size: 14px; line-height: 1.95; }
        .acc-overview { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: center; }
        .acc-overview-art { position: relative; min-height: 500px; background: var(--acc-panel); overflow: hidden; }
        .acc-overview-art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(.72); transition: transform .8s cubic-bezier(.2,.7,.2,1); }
        .acc-overview-art:hover img { transform: scale(1.045); }
        .acc-overview-art::after { content: ""; position: absolute; inset: 0; border: 1px solid rgba(229,206,155,.24); pointer-events: none; }
        .acc-art-label { position: absolute; z-index: 1; left: 24px; bottom: 23px; padding: 12px 15px; color: var(--acc-cream); background: rgba(17,16,14,.78); border: 1px solid var(--acc-line); font-size: 9px; letter-spacing: .16em; text-transform: uppercase; backdrop-filter: blur(10px); }
        .acc-overview-copy h3 { margin: 0 0 22px; font-family: var(--acc-serif); font-size: clamp(28px, 3vw, 42px); font-weight: 400; line-height: 1.2; }
        .acc-overview-copy p { color: var(--acc-muted); font-size: 14px; line-height: 1.95; }
        .acc-pullquote { margin: 32px 0 0; padding: 0 0 0 22px; border-left: 1px solid var(--acc-gold); color: var(--acc-gold-light); font-family: var(--acc-serif); font-size: 22px; line-height: 1.5; font-style: italic; }

        .acc-dark-band { background: #171511; border-block: 1px solid rgba(226,207,165,.08); }
        .acc-capability-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--acc-line); border-left: 1px solid var(--acc-line); }
        .acc-capability { min-height: 270px; padding: 30px; border-right: 1px solid var(--acc-line); border-bottom: 1px solid var(--acc-line); transition: background .35s ease; }
        .acc-capability:hover { background: rgba(201,167,106,.055); }
        .acc-capability-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 42px; }
        .acc-capability-num { color: var(--acc-gold); font-size: 10px; letter-spacing: .15em; }
        .acc-capability-icon { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid var(--acc-line); color: var(--acc-gold-light); font-family: var(--acc-serif); font-size: 21px; }
        .acc-capability h3 { margin: 0 0 12px; font-family: var(--acc-serif); font-size: 23px; font-weight: 400; }
        .acc-capability p { margin: 0; color: var(--acc-muted); font-size: 12px; line-height: 1.8; }

        .acc-showcase { padding-bottom: 135px; }
        .acc-showcase-frame { position: relative; padding: 12px; border: 1px solid var(--acc-line); background: #171511; cursor: zoom-in; }
        .acc-showcase-frame img { display: block; width: 100%; max-height: 780px; object-fit: cover; object-position: center; filter: saturate(.82); }
        .acc-showcase-frame::after { content: "EXPLORE VISUAL"; position: absolute; right: 28px; bottom: 28px; padding: 13px 16px; background: rgba(17,16,14,.82); border: 1px solid var(--acc-line); color: var(--acc-cream); font-size: 9px; letter-spacing: .16em; }
        .acc-showcase-caption { display: flex; justify-content: space-between; gap: 25px; margin-top: 20px; color: var(--acc-muted); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }

        .acc-system { display: grid; grid-template-columns: .7fr 1.3fr; gap: 80px; align-items: start; }
        .acc-system-copy p { color: var(--acc-muted); font-size: 14px; line-height: 1.95; }
        .acc-system-list { margin-top: 30px; border-top: 1px solid var(--acc-line); }
        .acc-system-list div { display: flex; justify-content: space-between; gap: 18px; padding: 15px 0; border-bottom: 1px solid var(--acc-line); color: var(--acc-muted); font-size: 11px; }
        .acc-system-list strong { color: var(--acc-cream); font-weight: 500; }
        .acc-diagram { padding: 28px; border: 1px solid var(--acc-line); background: radial-gradient(ellipse at center, rgba(201,167,106,.07), transparent 65%), #15130f; }
        .acc-diagram-heading { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 26px; color: var(--acc-muted); font-size: 9px; letter-spacing: .16em; text-transform: uppercase; }
        .acc-diagram-core { display: grid; place-items: center; min-height: 112px; border: 1px solid var(--acc-gold); color: var(--acc-gold-light); font-family: var(--acc-serif); font-size: 28px; text-align: center; }
        .acc-diagram-lines { display: flex; justify-content: center; height: 42px; }
        .acc-diagram-lines span { width: 1px; height: 100%; background: var(--acc-gold); opacity: .65; }
        .acc-diagram-branches { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; position: relative; }
        .acc-diagram-branches::before { content: ""; position: absolute; top: -1px; left: 16.66%; right: 16.66%; height: 1px; background: var(--acc-gold); opacity: .65; }
        .acc-diagram-node { padding: 20px 12px; border: 1px solid var(--acc-line); background: rgba(255,255,255,.015); text-align: center; }
        .acc-diagram-node strong { display: block; margin-bottom: 8px; color: var(--acc-cream); font-family: var(--acc-serif); font-size: 16px; font-weight: 400; }
        .acc-diagram-node small { color: var(--acc-muted); font-size: 9px; line-height: 1.6; }
        .acc-diagram-footer { margin-top: 18px; color: var(--acc-muted); font-size: 10px; line-height: 1.7; }

        .acc-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--acc-line); }
        .acc-process-step { padding: 27px 25px 0 0; margin-right: 25px; border-right: 1px solid var(--acc-line); }
        .acc-process-step:last-child { border-right: 0; margin-right: 0; }
        .acc-process-step span { display: inline-block; margin-bottom: 30px; color: var(--acc-gold); font-size: 10px; letter-spacing: .16em; }
        .acc-process-step h3 { margin: 0 0 12px; font-family: var(--acc-serif); font-size: 23px; font-weight: 400; }
        .acc-process-step p { margin: 0; color: var(--acc-muted); font-size: 12px; line-height: 1.85; }

        .acc-principles { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; }
        .acc-principle-list { border-top: 1px solid var(--acc-line); }
        .acc-principle { display: grid; grid-template-columns: 46px 1fr; gap: 15px; padding: 22px 0; border-bottom: 1px solid var(--acc-line); }
        .acc-principle > span { color: var(--acc-gold); font-size: 10px; padding-top: 4px; }
        .acc-principle h3 { margin: 0 0 7px; font-family: var(--acc-serif); font-size: 20px; font-weight: 400; }
        .acc-principle p { margin: 0; color: var(--acc-muted); font-size: 12px; line-height: 1.8; }
        .acc-palette { display: grid; grid-template-columns: repeat(4, 1fr); gap: 9px; margin-top: 28px; }
        .acc-swatch { min-width: 0; }
        .acc-swatch-color { height: 90px; border: 1px solid rgba(255,255,255,.12); }
        .acc-swatch small { display: block; margin-top: 9px; color: var(--acc-muted); font-size: 9px; line-height: 1.6; }
        .acc-swatch strong { display: block; color: var(--acc-cream); font-size: 10px; font-weight: 500; }

        .acc-cta { position: relative; padding: 105px 0; border-top: 1px solid var(--acc-line); background: radial-gradient(ellipse at 50% 120%, rgba(201,167,106,.13), transparent 58%), #15130f; text-align: center; }
        .acc-cta .acc-eyebrow { justify-content: center; }
        .acc-cta h2 { max-width: 800px; margin: 22px auto; font-family: var(--acc-serif); font-size: clamp(43px, 7vw, 86px); font-weight: 400; line-height: 1.02; letter-spacing: -.04em; }
        .acc-cta h2 em { color: var(--acc-gold-light); }
        .acc-cta p { max-width: 500px; margin: 0 auto 30px; color: var(--acc-muted); font-size: 13px; line-height: 1.9; }
        .acc-footer { padding: 24px 0; border-top: 1px solid var(--acc-line); }
        .acc-footer-inner { display: flex; justify-content: space-between; align-items: center; gap: 22px; color: var(--acc-muted); font-size: 10px; }
        .acc-footer-links { display: flex; gap: 20px; }
        .acc-footer a:hover { color: var(--acc-gold-light); }

        .acc-lightbox { position: fixed; z-index: 100; inset: 0; display: grid; place-items: center; padding: 35px; background: rgba(9,8,7,.94); opacity: 0; visibility: hidden; transition: opacity .3s ease, visibility .3s ease; }
        .acc-lightbox.is-open { opacity: 1; visibility: visible; }
        .acc-lightbox img { max-width: min(1200px, 95vw); max-height: 86vh; object-fit: contain; border: 1px solid var(--acc-line); }
        .acc-lightbox-close { position: absolute; top: 22px; right: 25px; width: 45px; height: 45px; border: 1px solid var(--acc-line); color: var(--acc-cream); background: transparent; font-size: 25px; cursor: pointer; }
        .acc-reveal { opacity: 0; transform: translateY(24px); transition: opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1); }
        .acc-reveal.is-visible { opacity: 1; transform: translateY(0); }
        .acc-delay-1 { transition-delay: .1s; } .acc-delay-2 { transition-delay: .2s; } .acc-delay-3 { transition-delay: .3s; }

        @@media (max-width: 900px) {
            .acc-wrap { width: min(100% - 42px, var(--acc-width)); }
            .acc-hero { min-height: 720px; }
            .acc-hero-art { width: 85%; opacity: .8; }
            .acc-hero-content { width: 82%; }
            .acc-section { padding: 90px 0; }
            .acc-section-head { grid-template-columns: 1fr; gap: 22px; }
            .acc-overview, .acc-system, .acc-principles { grid-template-columns: 1fr; gap: 40px; }
            .acc-overview-art { min-height: 440px; }
            .acc-capability-grid { grid-template-columns: repeat(2, 1fr); }
            .acc-process-grid { grid-template-columns: repeat(2, 1fr); row-gap: 36px; }
            .acc-process-step:nth-child(2) { border-right: 0; }
            .acc-meta-item { padding-inline: 18px; }
            .acc-meta-item:first-child { padding-left: 0; }
        }
        @@media (max-width: 600px) {
            .acc-wrap { width: calc(100% - 36px); }
            .acc-topbar { padding: 18px 0; }
            .acc-nav { gap: 0; }
            .acc-nav a:not(.acc-nav-cta) { display: none; }
            .acc-nav-cta { padding: 10px 12px; font-size: 9px; }
            .acc-hero { min-height: 690px; padding: 135px 0 75px; align-items: end; }
            .acc-hero-art { width: 100%; height: 78%; opacity: .74; }
            .acc-hero-art::after { background: linear-gradient(0deg, var(--acc-bg) 2%, rgba(17,16,14,.35) 62%, rgba(17,16,14,.15) 100%), linear-gradient(90deg, rgba(17,16,14,.3), transparent); }
            .acc-hero-content { width: 100%; }
            .acc-hero h1 { font-size: clamp(76px, 23vw, 118px); }
            .acc-hero-copy { font-size: 13px; }
            .acc-hero-index { display: none; }
            .acc-meta-grid { grid-template-columns: 1fr 1fr; }
            .acc-meta-item { padding: 19px 12px; border-bottom: 1px solid var(--acc-line); }
            .acc-meta-item:nth-child(2) { border-right: 0; }
            .acc-meta-item:nth-child(3) { padding-left: 0; border-bottom: 0; }
            .acc-meta-item:nth-child(4) { border-right: 0; border-bottom: 0; }
            .acc-meta-item strong { font-size: 15px; }
            .acc-section { padding: 72px 0; }
            .acc-section h2 { font-size: 43px; }
            .acc-overview-art { min-height: 340px; }
            .acc-capability-grid { grid-template-columns: 1fr; }
            .acc-capability { min-height: 220px; padding: 24px; }
            .acc-capability-top { margin-bottom: 25px; }
            .acc-showcase { padding-bottom: 80px; }
            .acc-showcase-frame { padding: 6px; }
            .acc-showcase-frame img { min-height: 270px; }
            .acc-showcase-frame::after { right: 14px; bottom: 14px; }
            .acc-showcase-caption { flex-direction: column; gap: 8px; }
            .acc-diagram { padding: 15px; }
            .acc-diagram-core { min-height: 90px; font-size: 23px; }
            .acc-diagram-branches { gap: 6px; }
            .acc-diagram-node { padding: 14px 5px; overflow-wrap: anywhere; }
            .acc-diagram-node strong { font-size: 13px; }
            .acc-diagram-node small { font-size: 8px; }
            .acc-process-grid { grid-template-columns: 1fr; row-gap: 25px; }
            .acc-process-step { min-height: 0; padding-top: 20px; margin-right: 0; border-right: 0; border-top: 1px solid var(--acc-line); }
            .acc-process-step span { margin-bottom: 15px; }
            .acc-palette { gap: 6px; }
            .acc-swatch-color { height: 62px; }
            .acc-cta { padding: 75px 0; }
            .acc-footer-inner { align-items: flex-start; flex-direction: column; }
            .acc-lightbox { padding: 15px; }
        }
        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
            .acc-reveal { opacity: 1; transform: none; }
        }
    </style>
</head>
<body>
<div class="acc-page">
    <div class="acc-grain" aria-hidden="true"></div>

    <header class="acc-topbar">
        <div class="acc-wrap acc-topbar-inner">
            <a class="acc-wordmark" href="@Url.Content("~/")" aria-label="Cytech Engineeringhome">
                <span class="acc-mark">T.</span><span>Cytech Engineering<span style="color:var(--acc-muted);font-weight:400">/ Case Study</span></span>
            </a>
            <nav class="acc-nav" aria-label="Project navigation">
                <a href="#overview">Overview</a>
                <a href="#craft">Creative direction</a>
                <a href="#process">Process</a>
                <a class="acc-nav-cta" href="#contact">Start a project ↗</a>
            </nav>
        </div>
    </header>

    <main>
        <section class="acc-hero">
            <div class="acc-hero-art" aria-hidden="true">
                <img src="@coverImage" alt="" fetchpriority="high" />
            </div>
            <div class="acc-wrap">
                <div class="acc-hero-content">
                    <div class="acc-eyebrow acc-reveal">Selected work · Brand experience</div>
                    <h1 class="acc-reveal acc-delay-1">ACC<span>Quiet luxury. Lasting impression.</span></h1>
                    <p class="acc-hero-copy acc-reveal acc-delay-2">A premium visual direction for a world of considered indulgence — bringing cigars, fine spirits, and lifestyle accessories together through confident typography, tactile tones, and a restrained editorial aesthetic.</p>
                    <div class="acc-hero-actions acc-reveal acc-delay-3">
                        <a class="acc-button" href="#overview">Explore the project <span aria-hidden="true">↘</span></a>
                        <a class="acc-text-link" href="#visuals">View the visual <span aria-hidden="true">↗</span></a>
                    </div>
                </div>
            </div>
            <div class="acc-hero-index">Project 03 / Brand & digital</div>
        </section>

        <section class="acc-meta-strip" aria-label="Project details">
            <div class="acc-wrap acc-meta-grid">
                <div class="acc-meta-item"><small>Discipline</small><strong>Brand & Digital Design</strong></div>
                <div class="acc-meta-item"><small>Industry</small><strong>Luxury Lifestyle</strong></div>
                <div class="acc-meta-item"><small>Creative mood</small><strong>Editorial · Refined</strong></div>
