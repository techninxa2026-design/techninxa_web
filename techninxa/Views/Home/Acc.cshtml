<script>
(() => {
    const revealItems = document.querySelectorAll('.acc-reveal');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if ('IntersectionObserver' in window && !reduceMotion) {
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -35px 0px' });
        revealItems.forEach(item => observer.observe(item));
    } else {
        revealItems.forEach(item => item.classList.add('is-visible'));
    }

    const lightbox = document.querySelector('.acc-lightbox');
    const lightboxImage = lightbox?.querySelector('img');
    const closeButton = lightbox?.querySelector('.acc-lightbox-close');
    const showcase = document.querySelector('[data-acc-lightbox]');

    function openLightbox() {
        if (!lightbox || !lightboxImage || !showcase) return;
        const source = showcase.querySelector('img');
        lightboxImage.src = source.currentSrc || source.src;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.classList.add('acc-lock');
        closeButton?.focus();
    }
    function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('acc-lock');
    }
    showcase?.addEventListener('click', openLightbox);
    closeButton?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', event => {
        if (event.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape') closeLightbox();
    });

    const hero = document.querySelector('.acc-hero');
    const heroArt = document.querySelector('.acc-hero-art img');
    if (hero && heroArt && !reduceMotion && window.matchMedia('(pointer:fine)').matches) {
        hero.addEventListener('pointermove', event => {
            const bounds = hero.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width - .5;
            const y = (event.clientY - bounds.top) / bounds.height - .5;
            heroArt.style.transform = `scale(1.06) translate(${x * -10}px, ${y * -8}px)`;
        });
        hero.addEventListener('pointerleave', () => heroArt.style.transform = 'scale(1.04)');
    }
})();
</script>
