    var memberName = ViewBag.MemberName as string ?? "MH Anik";
    var memberRole = ViewBag.MemberRole as string ?? "UI/UX & Visual Designer";
    var memberBio = ViewBag.MemberBio as string ??
        "I'm a multidisciplinary designer creating thoughtful digital experiences through UI/UX, visual design, and brand storytelling.";

    var email = "mhanik417@gmail.com";
    var phone = "+8801998336347";
}

<link rel="stylesheet"
