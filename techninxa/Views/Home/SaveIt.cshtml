<div class="entity e-setting"><div class="entity-head">USER_SETTINGS <span>PK</span></div><div class="entity-fields"><div><b>PK</b> setting_id</div><div><b>FK</b> user_id</div><div>default_quality</div><div>save_location</div><div>notifications_on</div></div></div>
