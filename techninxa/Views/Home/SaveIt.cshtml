document.addEventListener('pointerleave',()=>document.body.classList.remove('has-pointer','cursor-hover'));
(function cursor(){cx+=(px-cx)*.22;cy+=(py-cy)*.22;aura.style.left=`${cx}px`;aura.style.top=`${cy}px`;core.style.left=`${px}px`;core.style.top=`${py}px`;requestAnimationFrame(cursor)})();
$$('.feature-card,.stat,.concept-card,.stack-item,.flow-step').forEach(card=>{card.addEventListener('pointermove',e=>{const r=card.getBoundingClientRect(),x=(e.clientX-r.left)/r.width,y=(e.clientY-r.top)/r.height;card.style.transform=`perspective(900px) rotateX(${(.5-y)*5}deg) rotateY(${(x-.5)*5}deg) translateY(-3px)`});card.addEventListener('pointerleave',()=>card.style.transform='')});
const grid=$('.hero-grid'),visual=$('.hero-visual'),shell=$('.hero-image-shell');
grid.addEventListener('pointermove',e=>{if(innerWidth<=760)return;const r=grid.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;shell.style.transform=`rotateY(${-4+x*6}deg) rotateX(${-y*4}deg) rotateZ(.5deg) translateZ(7px)`;visual.style.translate=`${x*-8}px ${y*-7}px`});
grid.addEventListener('pointerleave',()=>{shell.style.transform='';visual.style.translate=''});
}
const links=$$('.nav a[href^="#"]'),sections=links.map(a=>$(a.getAttribute('href'))).filter(Boolean);
if('IntersectionObserver'in window&&!reduce){const navIO=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)links.forEach(a=>a.classList.toggle('is-current',a.getAttribute('href')==='#'+e.target.id))}),{rootMargin:'-28% 0px -62% 0px'});sections.forEach(s=>navIO.observe(s))}
})();
</script>
</body>
</html>
