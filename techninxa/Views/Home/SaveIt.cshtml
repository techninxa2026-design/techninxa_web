.hero-meta{display:flex;flex-wrap:wrap;gap:25px;margin-top:39px;padding-top:21px;border-top:1px solid var(--line)}.hero-meta div{display:grid;gap:7px}.hero-meta span{font:9px var(--mono);letter-spacing:.1em;color:#72819a;text-transform:uppercase}.hero-meta b{font-size:11px;font-weight:600;color:#e7efff}.hero-visual{position:relative;transform-style:preserve-3d;will-change:transform}.hero-halo{position:absolute;inset:15%;border-radius:50%;background:#187bff35;filter:blur(75px)}.hero-image-shell{position:relative;padding:9px;border:1px solid #9dcaff38;border-radius:23px;background:linear-gradient(145deg,#ffffff1a,#ffffff03);box-shadow:0 35px 90px #0009;transform:rotateY(-4deg) rotateZ(.5deg);overflow:hidden;transform-style:preserve-3d}.hero-image-shell img{width:100%;aspect-ratio:1.52/1;object-fit:cover;object-position:center;border-radius:15px}.hero-image-shell:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(115deg,transparent 25%,#ffffff20 48%,transparent 68%);transform:translateX(-130%);animation:sheen 8s ease-in-out infinite}.float-card{position:absolute;z-index:3;display:flex;align-items:center;gap:10px;padding:12px 14px;border:1px solid #ffffff26;border-radius:14px;background:#101827e8;box-shadow:0 15px 45px #0008;backdrop-filter:blur(14px)}.float-one{top:6%;right:-2%}.float-two{bottom:7%;left:-4%}.float-icon{width:32px;height:32px;display:grid;place-items:center;background:#2684ff22;color:var(--cyan);border-radius:10px;font-size:17px}.float-card strong,.float-card small{display:block}.float-card strong{font-size:11px}.float-card small{margin-top:4px;color:#a1b0c7;font-size:9px}.hero-bottom{display:flex;align-items:center;gap:12px;margin-top:35px;color:#74839b;font:9px var(--mono);letter-spacing:.15em}.hero-bottom:before{content:"";width:7px;height:7px;background:var(--cyan);border-radius:50%}.hero-bottom i{height:1px;width:95px;background:linear-gradient(90deg,var(--cyan),transparent)}
.section{padding:110px 0;position:relative;isolation:isolate;overflow:hidden}.section-light{background:#f2f6ff;color:#111827}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:40px;margin-bottom:48px}.section-head h2{font:750 clamp(38px,5.4vw,70px)/1.02 var(--display);letter-spacing:-.08em;margin:16px 0 0}.section-head h2 em{font-family:Georgia,serif;font-weight:400;color:var(--cyan)}.section-head>p{max-width:390px;margin:0 0 5px;color:var(--muted);font-size:12px;line-height:1.9}.section-light .eyebrow{color:#596b86}.section-light .eyebrow:before{background:#2684ff}.section-light .section-head>p{color:#65748c}
.overview-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:55px;align-items:start}.overview-copy h3{font:650 clamp(26px,3vw,40px)/1.15 var(--display);letter-spacing:-.06em;margin:0 0 20px}.overview-copy p{max-width:680px;color:#a8b6cb;font-size:13px;line-height:1.95}.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.stat{padding:21px;border:1px solid var(--line);border-radius:15px;background:linear-gradient(140deg,#141e30,#0b101a);transition:transform .3s,border-color .3s}.stat:hover{transform:translateY(-5px);border-color:#61dcff65}.stat .num{font:650 30px var(--display);letter-spacing:-.06em;color:var(--cyan)}.stat strong{display:block;font-size:12px;margin-top:11px}.stat p{font-size:10px;color:#8f9eb6;line-height:1.7;margin:7px 0 0}.capability-strip{display:grid;grid-template-columns:repeat(4,1fr);margin-top:58px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.capability{padding:21px 18px 21px 0;display:flex;gap:12px;align-items:flex-start}.capability+.capability{padding-left:18px;border-left:1px solid var(--line)}.capability .symbol{color:var(--cyan);font-size:19px}.capability b{display:block;font-size:11px}.capability small{display:block;color:#8d9cb4;font-size:10px;line-height:1.6;margin-top:6px}
.chapter-row{display:grid;grid-template-columns:140px 1fr;gap:30px;align-items:start;margin-bottom:35px}.chapter{display:flex;align-items:center;gap:10px;color:#60718c;font:10px var(--mono)}.chapter span{display:grid;place-items:center;width:35px;height:35px;border-radius:50%;background:linear-gradient(145deg,#2684ff,#7667ff);color:white;font:700 11px var(--display)}.chapter-row h3{font:700 clamp(28px,4vw,46px)/1.05 var(--display);letter-spacing:-.07em;margin:0 0 13px}.chapter-row p{max-width:740px;color:#687993;font-size:12px;line-height:1.9;margin:0}.screen-board{border:1px solid #d6e0f0;border-radius:18px;overflow:hidden;background:white;box-shadow:0 25px 70px #0a1b3918}.board-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 17px;background:#0d1525;color:#e8f1ff;border-bottom:1px solid #ffffff14;font:9px var(--mono);letter-spacing:.08em}.board-toolbar span:first-child{display:flex;align-items:center;gap:9px}.board-toolbar i{width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 12px #61dcff88}.board-toolbar .count{color:#8f9eb4}.screen-image{overflow:auto;background:#edf3fc;scrollbar-width:thin;scrollbar-color:#9eb5d7 #eaf0f9}.screen-image img{width:100%;height:auto;max-width:none;object-fit:contain}.screen-caption{display:flex;justify-content:space-between;gap:25px;align-items:center;padding:17px 20px;background:#fff}.screen-caption strong{font:700 13px var(--display);color:#172033}.screen-caption p{max-width:650px;margin:0;color:#68758a;font-size:10px;line-height:1.8}.screen-caption span{font:9px var(--mono);color:#8491a5;white-space:nowrap}
.arch-section{background:#0c111b}.architecture{padding:28px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(145deg,#121b2a,#090d15);overflow:hidden}.architecture-top{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}.architecture-top h3{margin:0;font:650 17px var(--display)}.architecture-top small{font:9px var(--mono);letter-spacing:.1em;color:#8999b3}.arch-tree{display:grid;justify-items:center}.arch-node{width:min(100%,730px);padding:16px 19px;border:1px solid #61dcff50;border-radius:12px;background:linear-gradient(100deg,#102333,#111724);display:grid;grid-template-columns:38px 1fr auto;gap:13px;align-items:center;transition:transform .3s,border-color .3s}.arch-node:hover{transform:translateY(-3px);border-color:#61dcff}.arch-icon{width:36px;height:36px;display:grid;place-items:center;border-radius:10px;background:#61dcff18;color:var(--cyan);font-size:17px}.arch-node b{display:block;font:650 12px var(--display)}.arch-node small{display:block;color:#91a0b7;font-size:10px;margin-top:4px}.arch-node em{font:9px var(--mono);font-style:normal;color:#9ba9bf}.arch-connector{height:25px;width:1px;background:linear-gradient(var(--cyan),#ffffff1a);position:relative}.arch-connector:after{content:"↓";position:absolute;bottom:-7px;left:50%;transform:translateX(-50%);color:var(--cyan);font-size:12px}.arch-branch{width:min(100%,930px);display:grid;grid-template-columns:repeat(3,1fr);gap:12px;position:relative;padding-top:25px}.arch-branch:before{content:"";position:absolute;top:0;left:16.66%;right:16.66%;height:1px;background:#61dcff55}.arch-branch .arch-node{width:100%;height:100%;grid-template-columns:30px 1fr;padding:14px;gap:9px;border-color:#8174ff55;background:linear-gradient(100deg,#1a1930,#111724)}.arch-branch .arch-icon{background:#8978ff1c;color:#a99dff}.arch-branch .arch-node em{grid-column:2}.arch-note{margin:22px 0 0;color:#8292aa;font-size:10px;line-height:1.8}
.data-section{background:#f2f6ff;color:#111827}.erd-wrap{padding:22px;border:1px solid #d8e2f1;border-radius:18px;background:#e9f0fb;overflow:auto}.erd-canvas{min-width:920px;position:relative;padding:10px 0 20px}.erd-lines{position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}.erd-grid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(5,minmax(145px,1fr));grid-template-rows:auto 45px auto 45px auto;gap:0 14px;align-items:start}.entity{border:1px solid #cfdaeb;border-radius:10px;background:white;box-shadow:0 8px 20px #1427470b;overflow:hidden;transition:transform .3s}.entity:hover{transform:translateY(-4px)}.entity-head{padding:10px 12px;background:#17243b;color:white;display:flex;justify-content:space-between;gap:6px;font:650 10px var(--display)}.entity-head span{color:#61dcff;font:9px var(--mono)}.entity-fields{padding:9px 11px}.entity-fields div{display:flex;justify-content:space-between;gap:8px;padding:5px 0;border-bottom:1px solid #edf1f7;color:#56647b;font:9px var(--mono)}.entity-fields div:last-child{border:0}.entity-fields b{color:#287bff;font-weight:500}.e-user{grid-column:3;grid-row:1}.e-media{grid-column:1;grid-row:3}.e-download{grid-column:3;grid-row:3}.e-setting{grid-column:5;grid-row:3}.e-queue{grid-column:2;grid-row:5}.e-subscription{grid-column:4;grid-row:5}.erd-legend{display:flex;flex-wrap:wrap;gap:18px;margin-top:18px;color:#65738a;font-size:10px}.erd-legend span{display:flex;align-items:center;gap:7px}.erd-legend i{width:8px;height:8px;background:#2684ff;border-radius:2px}.disclaimer{font-size:10px;color:#6e7d94;line-height:1.8;margin:16px 0 0}
.concept-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.concept-card{min-height:210px;padding:23px;border:1px solid var(--line);border-radius:15px;background:linear-gradient(140deg,#141e30,#0b1019);transition:transform .3s,border-color .3s}.concept-card:hover{transform:translateY(-5px);border-color:#61dcff70}.concept-top{display:flex;justify-content:space-between;align-items:center}.concept-icon{width:39px;height:39px;display:grid;place-items:center;border-radius:12px;background:#2684ff20;color:var(--cyan);font-size:18px}.concept-top span{font:10px var(--mono);color:#7787a1}.concept-card h3{font:650 16px var(--display);margin:25px 0 9px}.concept-card p{font-size:11px;line-height:1.85;color:#99a8bf;margin:0}
.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.feature-card{position:relative;padding:21px;border:1px solid #d9e2f0;border-radius:14px;background:#fff;min-height:215px;transition:transform .3s,box-shadow .3s}.feature-card:hover{transform:translateY(-5px);box-shadow:0 15px 32px #10284c12}.feature-card .index{position:absolute;right:17px;top:17px;color:#a0aec2;font:10px var(--mono)}.feature-icon{width:39px;height:39px;display:grid;place-items:center;border-radius:12px;background:#e9f2ff;color:#247aff;font-size:18px}.feature-card h3{font:650 16px var(--display);margin:24px 0 9px;letter-spacing:-.04em}.feature-card p{font-size:10px;line-height:1.8;color:#66758d;margin:0}.feature-card small{display:block;margin-top:17px;color:#96a3b7;font:9px var(--mono);letter-spacing:.05em}
.workflow{background:#f2f6ff;color:#111827}.flow-track{display:grid;grid-template-columns:repeat(7,auto);align-items:center;gap:11px}.flow-step{min-height:125px;padding:16px;border:1px solid #d9e2f0;border-radius:12px;background:white}.flow-step small{font:9px var(--mono);color:#247aff}.flow-step b{display:block;font:650 12px var(--display);margin-top:12px}.flow-step p{font-size:9px;line-height:1.7;color:#718099;margin:7px 0 0}.flow-arrow{color:#247aff;font-size:18px;animation:pulse 2s infinite}
.stack-section{background:linear-gradient(115deg,#1268f4,#665aff);overflow:hidden}.stack-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;align-items:center;position:relative;z-index:1}.stack-section .eyebrow{color:#ffffffd5}.stack-section .eyebrow:before{background:white;box-shadow:none}.stack-section h2{font:750 clamp(40px,5vw,65px)/1.02 var(--display);letter-spacing:-.08em;margin:20px 0}.stack-section h2 em{font:400 italic clamp(40px,5vw,65px) Georgia,serif;color:#d4f5ff}.stack-section p{max-width:420px;font-size:12px;line-height:1.9;color:#ffffffd5}.stack-cloud{display:grid;grid-template-columns:1fr 1fr;gap:10px}.stack-item{display:flex;align-items:center;gap:11px;padding:14px;border:1px solid #ffffff55;border-radius:13px;background:#ffffff12;backdrop-filter:blur(8px);transition:transform .3s,background .3s}.stack-item:hover{transform:translateY(-4px);background:#ffffff22}.stack-symbol{width:34px;height:34px;display:grid;place-items:center;background:white;color:#286df4;border-radius:10px;font:800 11px var(--display)}.stack-item b{display:block;font-size:11px}.stack-item small{display:block;font-size:9px;color:#ffffffce;margin-top:4px}
.cta{padding:110px 0;background:radial-gradient(ellipse at 75% 45%,#2684ff24,transparent 33%),#080b12}.cta-inner{display:grid;grid-template-columns:1fr auto;align-items:end;gap:40px}.cta h2{font:750 clamp(42px,6.3vw,80px)/.98 var(--display);letter-spacing:-.085em;margin:20px 0}.cta h2 em{font:400 italic clamp(42px,6.3vw,80px) Georgia,serif;color:var(--cyan)}.cta p{max-width:600px;color:#9baac1;font-size:12px;line-height:1.9}.cta-actions{display:flex;flex-direction:column;gap:15px;align-items:flex-start;padding-bottom:7px}.footer{border-top:1px solid var(--line);padding:24px 0;color:#74839a;font-size:10px}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}.footer strong{color:#e5edfb}
.reveal{opacity:0;transform:translateY(22px);transition:opacity .75s ease,transform .75s cubic-bezier(.2,.7,.2,1)}.reveal.is-visible{opacity:1;transform:none}.delay-1{transition-delay:.1s}.delay-2{transition-delay:.2s}.orb{position:absolute;z-index:-1;pointer-events:none;width:clamp(220px,30vw,430px);aspect-ratio:1;border-radius:50%;filter:blur(85px);opacity:.09;background:#2684ff;transform:translateY(var(--orb-y,0px))}.orb.right{right:-12%;top:10%}.orb.left{left:-14%;bottom:0;background:#826bff;opacity:.07}.motion-progress{position:fixed;z-index:100;top:0;left:0;height:2px;width:0;background:linear-gradient(90deg,var(--blue),var(--cyan),var(--violet));box-shadow:0 0 15px #2684ff80;pointer-events:none}.cursor-aura,.cursor-core{position:fixed;z-index:99;left:0;top:0;pointer-events:none;border-radius:50%;opacity:0;transform:translate(-50%,-50%);transition:opacity .2s}.cursor-aura{width:36px;height:36px;border:1px solid #61dcff80;background:#61dcff08}.cursor-core{width:5px;height:5px;background:var(--cyan);box-shadow:0 0 12px #61dcff}.has-pointer .cursor-aura,.has-pointer .cursor-core{opacity:1}.cursor-hover .cursor-aura{width:55px;height:55px;border-color:#9d8bff;background:#8068ff12}
