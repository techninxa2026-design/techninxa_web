    </main>
</div>


<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');

    .mh-editorial {
        --paper: #f5f2e9;
        --ink: #191915;
        --orange: #fa4d25;
        --muted: #77766d;
        --line: #d7d3c8;
        color: var(--ink);
        background: var(--paper);
        font-family: 'DM Sans', sans-serif;
        width: 100%;
        overflow: clip;
    }

    .mh-editorial * { box-sizing: border-box; }
    .mh-editorial a { color: inherit; text-decoration: none; }
    .mh-editorial img { display: block; max-width: 100%; }
    .mh-editorial a:focus-visible { outline: 2px solid var(--orange); outline-offset: 4px; }

    .mh-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 305px;
        height: 100dvh;
        min-height: 600px;
        padding: 22px 23px 17px;
        display: flex;
        flex-direction: column;
        background: var(--paper);
        border-right: 1px solid var(--line);
        z-index: 20;
    }

    .mh-monogram {
        width: 44px;
        height: 44px;
        border: 1.5px solid var(--ink);
        display: flex;
        align-items: center;
        justify-content: center;
        font: 700 17px 'Space Grotesk', sans-serif;
        letter-spacing: -1px;
        flex-shrink: 0;
    }

    .mh-monogram span { color: var(--orange); }

    .mh-profile-image {
        height: 225px;
        position: relative;
        margin-top: 20px;
        background: #e3dfd3;
        border: 1px solid var(--ink);
        overflow: hidden;
        flex-shrink: 0;
    }

    .mh-profile-image img {
        position: absolute;
        inset: 0;
        z-index: 2;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
        filter: grayscale(100%);
        transition: filter .4s ease, transform .6s ease;
    }

    .mh-profile-image:hover img {
        filter: grayscale(0%);
        transform: scale(1.04);
    }

    .mh-image-placeholder {
        height: 100%;
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

    .mh-image-placeholder span {
        font: 700 80px 'Space Grotesk', sans-serif;
        letter-spacing: -8px;
    }

    .mh-image-placeholder small,
    .mh-image-index,
    .mh-eyebrow,
    .mh-meta-label,
    .mh-section-heading,
    .mh-hero-kicker,
    .mh-hero-index,
    .mh-art-category,
    .mh-art-eyebrow,
    .mh-project-number,
    .mh-project-title-row > span,
    .mh-project-stack,
    .mh-project-link,
    .mh-work-footnote,
    .mh-skill-group-number,
    .mh-skills-bottom,
    .mh-timeline-date,
    .mh-timeline-tags,
    .mh-timeline-status,
    .mh-education-number,
    .mh-education-foot,
    .mh-contact-kicker,
    .mh-contact-links,
    .mh-footer,
    .mh-topbar {
        font: 9px/1.7 'DM Mono', monospace;
        letter-spacing: .6px;
    }

    .mh-image-index {
        position: absolute;
        z-index: 3;
        left: 8px;
        bottom: 8px;
        padding: 5px 7px;
        background: var(--paper);
    }

    .mh-profile-copy {
        padding: 18px 0;
        border-bottom: 1px solid var(--line);
    }

    .mh-eyebrow {
        margin: 0 0 9px;
        color: var(--orange);
    }

    .mh-profile-copy h2 {
        font: 700 27px/.98 'Space Grotesk', sans-serif;
        letter-spacing: -1.3px;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .mh-profile-role {
        margin: 8px 0 10px;
        font-size: 12px;
        font-weight: 700;
    }

    .mh-profile-bio {
        margin: 0;
        color: #6d6b62;
        font-size: 11px;
        line-height: 1.8;
    }

    .mh-sidebar-meta {
        display: grid;
        gap: 10px;
        padding: 14px 0;
        border-bottom: 1px solid var(--line);
    }

    .mh-sidebar-meta > div {
        display: flex;
        justify-content: space-between;
        gap: 7px;
        align-items: center;
        font-size: 10px;
    }

    .mh-meta-label { color: var(--muted); font-size: 8px; }

    .mh-side-nav {
        display: grid;
        padding-top: 10px;
    }

    .mh-side-nav a {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 7px 0;
        font-size: 11px;
        font-weight: 700;
        transition: color .2s, padding .2s;
    }

    .mh-side-nav a span { color: var(--orange); font: 9px 'DM Mono', monospace; }
    .mh-side-nav a:hover { color: var(--orange); padding-left: 5px; }

    .mh-sidebar-bottom {
        margin-top: auto;
        padding-top: 12px;
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-size: 8px;
    }

    .mh-sidebar-bottom a { color: var(--orange); }

    .mh-main { margin-left: 305px; min-width: 0; }

    .mh-topbar {
        height: 55px;
        padding: 0 5.5%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        border-bottom: 1px solid var(--line);
        font-size: 8px;
    }

    .mh-topbar b { color: var(--orange); }
    .mh-topbar a { color: var(--orange); }

    .mh-hero {
        position: relative;
        min-height: 640px;
        padding: 55px 5.5% 34px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        border-bottom: 1px solid var(--line);
    }

    .mh-hero-kicker {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        color: var(--muted);
        margin-bottom: 42px;
        font-size: 8px;
    }

    .mh-hero-title {
        margin: 0 0 26px -5px;
        font: 700 clamp(70px, 9.2vw, 135px)/.8 'Space Grotesk', sans-serif;
        letter-spacing: -.105em;
        position: relative;
        z-index: 1;
        animation: mhTitleIn .8s ease both;
    }

    .mh-outline-text {
        color: transparent;
        -webkit-text-stroke: 1.5px var(--ink);
    }

    .mh-orange { color: var(--orange); }

    .mh-hero-bottom {
        max-width: 650px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
    }

    .mh-role {
        font: 600 22px/1.25 'Space Grotesk', sans-serif;
        letter-spacing: -.7px;
        margin: 0 0 12px;
    }

    .mh-hero-description {
        max-width: 420px;
        margin: 0;
        color: #67655d;
        font-size: 12px;
