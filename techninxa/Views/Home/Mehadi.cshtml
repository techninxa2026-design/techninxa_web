            Url = "/arena-bangla",
            Label = "OPEN LIVE PLATFORM",
            Theme = "mh-project-arena",
            Image = "~/images/ashik/livegame.png",
            Display = "Play live.<br /><span>Compete together.</span>",
            Eyebrow = "ESPORTS / LIVE TOURNAMENTS",
            Metric1 = "LIVE", Metric1Label = "Match updates",
