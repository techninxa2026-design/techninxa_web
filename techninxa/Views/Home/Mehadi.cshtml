        new {
            Number = "04 / AI SYSTEMS",
            Title = "RAG & Language Models",
            Description = "Retrieval-augmented generation pipelines, local LLM deployment with Ollama and Gemma 3, Qwen text embeddings, semantic search, and prompt engineering."
        },
        new {
            Number = "05 / DEVOPS",
            Title = "Deployment & Infrastructure",
            Description = "Docker and Compose, GitHub Actions CI/CD, Traefik, Nginx, Linux VPS hardening, UFW, SSH, cron, and Let's Encrypt SSL."
        },
        new {
            Number = "06 / AUTOMATION",
            Title = "Workflow Integrations",
            Description = "n8n workflows, Meta Graph API, webhooks, API integrations, and event-driven automation."
