        new {
            Number = "02",
            Name = "ArenaBangla — Esports Tournament & Live Gaming Platform",
            Type = "REAL-TIME WEB APP / ESPORTS",
            Summary = "A Bangladeshi esports platform for player registration, tournament brackets, live match status, and automated leaderboards. WebSockets broadcast scores, bracket changes, and lobby status without page refreshes.",
