                        </p>
                        <div class="mh-timeline-tags">
                            <span>REACT</span>
                            <span>LARAVEL 9</span>
                            <span>TAILWIND CSS</span>
                            <span>APIS</span>
                        </div>
                    </div>

                    <span class="mh-timeline-status">02 / PREVIOUS</span>
                </article>
            </div>
        </section>


        <!-- EDUCATION -->
        <section class="mh-section" id="mh-education">
            <div class="mh-section-heading">
                <span>05 / EDUCATION</span>
                <span>ACADEMIC BACKGROUND</span>
            </div>

            <div class="mh-education-layout">
                <h2>Learning<br /><span>never stops.</span></h2>

                <div class="mh-education-list">
                    <article class="mh-education-card">
                        <span class="mh-education-number">EDU / 001</span>
                        <h3>Bachelor of Arts (B.A.)</h3>
                        <p>Nizampur Govt. College</p>
                        <div class="mh-education-foot">
                            IN PROGRESS
                        </div>
                    </article>

                    <article class="mh-education-card">
                        <span class="mh-education-number">EDU / 002</span>
                        <h3>Higher Secondary Certificate (HSC)</h3>
                        <p>Nizampur Govt. College</p>
                        <p>2020 · GPA 4.08</p>
                        <div class="mh-education-foot">
