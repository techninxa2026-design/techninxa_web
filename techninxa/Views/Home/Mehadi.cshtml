        <!-- CONTACT -->
        <section class="mh-contact mh-section" id="mh-contact">
            <div class="mh-section-heading">
                <span>06 / CONTACT</span>
                <span>THE NEXT CHAPTER</span>
            </div>

            <div class="mh-contact-content">
                <span class="mh-contact-kicker">HAVE A COMPLEX PROBLEM?</span>

                <h2>
                    Let's build<br />
                    something <span>intelligent.</span>
                </h2>

                <p>
                    Interested in AI integrations, SaaS platforms, real-time
