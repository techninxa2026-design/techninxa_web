                </p>
            </div>

            <div class="mh-project-list">
                @foreach (var project in projects)
                {
                    <article class="mh-project">
                        <div class="mh-project-number">@project.Number</div>

                        <a class="mh-project-art @project.Theme"
                           href="@project.Url"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="@project.Label: @project.Name">

                            <img class="mh-project-image"
                                 src="@Url.Content(project.Image)"
                                 alt="@project.Name"
                                 loading="lazy"
                                 onerror="this.style.display='none';" />

                            <span class="mh-art-category">@project.Type</span>
                            <span class="mh-art-arrow">↗</span>
                        </a>

                        <div class="mh-project-info">
                            <div class="mh-project-title-row">
                                <h3>@project.Name</h3>
                                <span>@project.Number / 04</span>
                            </div>

                            <p>@project.Summary</p>

                            <div class="mh-project-stack">
                                @foreach (var technology in project.Stack)
                                {
