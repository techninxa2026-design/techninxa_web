            Url = "/ai-arena",
            Label = "OPEN LIVE DEMO",
            Theme = "mh-project-ai",
            Image = "~/images/ashik/blog.png",
            Display = "Knowledge<br /><span>without the noise.</span>",
            Eyebrow = "RETRIEVAL-AUGMENTED GENERATION",
            Metric1 = "RAG", Metric1Label = "Grounded answers",
            Metric2 = "1024D", Metric2Label = "Qwen embeddings",
            Metric3 = "SSE", Metric3Label = "Streaming responses"
