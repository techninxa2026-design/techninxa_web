@using Techninxa.Services
@model List<Techninxa.Models.Project>

@{ ViewData["Title"] = "Software Development Projects & Case Studies"; ViewData["ActiveNav"] = "Projects"; ViewData["Description"] = "Explore Cytech Engineering's software development projects, web applications, mobile apps, and IoT solutions. Discover our digital products and case studies."; ViewData["CanonicalUrl"] = "https://techninxa.com/Projects"; }

<section class="inner-hero">
    <div class="container inner-hero-grid">
        <div class="reveal">
            <span class="kicker">SELECTED WORK</span>
            <h1>Projects that turn<br><em>ideas into products.</em></h1>
        </div>
        <div class="inner-hero-copy reveal reveal-delay">
            <p>Explore software, mobile and IoT work created by Cytech Engineering. Each project starts with a real problem and ends with a usable digital solution.</p>
        </div>
    </div>
</section>

<section class="project-library section">
    <div class="container">
        <div class="filter-bar reveal" role="tablist" aria-label="Project categories">
            <button class="filter active" data-filter="all">All</button>
            <button class="filter" data-filter="mobile">Mobile</button>
            <button class="filter" data-filter="web">Web</button>
            <button class="filter" data-filter="software">Software</button>
            <button class="filter" data-filter="iot">IoT</button>
        </div>

        <div class="project-grid">

    @if (Model != null && Model.Any())
    {
        foreach (var project in Model)
        {
            var category = project.Category?.Trim().ToLower() ?? "";
            var preview = ItIotMedia.ResolveProject(project);
            var safeFallback = ItIotMedia.ResolveConcept(project.Title, project.Slug, project.Category);

            var categoryClasses = category switch
            {
                var c when c.Contains("mobile") && c.Contains("iot")
                    => "mobile iot",

                var c when c.Contains("mobile") && c.Contains("software")
                    => "mobile software",

                var c when c.Contains("web") && c.Contains("software")
                    => "web software",

                var c when c.Contains("web")
                    => "web",

                var c when c.Contains("mobile")
                    => "mobile",

                var c when c.Contains("software")
                    => "software",

                var c when c.Contains("iot")
                    => "iot",

                _ => ""
            };

            <article class="library-card reveal"
                     data-category="@categoryClasses">

                <a href="/Projects/Details/@project.Slug">

                    <div class="library-image">

                        <img src="@preview.Url"
                             alt="@preview.Alt"
                             class="it-media-library-image @(preview.IsIllustration ? "is-concept" : "is-case-art")"
                             width="900" height="600"
                             loading="lazy" decoding="async"
                             data-it-preview
                             data-it-fallback="@safeFallback.Url">
                        @if (preview.IsIllustration)
                        {
                            <span class="it-media-concept-label">CONCEPT PREVIEW</span>
                        }

                        <div class="mini-chip">
                            @project.Category
                        </div>

                    </div>

                    <div class="library-info">

                        <span>@project.Category</span>

                        <h2>@project.Title</h2>

                        <p>
                            @project.ShortDescription
                        </p>

                        <span class="card-arrow">
                            View case study ↗
                        </span>

                    </div>

                </a>

            </article>
        }
    }
    else
    {
        <div class="no-projects">
            <p>No projects available yet.</p>
        </div>
    }

</div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/Flip.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/SplitText.min.js"></script>
    <script src="~/js/home-interactions.js" asp-append-version="true"></script>
}
