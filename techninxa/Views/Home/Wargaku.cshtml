d="url(#arrow)"/><text x="591.5" y="223.0" fill="#b5c9c7" font-size="10">participates</text><path d="M500 144 L435.0 144 L435.0 312 L370 312" stroke="var(--cs-accent)" stroke-opacity=".62" stroke-width="1.5" fill="none" marker-end="url(#arrow)"/><text x="439.0" y="223.0" fill="#b5c9c7" font-size="10">reads</text><rect x="65" y="82" width="260" height="124" rx="11" fill="#10262d" stroke="var(--cs-accent)" stroke-opacity=".7"/><path d="M65 114 H325" stroke="#315057"/><text x="78" y="103" fill="var(--cs-accent)" font-size="13" font-weight="700">Households</text><text x="78" y="131" fill="#d6e4e1" font-size="10">Resident groups</text><text x="78" y="152" fill="#93acad" font-size="10">PK household_id</text><text x="78" y="168" fill="#93acad" font-size="10">name · address · ward_id</text><text x="78" y="184" fill="#93acad" font-size="10">created_at</text><rect x="370" y="82" width="260" height="124" rx="11" fill="#10262d" stroke="var(--cs-accent)" stroke-opacity=".7"/><path d="M370 114 H630" stroke="#315057"/><text x="383" y="103" fill="var(--cs-accent)" font-size="13" font-weight="700">Residents</text><text x="383" y="131" fill="#d6e4e1" font-size="10">Registered residents</text><text x="383" y="152" fill="#93acad" font-size="10">PK resident_id</text><text x="383" y="168" fill="#93acad" font-size="10">FK household_id · role</text><text x="383" y="184" fill="#93acad" font-size="10">name · phone · status</text><rect x="675" y="82" width="260" height="124" rx="11" fill="#10262d" stroke="var(--cs-accent)" stroke-opacity=".7"/><path d="M675 114 H935" stroke="#315057"/><text x="688" y="103" fill="var(--cs-accent)" font-size="13" font-weight="700">ServiceRequests</text><text x="688" y="131" fill="#d6e4e1" font-size="10">Complaints & requests</text><text x="688" y="152" fill="#93acad" font-size="10">PK request_id</text><text x="688" y="168" fill="#93acad" font-size="10">FK resident_id · category_id</text><text x="688" y="184" fill="#93acad" font-size="10">status · description</text><rect x="65" y="250" width="260" height="124" rx="11" fill="#10262d" stroke="var(--cs-accent)" stroke-opacity=".7"/><path d="M65 282 H325" stroke="#315057"/><text x="78" y="271" fill="var(--cs-accent)" font-size="13" font-weight="700">Categories</text><text x="78" y="299" fill="#d6e4e1" font-size="10">Service categories</text><text x="78" y="320" fill="#93acad" font-size="10">PK category_id</text><text x="78" y="336" fill="#93acad" font-size="10">label · icon · active</text><text x="78" y="352" fill="#93acad" font-size="10">sort_order</text><rect x="370" y="250" width="260" height="124" rx="11" fill="#10262d" stroke="var(--cs-accent)" stroke-opacity=".7"/><path d="M370 282 H630" stroke="#315057"/><text x="383" y="271" fill="var(--cs-accent)" font-size="13" font-weight="700">Notices</text><text x="383" y="299" fill="#d6e4e1" font-size="10">Community notices</text><text x="383" y="320" fill="#93acad" font-size="10">PK notice_id</text><text x="383" y="336" fill="#93acad" font-size="10">title · body · published_at</text><text x="383" y="352" fill="#93acad" font-size="10">FK author_id</text><rect x="675" y="250" width="260" height="124" rx="11" fill="#10262d" stroke="var(--cs-accent)" stroke-opacity=".7"/><path d="M675 282 H935" stroke="#315057"/><text x="688" y="271" fill="var(--cs-accent)" font-size="13" font-weight="700">Events</text><text x="688" y="299" fill="#d6e4e1" font-size="10">Community activities</text><text x="688" y="320" fill="#93acad" font-size="10">PK event_id</text><text x="688" y="336" fill="#93acad" font-size="10">title · starts_at · venue</text><text x="688" y="352" fill="#93acad" font-size="10">FK organizer_id</text><rect x="65" y="418" width="260" height="124" rx="11" fill="#10262d" stroke="var(--cs-accent)" stroke-opacity=".7"/><path d="M65 450 H325" stroke="#315057"/><text x="78" y="439" fill="var(--cs-accent)" font-size="13" font-weight="700">Payments</text><text x="78" y="467" fill="#d6e4e1" font-size="10">Community dues</text><text x="78" y="488" fill="#93acad" font-size="10">PK payment_id</text><text x="78" y="504" fill="#93acad" font-size="10">FK resident_id</text><text x="78" y="520" fill="#93acad" font-size="10">amount · period · status</text><rect x="370" y="418" width="260" height="124" rx="11" fill="#10262d" stroke="var(--cs-accent)" stroke-opacity=".7"/><path d="M370 450 H630" stroke="#315057"/><text x="383" y="439" fill="var(--cs-accent)" font-size="13" font-weight="700">Notifications</text><text x="383" y="467" fill="#d6e4e1" font-size="10">User alerts</text><text x="383" y="488" fill="#93acad" font-size="10">PK notification_id</text><text x="383" y="504" fill="#93acad" font-size="10">FK resident_id</text><text x="383" y="520" fill="#93acad" font-size="10">type · read_at · created_at</text><rect x="675" y="418" width="260" height="124" rx="11" fill="#10262d" stroke="var(--cs-accent)" stroke-opacity=".7"/><path d="M675 450 H935" stroke="#315057"/><text x="688" y="439" fill="var(--cs-accent)" font-size="13" font-weight="700">Profiles</text><text x="688" y="467" fill="#d6e4e1" font-size="10">Resident profile data</text><text x="688" y="488" fill="#93acad" font-size="10">PK profile_id</text><text x="688" y="504" fill="#93acad" font-size="10">FK resident_id</text><text x="688" y="520" fill="#93acad" font-size="10">avatar · preferences</text></svg></div>
            <p class="cs-diagram-note">Illustrative model for portfolio communication. Relationship lines represent likely associations, not verified database constraints. For a real build, define authentication, retention, validation, indexes and authorization rules explicitly.</p>
            <div style="height:28px"></div>
