                       data-description="@project.ShortDescription"
                       data-order="@projectIndex"
                       aria-label="View the @project.Title project">
                        <div class="home-project-visual">
                            <div class="home-project-visual-grid" aria-hidden="true"></div>

                            @if (!string.IsNullOrWhiteSpace(project.HeroImage))
                            {
                                <img src="@project.HeroImage" alt="@project.Title project preview" loading="lazy">
                            }
                            else
                            {
                                <div class="home-project-placeholder">
                                    <span class="home-project-placeholder-mark" aria-hidden="true">TX</span>
                                    <strong>@project.Title</strong>
                                    <small>PROJECT PREVIEW</small>
                                </div>
                            }

