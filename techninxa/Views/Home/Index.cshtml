        /* =====================================================
           HOVER INSIGHT — GSAP TYPEWRITER BANNER
           Appears beneath the fixed site header when an informative
           project, service, team member, process step or technology
           is explored.
        ===================================================== */
        .home-hover-insight {
            position: fixed;
            top: 98px;
            left: 50%;
            translate: -50% 0;
            z-index: 999;
            width: min(760px, calc(100vw - 34px));
            display: grid;
            grid-template-columns: 58px minmax(0, 1fr) 24px;
            align-items: center;
            gap: 16px;
            padding: 17px 19px;
            overflow: hidden;
            isolation: isolate;
            border: 1px solid rgba(125, 211, 252, .24);
            border-radius: 22px;
            background: radial-gradient(circle at 3% 0%, rgba(22, 135, 248, .23), transparent 38%), linear-gradient(135deg, rgba(7, 12, 21, .97), rgba(12, 29, 48, .97));
            box-shadow: 0 24px 75px rgba(3, 12, 25, .28), 0 0 0 1px rgba(255, 255, 255, .025) inset;
            color: #f8fbff;
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(-18px) scale(.975);
            transform-origin: top center;
            will-change: transform, opacity, filter;
        }

        .home-hover-insight::before {
            content: "";
            position: absolute;
            z-index: -1;
            width: 180px;
            height: 180px;
            right: -72px;
            top: -115px;
            border-radius: 50%;
            background: rgba(56, 189, 248, .18);
            filter: blur(35px);
            pointer-events: none;
        }

        .home-hover-insight::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, #1687f8 22%, #38bdf8 54%, transparent);
            opacity: .88;
            transform: scaleX(.35);
            transform-origin: left center;
        }

        .home-hover-insight.is-visible {
            visibility: visible;
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .home-hover-insight-art {
            position: relative;
            width: 58px;
            height: 58px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            border: 1px solid rgba(125, 211, 252, .23);
            border-radius: 17px;
            background: linear-gradient(145deg, rgba(22, 135, 248, .22), rgba(255, 255, 255, .035));
            color: #dff5ff;
            font: 800 17px "Space Grotesk", sans-serif;
            letter-spacing: -.06em;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .11), 0 10px 30px rgba(0, 0, 0, .12);
        }

        .home-hover-insight-art::before,
        .home-hover-insight-art::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .home-hover-insight-art::before {
            inset: 7px;
            border: 1px dashed rgba(125, 211, 252, .30);
            animation: homeInsightOrbit 12s linear infinite;
        }

        .home-hover-insight-art::after {
            width: 6px;
            height: 6px;
            right: 8px;
            top: 8px;
            background: #38bdf8;
            box-shadow: 0 0 13px rgba(56, 189, 248, .9);
        }

        .home-hover-insight-copy {
            min-width: 0;
        }

        .home-hover-insight-topline {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
            margin-bottom: 6px;
            color: #8da3b9;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .15em;
            line-height: 1.3;
            text-transform: uppercase;
        }

        .home-hover-insight-live {
            width: 6px;
            height: 6px;
            flex: 0 0 6px;
            border-radius: 50%;
            background: #38bdf8;
            box-shadow: 0 0 0 4px rgba(56, 189, 248, .11), 0 0 13px rgba(56, 189, 248, .65);
        }

        .home-hover-insight-label {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .home-hover-insight-index {
            margin-left: auto;
            color: rgba(148, 163, 184, .68);
            white-space: nowrap;
        }

        .home-hover-insight-title {
            margin: 0;
            color: #fff;
            font: 700 clamp(17px, 2vw, 22px)/1.17 "Space Grotesk", sans-serif;
            letter-spacing: -.035em;
            overflow-wrap: anywhere;
        }

        .home-hover-insight-title [data-insight-title],
        .home-hover-insight-description [data-insight-copy] {
            white-space: pre-wrap;
        }

        .home-hover-insight-description {
            margin: 6px 0 0;
            color: #aebdcd;
            font-size: 11px;
            line-height: 1.65;
            overflow-wrap: anywhere;
        }

        .home-hover-insight[data-typing="title"] [data-insight-title]::after,
        .home-hover-insight[data-typing="copy"] [data-insight-copy]::after {
            content: "▍";
            display: inline-block;
            margin-left: 2px;
            color: #38bdf8;
            font-weight: 500;
            animation: homeInsightBlink .68s steps(2, start) infinite;
        }

        .home-hover-insight-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-top: 9px;
        }

        .home-hover-insight-meta:empty {
            display: none;
        }

        .home-hover-insight-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            max-width: 100%;
            padding: 4px 7px;
            border: 1px solid rgba(125, 211, 252, .14);
            border-radius: 999px;
            background: rgba(255, 255, 255, .045);
            color: #b9d8ee;
            font-size: 8px;
            font-weight: 750;
            line-height: 1.3;
            letter-spacing: .035em;
            overflow-wrap: anywhere;
        }

        .home-hover-insight-mark {
            align-self: start;
            padding-top: 2px;
            color: rgba(125, 211, 252, .8);
            font-size: 18px;
            line-height: 1;
            animation: homeInsightMark 2.4s ease-in-out infinite;
        }

        .home-hover-insight-sr-only {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            padding: 0 !important;
            margin: -1px !important;
            overflow: hidden !important;
            clip: rect(0, 0, 0, 0) !important;
            white-space: nowrap !important;
            border: 0 !important;
        }

        .home-hover-info-target {
            outline-offset: 4px;
        }

        @@keyframes homeInsightBlink {
            to { opacity: 0; }
        }

        @@keyframes homeInsightOrbit {
            to { transform: rotate(360deg); }
        }

        @@keyframes homeInsightMark {
            0%, 100% { opacity: .62; transform: rotate(0deg) scale(.96); }
            50% { opacity: 1; transform: rotate(45deg) scale(1.08); }
        }

        @@media (max-width: 760px) {
            .home-hover-insight {
                top: 82px;
                width: calc(100vw - 22px);
                grid-template-columns: 43px minmax(0, 1fr) 12px;
                gap: 11px;
                padding: 12px 13px 14px;
                border-radius: 17px;
            }

            .home-hover-insight-art {
                width: 43px;
                height: 43px;
                border-radius: 13px;
                font-size: 14px;
            }

            .home-hover-insight-art::before { inset: 5px; }
            .home-hover-insight-topline { font-size: 8px; letter-spacing: .10em; gap: 6px; }
            .home-hover-insight-title { font-size: 16px; }
            .home-hover-insight-description { margin-top: 5px; font-size: 10px; line-height: 1.55; }
            .home-hover-insight-meta { margin-top: 7px; gap: 4px; }
            .home-hover-insight-tag { padding: 3px 6px; font-size: 7px; }
            .home-hover-insight-mark { font-size: 14px; }
        }

        @@media (max-width: 390px) {
            .home-hover-insight {
                top: 77px;
                grid-template-columns: 36px minmax(0, 1fr) 8px;
                gap: 9px;
                padding: 10px 10px 12px;
            }

            .home-hover-insight-art { width: 36px; height: 36px; border-radius: 11px; font-size: 12px; }
            .home-hover-insight-title { font-size: 14px; }
            .home-hover-insight-description { font-size: 9px; }
            .home-hover-insight-index { display: none; }
        }

        @@media (prefers-reduced-motion: reduce) {
            .home-hover-insight-art::before,
            .home-hover-insight-mark,
            .home-hover-insight[data-typing="title"] [data-insight-title]::after,
            .home-hover-insight[data-typing="copy"] [data-insight-copy]::after {
                animation: none !important;
            }
        }
