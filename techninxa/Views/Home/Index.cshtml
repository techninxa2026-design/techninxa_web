<section class="contact-section" id="contact">

    <div class="container contact-box reveal">

        <div class="contact-copy">

            <span class="kicker">
                HAVE AN IDEA?
            </span>

            <h2>
                Let's build something <em>useful.</em>
            </h2>

            <p>
                Tell us what you want to create. We'll turn the first
                conversation into a clear next step.
            </p>


            <div class="contact-details">

                <a href="mailto:contact@@techninxa.com">
                    support@@techninxa.com
                </a>

                <a href="tel:+8801790379729">
                    01790-379729
                </a>

                <a href="tel:+8801747414675">
                    01747-414675
                </a>

                <span>
                    Bangladesh
                </span>

            </div>

        </div>


        <form class="contact-form"
              method="post"
              asp-action="SubmitMessege"
              asp-controller="Home">

            <label>

                Name

                <input type="text"
                       asp-for="Name"
                       placeholder="Your name"
                       required>

            </label>


            <label>

                Email

                <input type="email"
                       asp-for="Email"
                       placeholder="you@example.com"
                       required>

            </label>


            <label>

                Project type

                <select asp-for="ProjectType" required>

                    <option value="WebDevelopment">
                        Web Development
                    </option>

                    <option value="MobileApp">
                        Mobile App
                    </option>

                    <option value="CustomSoftware">
                        Custom Software
                    </option>

                    <option value="IoTEmbedded">
                        IoT / Embedded
                    </option>

                    <option value="Other">
                        Other
                    </option>

                </select>

            </label>


            <label>

                Tell us about it

                <textarea asp-for="Message"
                          rows="4"
                          placeholder="A short description of your idea..."
                          required></textarea>

            </label>


            <button class="btn btn-primary" type="submit">

                Send Message <span>↗</span>

            </button>


            @if (TempData["SuccessMessage"] != null)
            {
                <p>
                    @TempData["SuccessMessage"]
                </p>
            }


            <p class="form-note" id="formNote"></p>

        </form>

    </div>

</section>

