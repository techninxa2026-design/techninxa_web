        .home-projects {
            position: relative;
            isolation: isolate;
            overflow: hidden;
            background: linear-gradient(180deg, #f8fbff 0%, #f0f7ff 100%);
        }

        .home-projects::before,
        .home-projects::after {
            content: "";
            position: absolute;
            z-index: -1;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(8px);
        }
        
/* Custom cursor */
.custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 99999;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(22, 135, 248, 0.9);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    margin: -17px 0 0 -17px;
    background: rgba(22, 135, 248, 0.07);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    transition:
        opacity 180ms ease,
        visibility 180ms ease,
        width 220ms ease,
        height 220ms ease,
        margin 220ms ease,
        background 220ms ease,
        border-color 220ms ease;
    will-change: transform;
}

.custom-cursor.is-active {
    opacity: 1;
    visibility: visible;
}

.custom-cursor-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #1687f8;
    transform: translate(-50%, -50%);
    transition: transform 220ms ease;
}

.custom-cursor.is-hovering {
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    background: rgba(22, 135, 248, 0.13);
    border-color: #1687f8;
}

.custom-cursor.is-hovering .custom-cursor-dot {
    transform: translate(-50%, -50%) scale(1.5);
}

.custom-cursor.is-clicking {
    background: rgba(22, 135, 248, 0.25);
}

@@media (hover: hover) and (pointer: fine) {
    body {
        cursor: none;
    }

    a,
    button,
    input,
    textarea,
    select,
    [role="button"] {
        cursor: none;
    }
}

@@media (hover: none), (pointer: coarse) {
    .custom-cursor {
        display: none !important;
    }
}

@@media (prefers-reduced-motion: reduce) {
    .custom-cursor {
        transition: none;
    }

    .custom-cursor-dot {
        transition: none;
    }
}


