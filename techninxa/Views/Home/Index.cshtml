                            <span class="home-project-number">WORK / @projectIndex.ToString("00")</span>
                            <span class="home-project-open" aria-hidden="true">↗</span>
                        </div>

                        <div class="home-project-content">
                            <div class="home-project-content-top">
                                <span class="home-project-overline">Case study / @projectIndex.ToString("00")</span>
                                @if (projectIndex == 1)
                                {
                                    <span class="home-project-featured-label">Featured work</span>
                                }
                            </div>

                            <h3>@project.Title</h3>
                            <p>@project.ShortDescription</p>

                            <div class="home-project-footer">
                                <span>Discover this project</span>
                                <span class="home-project-footer-arrow" aria-hidden="true">↗</span>
                            </div>
                        </div>
                    </a>

                    projectIndex++;
                }
            }
            else
            {
                <div class="home-project-empty">
                    <span aria-hidden="true">TX</span>
                    <p>Our latest projects will be featured here soon.</p>
                </div>
            }
        </div>

