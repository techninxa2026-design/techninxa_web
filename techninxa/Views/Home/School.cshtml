@{
    Layout = null;
    ViewData["Title"] = "School Management System | Techninxa";
    ViewData["Description"] = "Explore the Cytech EnginneringSchool Management System, its school administration workflows, key features and project walkthrough.";
    var videoId = "WXUPk0HsYgk";
    var youtubeEmbedUrl = $"https://www.youtube-nocookie.com/embed/{videoId}";
    var youtubeThumbnail = $"https://i.ytimg.com/vi/{videoId}/maxresdefault.jpg";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="theme-color" content="#101116" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root{--bg:#101116;--panel:#171920;--panel2:#1e222c;--white:#f5f6f8;--muted:#9a9eaa;--line:rgba(245,246,248,.14);--green:#53e0a0;--blue:#8ca8ff;--display:"Space Grotesk",sans-serif;--sans:"Manrope",sans-serif;--mono:"DM Mono",monospace;--width:1180px}
        *{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--bg)}body{margin:0;background:var(--bg);color:var(--white);font-family:var(--sans);overflow-x:hidden}a{color:inherit;text-decoration:none}::selection{background:var(--green);color:var(--bg)}.wrap{width:min(var(--width),calc(100% - 64px));margin:auto}
        .noise{position:fixed;inset:0;z-index:20;pointer-events:none;opacity:.025;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E")}
        .header{position:absolute;top:0;left:0;width:100%;z-index:5;padding:22px 0;border-bottom:1px solid var(--line)}.header-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:12px;font:700 13px var(--display)}.brand-mark{display:grid;place-items:center;width:39px;height:39px;background:var(--white);color:var(--bg);font:700 17px var(--display)}.brand small{display:block;margin-top:3px;color:var(--muted);font:9px var(--mono);letter-spacing:.12em}.nav{display:flex;align-items:center;gap:24px;color:#c4c6ce;font-size:10px;text-transform:uppercase;letter-spacing:.09em}.nav a:hover,.footer a:hover{color:var(--green)}.nav .nav-cta{border:1px solid var(--line);padding:12px 15px;color:var(--white)}
        .hero{position:relative;min-height:770px;display:flex;align-items:center;padding:145px 0 90px;background:radial-gradient(ellipse at 78% 42%,rgba(83,224,160,.13),transparent 31%),radial-gradient(ellipse at 88% 82%,rgba(140,168,255,.12),transparent 30%),var(--bg)}.hero-grid{display:grid;grid-template-columns:1fr .92fr;align-items:center;gap:52px}.eyebrow,.kicker{display:flex;align-items:center;gap:11px;color:var(--green);font:10px var(--mono);letter-spacing:.17em;text-transform:uppercase}.eyebrow:before{content:"";width:27px;height:1px;background:currentColor}.hero h1{margin:25px 0;font:700 clamp(66px,8.6vw,112px)/.85 var(--display);letter-spacing:-.095em}.hero h1 span{display:block;margin-top:11px;color:transparent;-webkit-text-stroke:1px rgba(245,246,248,.68)}.hero-copy{max-width:540px;color:#b1b4bf;font-size:14px;line-height:1.9}.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}.tags span{padding:8px 10px;border:1px solid var(--line);color:#d4d6dd;font:9px var(--mono)}.actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:31px}.button{display:inline-flex;align-items:center;justify-content:center;gap:15px;min-height:49px;padding:0 20px;background:var(--green);border:1px solid var(--green);color:#101116;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;transition:.25s}.button:hover{transform:translateY(-3px);background:transparent;color:var(--green)}.text-link{font-size:11px}.text-link span{color:var(--green);margin-left:7px}
        .hero-art{position:relative;min-height:440px;display:grid;place-items:center}.art-frame{position:relative;width:100%;aspect-ratio:1/1;display:grid;place-items:center;border:1px solid #ffffff20;background:linear-gradient(145deg,#ffffff0d,#ffffff01);overflow:hidden}.art-frame:before,.art-frame:after{content:"";position:absolute;width:78%;aspect-ratio:1;border:1px solid #53e0a044;border-radius:50%}.art-frame:after{width:57%;border-color:#8ca8ff66;transform:rotateX(65deg) rotateZ(-25deg)}.mock-screen{position:relative;z-index:1;width:83%;padding:18px;background:#f7f9fc;color:#18202b;box-shadow:0 28px 80px #0008;transform:rotate(-4deg)}.screen-top{display:flex;justify-content:space-between;align-items:center;gap:8px;padding-bottom:13px;border-bottom:1px solid #e3e7ed;font-size:9px;font-weight:800}.screen-brand{display:flex;align-items:center;gap:6px;color:#087e52}.screen-brand i{display:grid;place-items:center;width:18px;height:18px;background:#087e52;color:#fff;font-style:normal;border-radius:5px}.screen-top>span{color:#8b94a3;font-weight:500}.screen-heading{margin:18px 0 5px;font:700 22px var(--display);letter-spacing:-.06em}.screen-sub{color:#8791a1;font-size:8px}.screen-search{display:grid;grid-template-columns:1fr 1fr auto;gap:6px;margin:15px 0}.screen-search span{padding:9px 7px;background:#edf1f6;border-radius:4px;color:#798394;font-size:7px}.screen-search b{padding:9px 10px;background:#078753;color:white;border-radius:4px;font-size:7px}.job-row{display:grid;grid-template-columns:28px 1fr auto;align-items:center;gap:8px;padding:10px 0;border-top:1px solid #e8ebf0}.company-icon{display:grid;place-items:center;width:27px;height:27px;border-radius:7px;background:#e2f5ec;color:#087e52;font-size:10px;font-weight:800}.job-row strong{display:block;font-size:8px}.job-row small{display:block;margin-top:4px;color:#8992a0;font-size:7px}.job-row em{font-style:normal;color:#078753;font-size:7px;font-weight:800}.orbit-label{position:absolute;z-index:3;right:-5px;top:11%;padding:12px 14px;background:var(--green);color:var(--bg);font:9px var(--mono);letter-spacing:.12em;transform:rotate(4deg)}.float-note{position:absolute;z-index:3;left:-9px;bottom:7%;padding:15px 17px;background:#1b1e27;border:1px solid var(--line);box-shadow:0 20px 50px #0005}.float-note small{display:block;color:var(--muted);font:9px var(--mono);letter-spacing:.12em}.float-note strong{display:block;margin-top:7px;font:600 16px var(--display)}.hero-bottom{position:absolute;bottom:28px;left:0;width:100%;display:flex;justify-content:space-between;color:#777c89;font:9px var(--mono);letter-spacing:.13em;text-transform:uppercase}
        .stats{background:var(--panel);border-block:1px solid var(--line)}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr)}.stat{padding:24px 20px;border-right:1px solid var(--line)}.stat:first-child{padding-left:0}.stat:last-child{border:0}.stat small{display:block;margin-bottom:9px;color:var(--muted);font:9px var(--mono);letter-spacing:.13em;text-transform:uppercase}.stat strong{font:600 15px var(--display)}
        .section{padding:105px 0}.section-head{display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;align-items:end;margin-bottom:45px}.kicker{margin-bottom:15px}.section h2{margin:0;font:600 clamp(40px,5vw,64px)/1.02 var(--display);letter-spacing:-.07em}.section h2 em{font-style:normal;color:var(--green)}.intro{max-width:570px;margin:0;color:var(--muted);font-size:13px;line-height:1.95}.overview{display:grid;grid-template-columns:1fr 1fr;gap:62px;align-items:center}.overview-art{position:relative;min-height:390px;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid var(--line);background:radial-gradient(circle at 50% 50%,#293c38,#1a1d26 52%,#14161d)}.overview-art:before{content:"";position:absolute;width:70%;aspect-ratio:1;border:1px solid #53e0a044;border-radius:50%}.overview-art .mock-screen{width:78%}.image-label{position:absolute;left:17px;bottom:17px;z-index:2;background:var(--green);color:var(--bg);padding:10px 12px;font:9px var(--mono);letter-spacing:.09em;text-transform:uppercase}.copy h3{margin:0 0 18px;font:600 30px/1.2 var(--display);letter-spacing:-.04em}.copy p{color:var(--muted);font-size:13px;line-height:1.95}.quote{margin-top:25px;padding:5px 0 5px 19px;border-left:2px solid #a995ff;font:500 19px/1.5 var(--display);color:#dfe2eb}
        .band{background:#171a22;border-block:1px solid var(--line)}.features{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.feature{min-height:225px;padding:25px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);transition:background .25s}.feature:hover{background:#53e0a00b}.feature-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:31px}.feature-num{color:var(--green);font:10px var(--mono)}.feature-icon{display:grid;place-items:center;width:40px;height:40px;border:1px solid #53e0a066;color:var(--green);font:20px var(--display)}.feature h3{margin:0 0 10px;font:600 21px var(--display)}.feature p{margin:0;color:var(--muted);font-size:12px;line-height:1.85}
        .video-section{padding-bottom:115px}.video-shell{padding:10px;border:1px solid var(--line);background:#181a22}.video-frame{position:relative;width:100%;aspect-ratio:16/9;background:#08090d;overflow:hidden}.video-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.video-caption{display:flex;justify-content:space-between;gap:20px;margin-top:15px;color:var(--muted);font:9px var(--mono);letter-spacing:.1em;text-transform:uppercase}.video-link{color:var(--green);text-decoration:underline;text-underline-offset:4px}
        .system{background:#e9ebf0;color:#151821}.system .kicker{color:#087e52}.system h2{color:#151821}.system .intro,.system-copy p{color:#626877}.system-layout{display:grid;grid-template-columns:.75fr 1.25fr;gap:60px;align-items:start}.system-copy p{font-size:13px;line-height:1.95}.system-list{margin-top:24px;border-top:1px solid #cdd0d8}.system-list div{display:flex;justify-content:space-between;gap:15px;padding:14px 0;border-bottom:1px solid #cdd0d8;font-size:10px}.system-list span{color:#737887}.system-list strong{text-align:right}.diagram{padding:24px;background:#f8f9fb;border:1px solid #d4d7df}.diagram-head{display:flex;justify-content:space-between;margin-bottom:20px;color:#777d8b;font:9px var(--mono);letter-spacing:.1em;text-transform:uppercase}.diagram-root{padding:22px;text-align:center;background:#151821;color:white;font:600 22px var(--display)}.diagram-root small{display:block;margin-top:6px;color:var(--green);font:9px var(--mono);letter-spacing:.14em}.connect{height:32px;display:flex;justify-content:center}.connect span{width:1px;background:#8993b5}.nodes{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.nodes:before{content:"";position:absolute;top:0;left:16.6%;right:16.6%;height:1px;background:#8993b5}.node{padding:16px 8px;background:#fff;border:1px solid #d8dbe3;text-align:center}.node b{display:block;margin-bottom:7px;font:600 13px var(--display)}.node small{font:10px/1.7 var(--sans);color:#747a88}.diagram-foot{margin:15px 0 0;color:#777d8b;font-size:10px;line-height:1.7}
        .process{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.step{padding:24px 20px 0 0;margin-right:20px;border-right:1px solid var(--line)}.step:last-child{border:0;margin:0}.step>span{display:block;margin-bottom:25px;color:var(--green);font:10px var(--mono)}.step h3{margin:0 0 10px;font:600 20px var(--display)}.step p{margin:0;color:var(--muted);font-size:12px;line-height:1.85}.principles{display:grid;grid-template-columns:1fr 1fr;gap:65px}.principle-list{border-top:1px solid var(--line)}.principle{display:grid;grid-template-columns:35px 1fr;gap:14px;padding:19px 0;border-bottom:1px solid var(--line)}.principle>span{padding-top:4px;color:var(--green);font:10px var(--mono)}.principle h3{margin:0 0 7px;font:600 18px var(--display)}.principle p{margin:0;color:var(--muted);font-size:12px;line-height:1.8}
        .cta{padding:95px 0;background:var(--green);color:var(--bg);text-align:center}.cta .eyebrow{justify-content:center;color:var(--bg)}.cta .eyebrow:before{background:var(--bg)}.cta h2{max-width:850px;margin:22px auto;font:600 clamp(42px,7vw,78px)/.99 var(--display);letter-spacing:-.075em}.cta h2 em{color:#245c47;font-style:normal}.cta p{max-width:510px;margin:0 auto 27px;color:#254b3d;font-size:13px;line-height:1.9}.cta .button{background:var(--bg);border-color:var(--bg);color:var(--white)}.cta .button:hover{background:transparent;color:var(--bg)}.footer{padding:23px 0;background:#0b0c10;color:#888c98}.footer-inner{display:flex;justify-content:space-between;align-items:center;gap:20px;font:10px var(--mono)}.footer-links{display:flex;gap:20px}.reveal{opacity:0;transform:translateY(22px);transition:opacity .7s,transform .7s cubic-bezier(.2,.7,.2,1)}.reveal.visible{opacity:1;transform:translateY(0)}.d1{transition-delay:.1s}.d2{transition-delay:.2s}.d3{transition-delay:.3s}
        @@media(max-width:900px){.wrap{width:calc(100% - 42px)}.hero{min-height:900px}.hero-grid{grid-template-columns:1fr;gap:20px}.hero-art{min-height:390px}.section{padding:80px 0}.section-head{grid-template-columns:1fr;gap:20px}.overview,.system-layout,.principles{grid-template-columns:1fr;gap:35px}.features{grid-template-columns:repeat(2,1fr)}.stat{padding-inline:12px}.process{grid-template-columns:repeat(2,1fr);row-gap:25px}.step:nth-child(2){border:0}}
        @@media(max-width:600px){.wrap{width:calc(100% - 36px)}.header{padding:14px 0}.nav{gap:0}.nav a:not(.nav-cta){display:none}.nav .nav-cta{padding:10px;font-size:9px}.hero{min-height:870px;padding:130px 0 75px}.hero h1{font-size:clamp(64px,18vw,92px)}.hero-copy{font-size:13px}.hero-art{min-height:320px}.mock-screen{padding:11px}.screen-heading{font-size:17px}.float-note{left:-2px;bottom:2%;padding:11px}.float-note strong{font-size:13px}.orbit-label{right:-1px}.hero-bottom{bottom:17px;font-size:8px}.stats-grid{grid-template-columns:1fr 1fr}.stat{padding:16px 9px;border-bottom:1px solid var(--line)}.stat:nth-child(2){border-right:0}.stat:nth-child(3){padding-left:0;border-bottom:0}.stat:nth-child(4){border-bottom:0}.stat strong{font-size:13px}.section{padding:68px 0}.section h2{font-size:42px}.overview-art{min-height:290px}.features{grid-template-columns:1fr}.feature{min-height:190px;padding:21px}.feature-top{margin-bottom:22px}.video-section{padding-bottom:75px}.video-shell{padding:5px}.video-caption{flex-direction:column;gap:8px}.diagram{padding:12px}.nodes{gap:5px}.node{padding:11px 4px;overflow-wrap:anywhere}.node b{font-size:11px}.node small{font-size:8px}.process{grid-template-columns:1fr;row-gap:18px}.step{margin:0;padding-top:17px;border-right:0;border-top:1px solid var(--line)}.step>span{margin-bottom:13px}.cta{padding:68px 0}.footer-inner{align-items:flex-start;flex-direction:column}}
        @@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important}.reveal{opacity:1;transform:none}}
    </style>
</head>
<body>
<div class="noise" aria-hidden="true"></div>
<header class="header"><div class="wrap header-inner">
    <a class="brand" href="@Url.Content("~/")"><span class="brand-mark">JP/</span><span>Techninxa<small>PROJECT CASE STUDY / 01</small></span></a>
    <nav class="nav" aria-label="Project navigation"><a href="#overview">Overview</a><a href="#features">Features</a><a href="#architecture">Architecture</a><a class="nav-cta" href="#contact">Start a project ↗</a></nav>
</div></header>
<main>
    <section class="hero" id="top"><div class="wrap hero-grid">
        <div><div class="eyebrow reveal">Cytech Enginnering/ Education platform</div><h1 class="reveal d1">Job<span>Portal.</span></h1>
            <p class="hero-copy reveal d2">A school management platform designed to bring everyday academic and administrative activities into one connected experience — helping schools organise students, teachers, classes, attendance and academic records.</p>
            <div class="tags reveal d2"><span>School School administration</span><span>Student Management</span><span>Teacher & Staff</span><span>Academic Records</span></div>
            <div class="actions reveal d3"><a class="button" href="#overview">Explore the project <span>↘</span></a><a class="text-link" href="#project-video">Watch the walkthrough <span>↗</span></a></div>
        </div>
        <div class="hero-art reveal d1"><div class="art-frame">
            <div class="mock-screen"><div class="screen-top"><div class="screen-brand"><i>J</i> SCHOOL DESK</div><span>School administration</span></div><div class="screen-heading">Manage your<br />school smarter.</div><div class="screen-sub">Keep student information and academic activities organised.</div><div class="screen-search"><span>Student / Class</span><span>Academic year</span><b>Search records</b></div><div class="job-row"><span class="company-icon">N</span><div><strong>Class 10 · Section A</strong><small>42 students · Morning shift</small></div><em>ACTIVE</em></div><div class="job-row"><span class="company-icon">D</span><div><strong>Class 9 · Section B</strong><small>38 students · Morning shift</small></div><em>ACTIVE</em></div><div class="job-row"><span class="company-icon">T</span><div><strong>Class 8 · Section A</strong><small>40 students · Day shift</small></div><em>ACTIVE</em></div></div>
            <span class="orbit-label">SCHOOL / CONNECTED</span></div><div class="float-note"><small>BUILT AROUND PEOPLE</small><strong>Learning meets opportunity.</strong></div></div>
    </div><div class="wrap hero-bottom"><span>Case study / School Management System</span><span>Scroll to explore ↓</span></div></section>
    <section class="stats"><div class="wrap stats-grid"><div class="stat"><small>Platform</small><strong>School administration</strong></div><div class="stat"><small>Primary users</small><strong>Students & teachers</strong></div><div class="stat"><small>Experience</small><strong>Web application</strong></div><div class="stat"><small>Project media</small><strong>Video walkthrough</strong></div></div></section>
    <section class="section" id="overview"><div class="wrap">
        <div class="section-head reveal"><div><div class="kicker">01 / Project overview</div><h2>Better school management starts<br />with <em>better organisation.</em></h2></div><p class="intro">The School Management System brings the core recruitment journey into one place. Teachers can explore roles and present their experience, while employers can share vacancies and manage applications through a more organised workflow.</p></div>
        <div class="overview"><div class="overview-art reveal"><div class="mock-screen"><div class="screen-top"><div class="screen-brand"><i>J</i> SCHOOL DESK</div><span>Academic workspace</span></div><div class="screen-heading">A smarter school<br />starts here.</div><div class="screen-sub">Keep school records clear, consistent and easy to access.</div><div class="job-row"><span class="company-icon">✓</span><div><strong>Student records</strong><small>Profiles, classes and contact details</small></div><em>85%</em></div><div class="job-row"><span class="company-icon">↗</span><div><strong>Attendance overview</strong><small>Follow daily attendance records</small></div><em>ACTIVE</em></div><div class="job-row"><span class="company-icon">☆</span><div><strong>Academic records</strong><small>Keep school information organised</small></div><em>VIEW</em></div></div><span class="image-label">School dashboard / UI concept</span></div>
            <div class="copy reveal d1"><div class="kicker">The school management challenge</div><h3>Make daily school administration clear, consistent and manageable.</h3><p>School administration involves connected tasks: maintaining student and teacher records, organising classes, recording attendance, managing academic information and communicating important updates.</p><p>The system organises these activities around the needs of school administrators, teachers, students and guardians. Its goal is to reduce repetitive paperwork, improve access to information and make daily school operations easier to manage.</p><blockquote class="quote">“One connected platform for organised school operations and better learning support.”</blockquote></div>
        </div>
    </div></section>
    <section class="section band" id="features"><div class="wrap">
        <div class="section-head reveal"><div><div class="kicker">02 / Platform capabilities</div><h2>Every record has a place.<br /><em>Every school day has a flow.</em></h2></div><p class="intro">The showcase highlights common school management workflows. Feature descriptions are written for a school administration system; keep only the modules that are present in the actual project.</p></div>
        <div class="features">
            <article class="feature reveal"><div class="feature-top"><span class="feature-num">01 / 06</span><span class="feature-icon">⌕</span></div><h3>Student management</h3><p>Maintain student profiles, enrolment details, class assignments and essential student information.</p></article>
            <article class="feature reveal d1"><div class="feature-top"><span class="feature-num">02 / 06</span><span class="feature-icon">◎</span></div><h3>Teacher management</h3><p>Organise teacher and staff information, assigned classes and relevant professional records.</p></article>
            <article class="feature reveal d2"><div class="feature-top"><span class="feature-num">03 / 06</span><span class="feature-icon">↗</span></div><h3>Attendance tracking</h3><p>Record and review student attendance to help staff monitor daily classroom participation.</p></article>
            <article class="feature reveal"><div class="feature-top"><span class="feature-num">04 / 06</span><span class="feature-icon">▤</span></div><h3>Class & subject management</h3><p>Organise classes, sections, subjects and teacher assignments in a central workspace.</p></article>
            <article class="feature reveal d1"><div class="feature-top"><span class="feature-num">05 / 06</span><span class="feature-icon">✓</span></div><h3>Exams & results</h3><p>Keep examination schedules, marks and academic results organised when these modules are available.</p></article>
            <article class="feature reveal d2"><div class="feature-top"><span class="feature-num">06 / 06</span><span class="feature-icon">⌘</span></div><h3>School administration</h3><p>Provide a central administrative area for school records, accounts, academic setup and system settings.</p></article>
        </div>
    </div></section>
    <section class="section video-section" id="project-video"><div class="wrap">
        <div class="section-head reveal"><div><div class="kicker">03 / Project walkthrough</div><h2>See the school system<br /><em>in action.</em></h2></div><p class="intro">Watch the project video below to explore the actual School Management System interface and workflows. The video is embedded directly from YouTube, so you do not need to download or host an MP4 file.</p></div>
        <div class="video-shell reveal"><div class="video-frame"><iframe src="@youtubeEmbedUrl" title="School Management System project walkthrough" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div></div>
        <div class="video-caption"><span>School Management System / Project walkthrough</span><a class="video-link" href="https://www.youtube.com/watch?v=WXUPk0HsYgk" target="_blank" rel="noopener noreferrer">Open on YouTube ↗</a></div>
    </div></section>
    <section class="section system" id="architecture"><div class="wrap system-layout">
