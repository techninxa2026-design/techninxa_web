        .jp-video-section{padding-bottom:120px}.jp-video-frame{position:relative;overflow:hidden;padding:10px;border:1px solid var(--jp-line);background:#181a22}.jp-video-frame video{display:block;width:100%;max-height:720px;background:#08090d;object-fit:contain}.jp-caption{display:flex;justify-content:space-between;gap:20px;margin-top:16px;color:var(--jp-muted);font:9px var(--jp-mono);letter-spacing:.12em;text-transform:uppercase}
        .jp-system{background:#e9ebf0;color:#151821}.jp-system .jp-kicker{color:#087e52}.jp-system .jp-section h2{color:#151821}.jp-system .jp-intro{color:#626877}.jp-system-layout{display:grid;grid-template-columns:.75fr 1.25fr;gap:65px;align-items:start}.jp-system-copy p{font-size:13px;line-height:1.95;color:#626877}.jp-system-list{margin-top:25px;border-top:1px solid #cdd0d8}.jp-system-list div{display:flex;justify-content:space-between;gap:15px;padding:14px 0;border-bottom:1px solid #cdd0d8;font-size:10px}.jp-system-list span{color:#737887}.jp-system-list strong{text-align:right;color:#171a22}.jp-diagram{padding:25px;background:#f8f9fb;border:1px solid #d4d7df}.jp-diagram-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:22px;color:#777d8b;font:9px var(--jp-mono);letter-spacing:.12em;text-transform:uppercase}.jp-diagram-root{padding:22px;text-align:center;background:#151821;color:white;font:600 22px var(--jp-display)}.jp-diagram-root small{display:block;margin-top:6px;color:var(--jp-green);font:9px var(--jp-mono);letter-spacing:.14em}.jp-connect{height:34px;display:flex;justify-content:center}.jp-connect span{width:1px;background:#8993b5}.jp-diagram-nodes{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.jp-diagram-nodes:before{content:"";position:absolute;top:0;left:16.6%;right:16.6%;height:1px;background:#8993b5}.jp-node{padding:17px 9px;background:#fff;border:1px solid #d8dbe3;text-align:center}.jp-node b{display:block;margin-bottom:7px;font:600 14px var(--jp-display);color:#222633}.jp-node small{font:10px/1.7 var(--jp-sans);color:#747a88}.jp-diagram-foot{margin:16px 0 0;color:#777d8b;font-size:10px;line-height:1.7}
        .jp-process{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--jp-line)}.jp-step{padding:25px 22px 0 0;margin-right:22px;border-right:1px solid var(--jp-line)}.jp-step:last-child{border:0;margin:0}.jp-step>span{display:block;margin-bottom:27px;color:var(--jp-green);font:10px var(--jp-mono);letter-spacing:.14em}.jp-step h3{margin:0 0 11px;font:600 21px var(--jp-display)}.jp-step p{margin:0;color:var(--jp-muted);font-size:12px;line-height:1.85}.jp-principles{display:grid;grid-template-columns:1fr 1fr;gap:70px}.jp-principle-list{border-top:1px solid var(--jp-line)}.jp-principle{display:grid;grid-template-columns:40px 1fr;gap:14px;padding:20px 0;border-bottom:1px solid var(--jp-line)}.jp-principle>span{padding-top:4px;color:var(--jp-green);font:10px var(--jp-mono)}.jp-principle h3{margin:0 0 7px;font:600 19px var(--jp-display)}.jp-principle p{margin:0;color:var(--jp-muted);font-size:12px;line-height:1.8}.jp-cta{padding:100px 0;background:var(--jp-green);color:var(--jp-bg);text-align:center}.jp-cta .jp-eyebrow{justify-content:center;color:var(--jp-bg)}.jp-cta .jp-eyebrow:before{background:var(--jp-bg)}.jp-cta h2{max-width:850px;margin:22px auto;font:600 clamp(43px,7vw,82px)/.99 var(--jp-display);letter-spacing:-.075em}.jp-cta h2 em{color:#245c47;font-style:normal}.jp-cta p{max-width:510px;margin:0 auto 28px;color:#254b3d;font-size:13px;line-height:1.9}.jp-cta .jp-button{background:var(--jp-bg);border-color:var(--jp-bg);color:var(--jp-white)}.jp-cta .jp-button:hover{background:transparent;color:var(--jp-bg)}.jp-footer{padding:23px 0;background:#0b0c10;color:#888c98}.jp-footer-inner{display:flex;justify-content:space-between;align-items:center;gap:20px;font:10px var(--jp-mono)}.jp-footer-links{display:flex;gap:20px}.jp-footer a:hover{color:var(--jp-green)}.jp-reveal{opacity:0;transform:translateY(24px);transition:opacity .8s,transform .8s cubic-bezier(.2,.7,.2,1)}.jp-reveal.is-visible{opacity:1;transform:translateY(0)}.jp-delay-1{transition-delay:.1s}.jp-delay-2{transition-delay:.2s}.jp-delay-3{transition-delay:.3s}
        @@media(max-width:900px){.jp-wrap{width:min(calc(100% - 42px),var(--jp-width))}.jp-hero{min-height:740px}.jp-hero-grid{grid-template-columns:1fr}.jp-hero-art{min-height:420px}.jp-hero-content{max-width:680px}.jp-section{padding:88px 0}.jp-section-head{grid-template-columns:1fr;gap:22px}.jp-overview,.jp-system-layout,.jp-principles{grid-template-columns:1fr;gap:38px}.jp-capabilities{grid-template-columns:repeat(2,1fr)}.jp-stat{padding-inline:15px}.jp-process{grid-template-columns:repeat(2,1fr);row-gap:28px}.jp-step:nth-child(2){border:0}}
        @@media(max-width:600px){.jp-wrap{width:calc(100% - 36px)}.jp-header{padding:15px 0}.jp-nav{gap:0}.jp-nav a:not(.jp-contact-link){display:none}.jp-nav .jp-contact-link{padding:10px 11px;font-size:9px}.jp-hero{min-height:900px;padding:135px 0 70px}.jp-hero h1{font-size:clamp(65px,18vw,95px)}.jp-hero-copy{font-size:13px}.jp-hero-art{min-height:330px}.jp-art-frame{width:92%}.jp-art-screen{padding:11px}.jp-screen-heading{font-size:16px}.jp-float-note{left:-2px;bottom:2%;padding:12px}.jp-float-note strong{font-size:14px}.jp-orbit-label{right:-1px}.jp-hero-bottom{bottom:18px;font-size:8px}.jp-stats-grid{grid-template-columns:1fr 1fr}.jp-stat{padding:17px 10px;border-bottom:1px solid var(--jp-line)}.jp-stat:nth-child(2){border-right:0}.jp-stat:nth-child(3){padding-left:0;border-bottom:0}.jp-stat:nth-child(4){border-bottom:0}.jp-stat strong{font-size:14px}.jp-section{padding:70px 0}.jp-section h2{font-size:43px}.jp-overview-art{min-height:310px}.jp-capabilities{grid-template-columns:1fr}.jp-capability{min-height:205px;padding:22px}.jp-cap-top{margin-bottom:24px}.jp-video-section{padding-bottom:75px}.jp-video-frame{padding:6px}.jp-video-frame video{min-height:220px}.jp-caption{flex-direction:column;gap:8px}.jp-diagram{padding:13px}.jp-diagram-nodes{gap:5px}.jp-node{padding:12px 4px;overflow-wrap:anywhere}.jp-node b{font-size:11px}.jp-node small{font-size:8px}.jp-process{grid-template-columns:1fr;row-gap:20px}.jp-step{margin:0;padding-top:19px;border-right:0;border-top:1px solid var(--jp-line)}.jp-step>span{margin-bottom:14px}.jp-cta{padding:70px 0}.jp-footer-inner{align-items:flex-start;flex-direction:column}}
        @@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}.jp-reveal{opacity:1;transform:none}}
    </style>
</head>
<body>
<div class="jp-page" id="top">
    <div class="jp-noise" aria-hidden="true"></div>
    <header class="jp-header"><div class="jp-wrap jp-header-inner">
        <a class="jp-brand" href="@Url.Content("~/")"><span class="jp-mark">JP/</span><span>Techninxa<small>PROJECT CASE STUDY / 01</small></span></a>
        <nav class="jp-nav" aria-label="Case study navigation"><a href="#overview">Overview</a><a href="#features">Features</a><a href="#architecture">Architecture</a><a class="jp-contact-link" href="#contact">Start a project ↗</a></nav>
    </div></header>
    <main>
        <section class="jp-hero"><div class="jp-wrap jp-hero-grid">
            <div class="jp-hero-content"><div class="jp-eyebrow jp-reveal">Cytech Enginnering/ Web application</div>
                <h1 class="jp-reveal jp-delay-1">Job<span>Portal.</span></h1>
                <p class="jp-hero-copy jp-reveal jp-delay-2">A recruitment platform designed to bring job seekers and employers into one streamlined digital experience — from discovering opportunities and managing applications to publishing vacancies and reviewing candidates.</p>
                <div class="jp-tags jp-reveal jp-delay-2"><span>Recruitment Platform</span><span>Candidate Experience</span><span>Employer Dashboard</span><span>Admin Management</span></div>
                <div class="jp-actions jp-reveal jp-delay-3"><a class="jp-button" href="#overview">Explore the project <span>↘</span></a><a class="jp-text-link" href="#project-video">Watch the walkthrough <span>↗</span></a></div>
            </div>
            <div class="jp-hero-art jp-reveal jp-delay-1" aria-label="Illustration of the job portal interface"><div class="jp-art-frame" data-jp-tilt><span class="jp-crosshair a"></span><span class="jp-crosshair b"></span>
                <div class="jp-art-screen" aria-hidden="true"><div class="jp-screen-top"><div class="jp-screen-brand"><i>J</i> JOB PORTAL</div><span>Find your next move</span></div><div class="jp-screen-heading">Let's find your<br />dream job.</div><div class="jp-screen-sub">Discover opportunities that match your ambition.</div><div class="jp-screen-search"><span>Job title or keyword</span><span>Location</span><b>Search jobs</b></div><div class="jp-job-row"><span class="jp-company-icon">N</span><div><strong>Software Developer</strong><small>Northstar Labs · Full-time</small></div><em>NEW</em></div><div class="jp-job-row"><span class="jp-company-icon">D</span><div><strong>UI / UX Designer</strong><small>Digital Works · Hybrid</small></div><em>HOT</em></div><div class="jp-job-row"><span class="jp-company-icon">T</span><div><strong>Backend Engineer</strong><small>TechBridge · Remote</small></div><em>NEW</em></div></div>
                <span class="jp-orbit-label">CAREERS / CONNECTED</span></div><div class="jp-float-note"><small>BUILT AROUND PEOPLE</small><strong>Talent meets opportunity.</strong></div></div>
        </div><div class="jp-wrap jp-hero-bottom"><span>Case study / Job Portal</span><span>Scroll to explore ↓</span></div></section>
        <section class="jp-stats"><div class="jp-wrap jp-stats-grid"><div class="jp-stat"><small>Platform</small><strong>Job marketplace</strong></div><div class="jp-stat"><small>Primary users</small><strong>Candidates & employers</strong></div><div class="jp-stat"><small>Experience</small><strong>Web application</strong></div><div class="jp-stat"><small>Delivery</small><strong>End-to-end workflow</strong></div></div></section>
        <section class="jp-section" id="overview"><div class="jp-wrap">
            <div class="jp-section-head jp-reveal"><div><div class="jp-kicker">01 / Project overview</div><h2>Better hiring starts<br />with <em>better connection.</em></h2></div><p class="jp-intro">The Job Portal brings the core recruitment journey into one place. Candidates can explore roles and present their experience, while employers can share vacancies and manage applications through a more organised workflow.</p></div>
