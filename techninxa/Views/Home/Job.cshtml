@{
    Layout = null;
    ViewData["Title"] = "Job Portal — Recruitment Platform | Techninxa";
    ViewData["Description"] = "A job portal platform connecting candidates, employers and administrators through a streamlined recruitment experience.";
    var coverImage = Url.Content("~/assets/projects/jobportal/cover.jpg");
    var demoVideo = Url.Content("~/assets/projects/jobportal/jobportal.mp4");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101116" />
    <meta name="description" content="@ViewData["Description"]" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root{--jp-bg:#101116;--jp-panel:#171920;--jp-panel2:#1e222c;--jp-white:#f5f6f8;--jp-muted:#9a9eaa;--jp-line:rgba(245,246,248,.14);--jp-green:#53e0a0;--jp-blue:#8ca8ff;--jp-violet:#a995ff;--jp-display:"Space Grotesk",sans-serif;--jp-sans:"Manrope",sans-serif;--jp-mono:"DM Mono",monospace;--jp-width:1200px}
        *{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--jp-bg)}body{margin:0;background:var(--jp-bg);color:var(--jp-white);font-family:var(--jp-sans);overflow-x:hidden}body.jp-lock{overflow:hidden}a{color:inherit;text-decoration:none}button{font:inherit}::selection{background:var(--jp-green);color:#101116}.jp-page{overflow:clip}.jp-wrap{width:min(var(--jp-width),calc(100% - 64px));margin-inline:auto}
        .jp-noise{position:fixed;inset:0;z-index:30;pointer-events:none;opacity:.035;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E")}
        .jp-header{position:absolute;top:0;left:0;width:100%;z-index:10;padding:23px 0;border-bottom:1px solid var(--jp-line)}.jp-header-inner{display:flex;justify-content:space-between;align-items:center;gap:20px}.jp-brand{display:flex;align-items:center;gap:12px;font:700 13px var(--jp-display);letter-spacing:-.03em}.jp-mark{display:grid;place-items:center;width:39px;height:39px;background:var(--jp-white);color:var(--jp-bg);font:700 18px var(--jp-display);letter-spacing:-.08em}.jp-brand small{display:block;margin-top:3px;color:var(--jp-muted);font:10px var(--jp-mono);letter-spacing:.1em}.jp-nav{display:flex;gap:25px;align-items:center;color:#c4c6ce;font-size:10px;letter-spacing:.09em;text-transform:uppercase}.jp-nav a{transition:color .2s}.jp-nav a:hover{color:var(--jp-green)}.jp-nav .jp-contact-link{border:1px solid var(--jp-line);padding:12px 15px;color:var(--jp-white)}
        .jp-hero{position:relative;isolation:isolate;min-height:800px;display:flex;align-items:center;padding:150px 0 90px;background:radial-gradient(ellipse at 78% 42%,rgba(83,224,160,.13),transparent 30%),radial-gradient(ellipse at 88% 82%,rgba(140,168,255,.12),transparent 30%),var(--jp-bg)}.jp-hero-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:42px}.jp-eyebrow{display:flex;align-items:center;gap:12px;color:var(--jp-green);font:10px var(--jp-mono);letter-spacing:.18em;text-transform:uppercase}.jp-eyebrow:before{content:"";width:28px;height:1px;background:currentColor}.jp-hero h1{margin:25px 0;font:700 clamp(68px,9vw,118px)/.84 var(--jp-display);letter-spacing:-.095em}.jp-hero h1 span{display:block;color:transparent;-webkit-text-stroke:1px rgba(245,246,248,.68);margin-top:12px}.jp-hero-copy{max-width:500px;color:#b1b4bf;font-size:14px;line-height:1.9}.jp-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:25px}.jp-tags span{padding:8px 10px;border:1px solid var(--jp-line);color:#d4d6dd;font:9px var(--jp-mono);letter-spacing:.04em}.jp-actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:33px}.jp-button{display:inline-flex;align-items:center;justify-content:center;gap:15px;min-height:49px;padding:0 20px;background:var(--jp-green);border:1px solid var(--jp-green);color:#101116;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;transition:transform .25s,background .25s,color .25s;cursor:pointer}.jp-button:hover{transform:translateY(-3px);background:transparent;color:var(--jp-green)}.jp-text-link{font-size:11px;color:var(--jp-white)}.jp-text-link span{color:var(--jp-green);margin-left:8px}
        .jp-hero-art{position:relative;min-height:475px;display:grid;place-items:center;perspective:1000px}.jp-art-frame{position:relative;width:min(100%,540px);aspect-ratio:1/1;display:grid;place-items:center;border:1px solid rgba(245,246,248,.13);background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.005));overflow:hidden;transform-style:preserve-3d;transition:transform .2s ease-out}.jp-art-frame:before,.jp-art-frame:after{content:"";position:absolute;border:1px solid rgba(83,224,160,.25);border-radius:50%;width:77%;aspect-ratio:1}.jp-art-frame:after{width:57%;border-color:rgba(140,168,255,.38);transform:rotateX(65deg) rotateZ(-25deg)}.jp-art-screen{position:relative;z-index:1;width:84%;padding:18px;border:1px solid #ffffff22;background:#f7f9fc;color:#18202b;box-shadow:0 28px 80px #0008;transform:rotate(-4deg)}.jp-screen-top{display:flex;align-items:center;justify-content:space-between;gap:8px;padding-bottom:13px;border-bottom:1px solid #e3e7ed;font-size:9px;font-weight:800}.jp-screen-brand{display:flex;align-items:center;gap:6px;color:#087e52}.jp-screen-brand i{display:grid;place-items:center;width:18px;height:18px;background:#087e52;color:#fff;font-style:normal;border-radius:5px}.jp-screen-top span:last-child{color:#8b94a3;font-weight:500}.jp-screen-heading{margin:18px 0 5px;font:700 20px var(--jp-display);letter-spacing:-.06em}.jp-screen-sub{color:#8791a1;font-size:8px}.jp-screen-search{display:grid;grid-template-columns:1fr 1fr auto;gap:6px;margin:15px 0}.jp-screen-search span{padding:9px 7px;background:#edf1f6;border-radius:4px;color:#798394;font-size:7px}.jp-screen-search b{padding:9px 10px;background:#078753;color:white;border-radius:4px;font-size:7px}.jp-job-row{display:grid;grid-template-columns:28px 1fr auto;align-items:center;gap:8px;padding:10px 0;border-top:1px solid #e8ebf0}.jp-company-icon{display:grid;place-items:center;width:27px;height:27px;border-radius:7px;background:#e2f5ec;color:#087e52;font-size:10px;font-weight:800}.jp-job-row strong{display:block;font-size:8px}.jp-job-row small{display:block;margin-top:4px;color:#8992a0;font-size:7px}.jp-job-row em{font-style:normal;color:#078753;font-size:7px;font-weight:800}.jp-crosshair{position:absolute;width:18px;height:18px;z-index:2}.jp-crosshair:before,.jp-crosshair:after{content:"";position:absolute;background:var(--jp-green)}.jp-crosshair:before{height:1px;width:18px;top:8px}.jp-crosshair:after{width:1px;height:18px;left:8px}.jp-crosshair.a{left:18px;top:18px}.jp-crosshair.b{right:18px;bottom:18px}.jp-orbit-label{position:absolute;z-index:3;right:-5px;top:11%;padding:12px 14px;background:var(--jp-green);color:var(--jp-bg);font:9px var(--jp-mono);letter-spacing:.13em;transform:rotate(4deg)}.jp-float-note{position:absolute;z-index:3;left:-9px;bottom:7%;padding:16px 17px;background:#1b1e27;border:1px solid var(--jp-line);box-shadow:0 20px 50px #0005;transform:rotate(-3deg)}.jp-float-note small{display:block;color:var(--jp-muted);font:9px var(--jp-mono);letter-spacing:.12em}.jp-float-note strong{display:block;margin-top:7px;font:600 17px var(--jp-display)}.jp-hero-bottom{position:absolute;bottom:30px;left:0;width:100%;display:flex;justify-content:space-between;color:#777c89;font:9px var(--jp-mono);letter-spacing:.13em;text-transform:uppercase}
        .jp-stats{background:var(--jp-panel);border-block:1px solid var(--jp-line)}.jp-stats-grid{display:grid;grid-template-columns:repeat(4,1fr)}.jp-stat{padding:25px 22px;border-right:1px solid var(--jp-line)}.jp-stat:first-child{padding-left:0}.jp-stat:last-child{border:0}.jp-stat small{display:block;margin-bottom:9px;color:var(--jp-muted);font:9px var(--jp-mono);letter-spacing:.14em;text-transform:uppercase}.jp-stat strong{font:600 16px var(--jp-display)}.jp-section{padding:112px 0}.jp-section-head{display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;align-items:end;margin-bottom:48px}.jp-kicker{margin-bottom:16px;color:var(--jp-green);font:10px var(--jp-mono);letter-spacing:.18em;text-transform:uppercase}.jp-section h2{margin:0;font:600 clamp(40px,5vw,66px)/1.02 var(--jp-display);letter-spacing:-.07em}.jp-section h2 em{font-style:normal;color:var(--jp-green)}.jp-intro{max-width:560px;margin:0;color:var(--jp-muted);font-size:13px;line-height:1.95}
        .jp-overview{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center}.jp-overview-art{position:relative;min-height:420px;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid var(--jp-line);background:radial-gradient(circle at 50% 50%,#293c38 0%,#1a1d26 52%,#14161d 100%)}.jp-overview-art:before{content:"";position:absolute;width:70%;aspect-ratio:1;border:1px solid rgba(83,224,160,.3);border-radius:50%}.jp-overview-art .jp-art-screen{width:78%;transform:rotate(-3deg)}.jp-image-label{position:absolute;left:17px;bottom:17px;z-index:2;background:var(--jp-green);color:var(--jp-bg);padding:10px 12px;font:9px var(--jp-mono);letter-spacing:.1em;text-transform:uppercase}.jp-copy h3{margin:0 0 18px;font:600 31px/1.2 var(--jp-display);letter-spacing:-.04em}.jp-copy p{color:var(--jp-muted);font-size:13px;line-height:1.95}.jp-quote{margin-top:25px;padding:5px 0 5px 19px;border-left:2px solid var(--jp-violet);font:500 20px/1.5 var(--jp-display);color:#dfe2eb}
