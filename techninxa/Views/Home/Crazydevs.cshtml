.cd-diagram{padding:25px;background:#f8f9fb;border:1px solid #d4d7df}.cd-diagram-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:22px;color:#777d8b;font:9px var(--cd-mono);letter-spacing:.12em;text-transform:uppercase}.cd-diagram-root{padding:22px;text-align:center;background:#151821;color:white;font:600 22px var(--cd-display)}.cd-diagram-root small{display:block;margin-top:6px;color:var(--cd-cyan);font:9px var(--cd-mono);letter-spacing:.14em}.cd-connect{height:34px;display:flex;justify-content:center}.cd-connect span{width:1px;background:#8993b5}.cd-diagram-nodes{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.cd-diagram-nodes:before{content:"";position:absolute;top:0;left:16.6%;right:16.6%;height:1px;background:#8993b5}.cd-node{padding:17px 9px;background:#fff;border:1px solid #d8dbe3;text-align:center}.cd-node b{display:block;margin-bottom:7px;font:600 14px var(--cd-display);color:#222633}.cd-node small{font:10px/1.7 var(--cd-sans);color:#747a88}.cd-diagram-foot{margin:16px 0 0;color:#777d8b;font-size:10px;line-height:1.7}
