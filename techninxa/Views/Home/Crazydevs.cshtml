.cd-copy h3{margin:0 0 18px;font:600 31px/1.2 var(--cd-display);letter-spacing:-.04em}.cd-copy p{color:var(--cd-muted);font-size:13px;line-height:1.95}.cd-quote{margin-top:25px;padding:5px 0 5px 19px;border-left:2px solid var(--cd-violet);font:500 20px/1.5 var(--cd-display);color:#dfe2eb}
