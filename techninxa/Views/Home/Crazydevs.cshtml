.cd-principles{display:grid;grid-template-columns:1fr 1fr;gap:70px}.cd-principle-list{border-top:1px solid var(--cd-line)}.cd-principle{display:grid;grid-template-columns:40px 1fr;gap:14px;padding:20px 0;border-bottom:1px solid var(--cd-line)}.cd-principle>span{padding-top:4px;color:var(--cd-cyan);font:10px var(--cd-mono)}.cd-principle h3{margin:0 0 7px;font:600 19px var(--cd-display)}.cd-principle p{margin:0;color:var(--cd-muted);font-size:12px;line-height:1.8}
.cd-palette{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:28px}.cd-swatch-color{height:76px;border:1px solid #ffffff18}.cd-swatch small{display:block;margin-top:8px;color:var(--cd-muted);font:9px/1.6 var(--cd-mono)}.cd-swatch b{display:block;color:var(--cd-white);font:10px var(--cd-sans)}
.cd-cta{padding:100px 0;background:var(--cd-cyan);color:var(--cd-bg);text-align:center}.cd-cta .cd-eyebrow{justify-content:center;color:var(--cd-bg)}.cd-cta .cd-eyebrow:before{background:var(--cd-bg)}.cd-cta h2{max-width:850px;margin:22px auto;font:600 clamp(43px,7vw,82px)/.99 var(--cd-display);letter-spacing:-.075em}.cd-cta h2 em{color:#3f5cba;font-style:normal}.cd-cta p{max-width:510px;margin:0 auto 28px;color:#34464b;font-size:13px;line-height:1.9}.cd-cta .cd-button{background:var(--cd-bg);border-color:var(--cd-bg);color:var(--cd-white)}.cd-cta .cd-button:hover{background:transparent;color:var(--cd-bg)}
.cd-footer{padding:23px 0;background:#0b0c10;color:#888c98}.cd-footer-inner{display:flex;justify-content:space-between;align-items:center;gap:20px;font:10px var(--cd-mono)}.cd-footer-links{display:flex;gap:20px}.cd-footer a:hover{color:var(--cd-cyan)}
.cd-lightbox{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:30px;background:rgba(5,6,10,.96);opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}.cd-lightbox.is-open{opacity:1;visibility:visible}.cd-lightbox img{max-width:95vw;max-height:86vh;object-fit:contain;border:1px solid var(--cd-line)}.cd-lightbox-close{position:absolute;right:22px;top:20px;width:44px;height:44px;border:1px solid var(--cd-line);background:transparent;color:white;font-size:25px;cursor:pointer}
.cd-reveal{opacity:0;transform:translateY(24px);transition:opacity .8s,transform .8s cubic-bezier(.2,.7,.2,1)}.cd-reveal.is-visible{opacity:1;transform:translateY(0)}.cd-delay-1{transition-delay:.1s}.cd-delay-2{transition-delay:.2s}.cd-delay-3{transition-delay:.3s}
@@media(max-width:900px){.cd-wrap{width:min(calc(100% - 42px),var(--cd-width))}.cd-hero{min-height:740px}.cd-hero-grid{grid-template-columns:1fr}.cd-hero-art{display:none}.cd-hero-content{max-width:680px}.cd-section{padding:88px 0}.cd-section-head{grid-template-columns:1fr;gap:22px}.cd-overview,.cd-system-layout,.cd-principles{grid-template-columns:1fr;gap:38px}.cd-capabilities{grid-template-columns:repeat(2,1fr)}.cd-stat{padding-inline:15px}.cd-process{grid-template-columns:repeat(2,1fr);row-gap:28px}.cd-step:nth-child(2){border:0}}
@@media(max-width:600px){.cd-wrap{width:calc(100% - 36px)}.cd-header{padding:15px 0}.cd-nav{gap:0}.cd-nav a:not(.cd-contact-link){display:none}.cd-nav .cd-contact-link{padding:10px 11px;font-size:9px}.cd-hero{min-height:710px;padding:145px 0 75px}.cd-hero h1{font-size:clamp(68px,19vw,100px)}.cd-hero-copy{font-size:13px}.cd-hero-bottom{bottom:20px;font-size:8px}.cd-stats-grid{grid-template-columns:1fr 1fr}.cd-stat{padding:17px 10px;border-bottom:1px solid var(--cd-line)}.cd-stat:nth-child(2){border-right:0}.cd-stat:nth-child(3){padding-left:0;border-bottom:0}.cd-stat:nth-child(4){border-bottom:0}.cd-stat strong{font-size:14px}.cd-section{padding:70px 0}.cd-section h2{font-size:43px}.cd-overview-art{min-height:310px}.cd-capabilities{grid-template-columns:1fr}.cd-capability{min-height:205px;padding:22px}.cd-cap-top{margin-bottom:24px}.cd-showcase{padding-bottom:75px}.cd-feature-art{padding:6px}.cd-feature-art img{min-height:220px}.cd-feature-art:after{right:13px;bottom:13px}.cd-caption{flex-direction:column;gap:8px}.cd-diagram{padding:13px}.cd-diagram-nodes{gap:5px}.cd-node{padding:12px 4px;overflow-wrap:anywhere}.cd-node b{font-size:11px}.cd-node small{font-size:8px}.cd-process{grid-template-columns:1fr;row-gap:20px}.cd-step{margin:0;padding-top:19px;border-right:0;border-top:1px solid var(--cd-line)}.cd-step>span{margin-bottom:14px}.cd-palette{gap:5px}.cd-swatch-color{height:55px}.cd-cta{padding:70px 0}.cd-footer-inner{align-items:flex-start;flex-direction:column}.cd-lightbox{padding:15px}}
@@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}.cd-reveal{opacity:1;transform:none}}
