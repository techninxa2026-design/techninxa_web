.cd-stats{background:var(--cd-panel);border-block:1px solid var(--cd-line)}.cd-stats-grid{display:grid;grid-template-columns:repeat(4,1fr)}.cd-stat{padding:25px 22px;border-right:1px solid var(--cd-line)}.cd-stat:first-child{padding-left:0}.cd-stat:last-child{border:0}.cd-stat small{display:block;margin-bottom:9px;color:var(--cd-muted);font:9px var(--cd-mono);letter-spacing:.14em;text-transform:uppercase}.cd-stat strong{font:600 16px var(--cd-display)}
.cd-section{padding:112px 0}.cd-section-head{display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;align-items:end;margin-bottom:48px}.cd-kicker{margin-bottom:16px;color:var(--cd-cyan);font:10px var(--cd-mono);letter-spacing:.18em;text-transform:uppercase}.cd-section h2{margin:0;font:600 clamp(40px,5vw,66px)/1.02 var(--cd-display);letter-spacing:-.07em}.cd-section h2 em{font-style:normal;color:var(--cd-cyan)}.cd-intro{max-width:560px;margin:0;color:var(--cd-muted);font-size:13px;line-height:1.95}
