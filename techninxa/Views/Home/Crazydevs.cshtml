<script>
(() => {
 const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 const items = document.querySelectorAll('.cd-reveal');
 if ('IntersectionObserver' in window && !reduceMotion) {
  const observer = new IntersectionObserver((entries, obs) => {
   entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); obs.unobserve(entry.target); } });
  }, { threshold: .12, rootMargin: '0px 0px -35px 0px' });
  items.forEach(item => observer.observe(item));
 } else items.forEach(item => item.classList.add('is-visible'));
 const frame = document.querySelector('[data-cd-tilt]');
 const hero = document.querySelector('.cd-hero');
 if (frame && hero && !reduceMotion && window.matchMedia('(pointer:fine)').matches) {
  hero.addEventListener('pointermove', e => {
   const r = frame.getBoundingClientRect();
   const x = (e.clientX-r.left)/r.width-.5, y = (e.clientY-r.top)/r.height-.5;
   frame.style.transform = `rotateY(${x*8}deg) rotateX(${y*-7}deg)`;
  });
  hero.addEventListener('pointerleave', () => frame.style.transform = 'rotateY(0deg) rotateX(0deg)');
 }
 const lightbox = document.querySelector('.cd-lightbox');
 const lightboxImage = lightbox?.querySelector('img');
 const close = lightbox?.querySelector('.cd-lightbox-close');
 const artwork = document.querySelector('[data-cd-lightbox]');
 function openLightbox() {
  const image = artwork?.querySelector('img');
  if (!lightbox || !image || !lightboxImage) return;
  lightboxImage.src = image.currentSrc || image.src;
  lightbox.classList.add('is-open'); lightbox.setAttribute('aria-hidden','false');
  document.body.classList.add('cd-lock'); close?.focus();
 }
 function closeLightbox() {
  if (!lightbox) return;
  lightbox.classList.remove('is-open'); lightbox.setAttribute('aria-hidden','true');
  document.body.classList.remove('cd-lock');
 }
 artwork?.addEventListener('click',openLightbox);
 close?.addEventListener('click',closeLightbox);
 lightbox?.addEventListener('click',e => { if(e.target===lightbox) closeLightbox(); });
 document.addEventListener('keydown',e => { if(e.key==='Escape') closeLightbox(); });
})();
</script>
