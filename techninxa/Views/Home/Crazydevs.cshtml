<style>
:root{--cd-bg:#101116;--cd-panel:#171920;--cd-panel2:#1e222c;--cd-white:#f5f6f8;--cd-muted:#9a9eaa;--cd-line:rgba(245,246,248,.14);--cd-blue:#8ca8ff;--cd-cyan:#7ce8e2;--cd-violet:#a995ff;--cd-display:"Space Grotesk",sans-serif;--cd-sans:"Manrope",sans-serif;--cd-mono:"DM Mono",monospace;--cd-width:1200px}
