@{
    Layout = null;
    ViewData["Title"] = "AI Knowledge Hub | Project Case Study";
    ViewData["Description"] = "A case study for AI Knowledge Hub, a content discovery platform with searchable blog posts and an AI chat experience.";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080a12" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Description"]" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root{--bg:#080a12;--panel:#101421;--panel2:#151b2b;--text:#f4f6ff;--muted:#9aa4bd;--line:rgba(255,255,255,.11);--violet:#9c7bff;--cyan:#62e6f5;--max:1160px}
        *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;line-height:1.65;overflow-x:hidden}a{color:inherit;text-decoration:none}img{display:block;width:100%;object-fit:cover}button{font:inherit}.wrap{width:min(var(--max),calc(100% - 44px));margin:auto}.grain{pointer-events:none;position:fixed;inset:0;z-index:20;opacity:.035;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E")}
        .nav{position:sticky;top:0;z-index:15;border-bottom:1px solid var(--line);background:rgba(8,10,18,.78);backdrop-filter:blur(18px)}.nav-in{height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-family:'Space Grotesk';font-weight:700;letter-spacing:-.04em;font-size:19px;display:flex;align-items:center;gap:10px}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:linear-gradient(135deg,var(--violet),var(--cyan));color:#080a12;font-weight:800}.nav-links{display:flex;align-items:center;gap:27px;color:#c2c8d8;font-size:13px}.nav-links a:hover{color:white}.nav-cta,.button{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid var(--line);border-radius:999px;padding:11px 17px;font-size:13px;font-weight:700;transition:transform .25s,border-color .25s,background .25s}.nav-cta:hover,.button:hover{transform:translateY(-3px);border-color:rgba(156,123,255,.8)}.button.primary{background:linear-gradient(100deg,var(--violet),#7e9dff);color:#090b15;border:0}.eyebrow{display:flex;align-items:center;gap:10px;color:#c5b7ff;text-transform:uppercase;letter-spacing:.18em;font-size:11px;font-weight:700}.eyebrow:before{content:'';width:26px;height:1px;background:var(--cyan)}h1,h2,h3{font-family:'Space Grotesk',sans-serif;line-height:1.08;letter-spacing:-.045em;margin:0}h1{font-size:clamp(42px,6.5vw,78px);max-width:850px;margin-top:24px}h1 .gradient{background:linear-gradient(100deg,#fff 4%,#c4b4ff 48%,#72e8f4 100%);-webkit-background-clip:text;background-clip:text;color:transparent}.lead{font-size:clamp(16px,1.7vw,19px);color:#aab3ca;max-width:680px;margin:25px 0 0}.hero{padding:94px 0 80px;position:relative}.hero:before{content:'';position:absolute;width:700px;height:600px;right:-250px;top:-200px;background:radial-gradient(ellipse,rgba(120,92,255,.19),transparent 65%);pointer-events:none}.hero-meta{display:flex;gap:12px;flex-wrap:wrap;margin-top:29px}.pill{border:1px solid var(--line);background:rgba(255,255,255,.035);color:#cbd2e4;border-radius:999px;padding:7px 12px;font-size:12px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.hero-visual{margin-top:64px;position:relative;perspective:1200px}.browser{border:1px solid rgba(255,255,255,.16);border-radius:19px;overflow:hidden;background:#0f1320;box-shadow:0 35px 100px rgba(0,0,0,.42);transform:rotateX(2deg);transition:transform .6s}.browser:hover{transform:rotateX(0) translateY(-5px)}.browser-bar{height:45px;display:flex;align-items:center;gap:7px;padding:0 17px;border-bottom:1px solid var(--line);background:#111624}.dot{width:8px;height:8px;border-radius:50%;background:#4d566b}.address{margin-left:12px;border:1px solid var(--line);border-radius:6px;padding:3px 12px;color:#7d879e;font-size:10px;width:min(300px,55%)}.screen{padding:clamp(16px,3vw,35px);background:radial-gradient(ellipse at 90% 0%,rgba(112,87,236,.12),transparent 45%),#0d111c}.screen-nav{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:36px}.screen-logo{font-family:'Space Grotesk';font-weight:700;font-size:clamp(13px,1.7vw,19px)}.screen-logo span{color:var(--cyan)}.screen-links{font-size:11px;color:#9ba6bf;display:flex;gap:18px}.screen h2{font-size:clamp(25px,4vw,43px);margin:0 0 10px}.screen-sub{font-size:12px;color:#8f9ab2;margin-bottom:20px}.search-ui{display:flex;justify-content:space-between;align-items:center;gap:10px;border:1px solid rgba(255,255,255,.13);border-radius:10px;padding:11px 14px;color:#8490a8;font-size:11px;margin-bottom:23px;background:rgba(255,255,255,.025)}.search-ui strong{background:#a48aff;color:#090b15;border-radius:6px;padding:6px 10px}.preview-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.preview-card{min-width:0;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#131927;transition:transform .3s,border-color .3s}.preview-card:hover{transform:translateY(-5px);border-color:rgba(98,230,245,.5)}.preview-card img{height:clamp(90px,14vw,170px)}.preview-copy{padding:13px}.preview-copy small{font-size:9px;color:var(--cyan)}.preview-copy h3{font-size:clamp(12px,1.5vw,17px);margin:8px 0}.preview-copy p{font-size:10px;color:#96a1b8;margin:0}.float-tag{position:absolute;right:-14px;top:15%;padding:12px 16px;border:1px solid rgba(255,255,255,.16);border-radius:12px;background:rgba(19,24,41,.9);backdrop-filter:blur(12px);box-shadow:0 15px 40px #0005;font-size:11px;color:#dbe2f4}.float-tag b{color:var(--cyan);display:block;font-size:13px}.section{padding:100px 0;border-top:1px solid var(--line)}.section-head{display:grid;grid-template-columns:.8fr 1.2fr;gap:45px;align-items:start;margin-bottom:48px}.section-head h2{font-size:clamp(32px,4.2vw,52px);margin-top:15px}.section-head p{color:var(--muted);margin:10px 0 0;max-width:590px}.overview-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.info-card{padding:27px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.012))}.info-card .number{font-family:'Space Grotesk';font-size:12px;color:var(--cyan);letter-spacing:.12em}.info-card h3{font-size:22px;margin:17px 0 12px}.info-card p{font-size:14px;color:var(--muted);margin:0}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.feature{border:1px solid var(--line);border-radius:16px;padding:23px;background:rgba(255,255,255,.025);min-height:205px;transition:transform .3s,background .3s}.feature:hover{transform:translateY(-6px);background:rgba(156,123,255,.07)}.feature-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:linear-gradient(135deg,rgba(156,123,255,.22),rgba(98,230,245,.12));color:var(--cyan);font-size:20px}.feature h3{font-size:18px;margin:20px 0 10px}.feature p{font-size:13px;color:var(--muted);margin:0}.showcase{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:stretch}.showcase figure{margin:0;overflow:hidden;border:1px solid var(--line);border-radius:17px;background:var(--panel)}.showcase figure img{height:270px;transition:transform .7s}.showcase figure:hover img{transform:scale(1.04)}.showcase figcaption{padding:19px 21px}.showcase figcaption h3{font-size:19px;margin-bottom:8px}.showcase figcaption p{font-size:13px;color:var(--muted);margin:0}.architecture{border:1px solid var(--line);border-radius:18px;padding:25px;background:radial-gradient(ellipse at 50% 0,rgba(156,123,255,.1),transparent 55%),#0d111b}.arch-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.arch-node{padding:19px 12px;text-align:center;border:1px solid rgba(156,123,255,.35);border-radius:12px;background:rgba(156,123,255,.07)}.arch-node .symbol{font-size:22px;color:var(--cyan)}.arch-node b{display:block;font-size:13px;margin:8px 0 4px}.arch-node span{font-size:11px;color:var(--muted)}.arch-connector{height:42px;display:flex;align-items:center;justify-content:center;color:#7d89a4;font-size:12px;gap:10px}.arch-connector:before,.arch-connector:after{content:'';height:1px;width:18%;background:linear-gradient(90deg,transparent,var(--violet))}.arch-connector:after{transform:rotate(180deg)}.arch-bottom{max-width:470px;margin:0 auto}.note{font-size:12px;color:#818da5;margin:16px 0 0}.stack{display:flex;flex-wrap:wrap;gap:10px}.stack span{padding:10px 14px;border:1px solid var(--line);border-radius:9px;background:rgba(255,255,255,.025);font-size:13px;color:#d2d9e9}.process{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.step{padding-top:20px;border-top:1px solid rgba(98,230,245,.5)}.step small{font-size:11px;letter-spacing:.14em;color:var(--cyan)}.step h3{font-size:19px;margin:14px 0 9px}.step p{font-size:13px;color:var(--muted);margin:0}.cta-panel{padding:clamp(30px,6vw,70px);border:1px solid rgba(156,123,255,.28);border-radius:24px;background:radial-gradient(ellipse at 100% 0,rgba(98,230,245,.12),transparent 45%),radial-gradient(ellipse at 0 100%,rgba(156,123,255,.16),transparent 45%),#101421;text-align:center}.cta-panel h2{font-size:clamp(32px,5vw,55px);max-width:700px;margin:16px auto}.cta-panel p{max-width:570px;margin:0 auto;color:var(--muted)}.cta-panel .button{margin-top:26px}.footer{padding:30px 0;color:#78839b;font-size:12px}.footer-in{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap}.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}.reveal.visible{opacity:1;transform:translateY(0)}
        @@media(max-width:800px){.nav-links{display:none}.hero{padding-top:70px}.section{padding:75px 0}.section-head{grid-template-columns:1fr;gap:15px}.feature-grid{grid-template-columns:repeat(2,1fr)}.process{grid-template-columns:repeat(2,1fr)}.float-tag{right:8px;top:-18px}.showcase figure img{height:220px}}
        @@media(max-width:560px){.wrap{width:min(100% - 30px,var(--max))}.nav-in{height:66px}.hero{padding:58px 0 58px}h1{font-size:43px}.lead{font-size:16px}.hero-visual{margin-top:48px}.screen-nav{margin-bottom:23px}.screen-links{gap:9px;font-size:9px}.preview-grid{grid-template-columns:1fr}.preview-card{display:grid;grid-template-columns:100px 1fr}.preview-card img{height:100%;min-height:112px}.preview-copy{padding:11px}.preview-copy p{display:none}.preview-copy h3{font-size:14px}.overview-grid,.showcase{grid-template-columns:1fr}.feature-grid{grid-template-columns:1fr}.feature{min-height:auto}.arch-row{grid-template-columns:1fr}.arch-connector{height:30px}.arch-connector:before,.arch-connector:after{width:10%}.process{grid-template-columns:1fr 1fr}.section-head h2{font-size:36px}.browser-bar{height:37px}.screen{padding:16px}.float-tag{font-size:9px}.float-tag b{font-size:11px}}
        @@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}.reveal{opacity:1;transform:none}}
    </style>
</head>
<body>
<div class="grain"></div>
<header class="nav"><div class="wrap nav-in">
    <a class="brand" href="#top" aria-label="AI Knowledge Hub case study"><span class="brand-mark">AI</span> Knowledge Hub</a>
    <nav class="nav-links" aria-label="Case study navigation"><a href="#overview">Overview</a><a href="#features">Features</a><a href="#architecture">Architecture</a><a href="#stack">Technology</a></nav>
    <a class="nav-cta" href="https://ai.arenabangla.com/blog" target="_blank" rel="noopener">Visit live project ↗</a>
</div></header>
<main id="top">
<section class="hero"><div class="wrap">
    <div class="eyebrow">Selected work · Web application</div>
    <h1>A smarter way to <span class="gradient">discover knowledge.</span></h1>
    <p class="lead">AI Knowledge Hub brings editorial content and an AI chat entry point together in one focused experience—helping visitors explore articles, search for topics, and move from browsing to deeper questions.</p>
    <div class="hero-meta"><span class="pill">Content discovery</span><span class="pill">Search experience</span><span class="pill">AI chat entry point</span><span class="pill">Responsive web</span></div>
    <div class="hero-actions"><a class="button primary" href="https://ai.arenabangla.com/blog" target="_blank" rel="noopener">Explore the live site ↗</a><a class="button" href="#overview">Read the case study ↓</a></div>
    <div class="hero-visual reveal"><div class="browser"><div class="browser-bar"><i class="dot"></i><i class="dot"></i><i class="dot"></i><div class="address">ai.arenabangla.com/blog</div></div><div class="screen">
        <div class="screen-nav"><div class="screen-logo">AI <span>Knowledge Hub</span></div><div class="screen-links"><span>AI Chat</span><span>Post</span></div></div>
        <h2>Latest Blog Posts</h2><div class="screen-sub">Ideas, guides and destinations worth exploring.</div>
        <div class="search-ui"><span>⌕ &nbsp; Search anything...</span><strong>Search ↗</strong></div>
        <div class="preview-grid">
            <article class="preview-card"><img src="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?auto=format&fit=crop&w=700&q=80" alt="Dubai skyline at dusk" loading="lazy"><div class="preview-copy"><small>TRAVEL · DESTINATIONS</small><h3>Dubai, United Arab Emirates</h3><p>A modern city of architecture and experiences.</p></div></article>
            <article class="preview-card"><img src="https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=700&q=80" alt="Traditional Kyoto street" loading="lazy"><div class="preview-copy"><small>TRAVEL · CULTURE</small><h3>Kyoto, Japan</h3><p>Explore history, temples and traditional culture.</p></div></article>
            <article class="preview-card"><img src="https://images.unsplash.com/photo-1513415277900-a62401e19be4?auto=format&fit=crop&w=700&q=80" alt="Green mountain landscape in Bangladesh" loading="lazy"><div class="preview-copy"><small>BANGLADESH · ADVENTURE</small><h3>Bandarban, Bangladesh</h3><p>Mountain scenery and outdoor exploration.</p></div></article>
        </div>
    </div></div><div class="float-tag"><b>Discover → Explore</b>One hub for content and questions</div></div>
</div></section>
<section class="section" id="overview"><div class="wrap">
    <div class="section-head reveal"><div><div class="eyebrow">01 / Overview</div><h2>Content first.<br>Questions welcome.</h2></div><p>AI Knowledge Hub is presented as a lightweight knowledge and publishing experience. The blog page prioritizes fresh posts, clear article titles, summaries, and a search field, while the top navigation gives users a route to AI Chat and Post workflows.</p></div>
    <div class="overview-grid"><article class="info-card reveal"><div class="number">THE CHALLENGE</div><h3>Make useful content easy to find</h3><p>When a site grows beyond a few articles, visitors need more than a long list. Search, readable summaries, consistent cards, and clear article entry points reduce friction between arriving and finding something relevant.</p></article><article class="info-card reveal"><div class="number">THE APPROACH</div><h3>Build a simple discovery loop</h3><p>Bring the latest posts into a scannable feed, make search visible, and keep AI chat and publishing in the primary navigation so browsing and contribution feel connected.</p></article></div>
</div></section>
<section class="section" id="features"><div class="wrap">
    <div class="section-head reveal"><div><div class="eyebrow">02 / Product features</div><h2>Designed around<br>the next useful click.</h2></div><p>The following highlights are based on the visible blog experience. They describe the product surface without assuming undocumented implementation details.</p></div>
    <div class="feature-grid">
        <article class="feature reveal"><div class="feature-icon">⌕</div><h3>Searchable content</h3><p>A prominent search input helps visitors start with a topic instead of scanning every post manually.</p></article>
        <article class="feature reveal"><div class="feature-icon">▤</div><h3>Latest-post feed</h3><p>Posts are presented as a numbered, chronological list with dates and clear article titles.</p></article>
        <article class="feature reveal"><div class="feature-icon">↗</div><h3>Article detail flow</h3><p>Dedicated article links let readers move from a compact preview into the full post.</p></article>
        <article class="feature reveal"><div class="feature-icon">✦</div><h3>AI chat entry point</h3><p>A top-level AI Chat destination puts conversational exploration alongside editorial reading.</p></article>
        <article class="feature reveal"><div class="feature-icon">＋</div><h3>Publishing pathway</h3><p>The Post navigation item makes content contribution discoverable as a separate workflow.</p></article>
        <article class="feature reveal"><div class="feature-icon">▦</div><h3>Topic variety</h3><p>Travel, technology, wellness, and general-interest examples show how a single feed can serve varied subjects.</p></article>
    </div>
</div></section>
<section class="section"><div class="wrap">
    <div class="section-head reveal"><div><div class="eyebrow">03 / Interface details</div><h2>Clear hierarchy.<br>Less cognitive load.</h2></div><p>The visual system in this case-study presentation emphasizes a predictable reading order: page heading, search, post title, supporting excerpt, then the full-article action. Replace these illustrative panels with actual screenshots for a pixel-accurate portfolio presentation.</p></div>
    <div class="showcase"><figure class="reveal"><img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=1200&q=85" alt="Editorial workspace with notebook and laptop" loading="lazy"><figcaption><h3>01 — Browse and scan</h3><p>Consistent post rows make the feed easier to skim and help readers compare topics quickly.</p></figcaption></figure><figure class="reveal"><img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1200&q=85" alt="Abstract artificial intelligence visualization" loading="lazy"><figcaption><h3>02 — Continue the conversation</h3><p>The AI chat route extends the experience beyond static reading into a question-led interaction.</p></figcaption></figure></div>
</div></section>
<section class="section" id="architecture"><div class="wrap">
    <div class="section-head reveal"><div><div class="eyebrow">04 / Conceptual architecture</div><h2>How the experience<br>can be organized.</h2></div><p>This is a high-level product flow diagram—not a claim about the site's actual backend, database schema, or framework. Adapt the labels to match the implementation before publishing technical specifics.</p></div>
    <div class="architecture reveal"><div class="arch-row"><div class="arch-node"><div class="symbol">◉</div><b>Visitor interface</b><span>Blog · Search · Navigation</span></div><div class="arch-node"><div class="symbol">⌕</div><b>Discovery layer</b><span>Query · Filter · Select</span></div><div class="arch-node"><div class="symbol">✦</div><b>AI chat experience</b><span>Question · Response flow</span></div></div><div class="arch-connector">User action ↔ application logic ↔ content services</div><div class="arch-bottom"><div class="arch-node"><div class="symbol">▤</div><b>Content and data layer</b><span>Posts · Metadata · Searchable fields</span></div></div><p class="note">Conceptual only. Confirm actual services, persistence, AI provider, and data model before presenting this as a production architecture diagram.</p></div>
</div></section>
<section class="section" id="stack"><div class="wrap">
    <div class="section-head reveal"><div><div class="eyebrow">05 / Technology</div><h2>Show the stack<br>you actually shipped.</h2></div><p>The public page does not reliably reveal the complete implementation stack. Use this area to list verified technologies from the repository, deployment configuration, and package references rather than guessing.</p></div>
    <div class="stack reveal"><span>Responsive UI</span><span>Content management</span><span>Search workflow</span><span>AI chat integration</span><span>Article detail pages</span><span>SEO-friendly content</span></div>
    <p class="note">Portfolio tip: replace these capability labels with confirmed framework, language, database, hosting, and AI model/provider names once verified.</p>
</div></section>
<section class="section"><div class="wrap"><div class="process reveal">
    <article class="step"><small>PHASE 01</small><h3>Discover</h3><p>Identify key visitor paths: browse recent content, search a subject, open a post, or enter AI chat.</p></article>
    <article class="step"><small>PHASE 02</small><h3>Structure</h3><p>Give the page a clear hierarchy with persistent navigation and repeatable article previews.</p></article>
    <article class="step"><small>PHASE 03</small><h3>Connect</h3><p>Link content discovery to article reading, publishing, and the AI conversation entry point.</p></article>
    <article class="step"><small>PHASE 04</small><h3>Refine</h3><p>Test mobile layouts, search behavior, empty states, accessibility, and article metadata.</p></article>
</div></div></section>
<section class="section"><div class="wrap"><div class="cta-panel reveal"><div class="eyebrow" style="justify-content:center">Have a knowledge product in mind?</div><h2>Turn information into an experience people want to use.</h2><p>Explore the live AI Knowledge Hub blog to see the content-discovery experience in context.</p><a class="button primary" href="https://ai.arenabangla.com/blog" target="_blank" rel="noopener">Visit AI Knowledge Hub ↗</a></div></div></section>
</main>
<footer class="footer"><div class="wrap footer-in"><span>AI Knowledge Hub — Project Case Study</span><a href="#top">Back to top ↑</a></div></footer>
<script>
    (() => {
        const items = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            items.forEach(item => item.classList.add('visible'));
            return;
        }
        const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12 });
        items.forEach(item => observer.observe(item));
    })();
</script>
</body>
</html>
