@using Techninxa.Services
@using System.Linq
@{
    ViewData["Title"] = "Industrial Products, Engineering & Integration";
    var featured = CytechCatalogue.Items.Where(x => new[] { 3, 19, 20, 23, 28, 30 }.Contains(x.Number)).ToList();
}
<div class="cy-real cy-real-home">
    <section class="cy-real-hero">
        <div class="cy-real-grid cy-real-shell">
            <div class="cy-real-hero-copy">
                <div class="cy-real-kicker"><span class="cy-real-pulse"></span> CYTECH ENGINEERING <span class="cy-real-kicker-line"></span> INDUSTRIAL SOLUTIONS</div>
                <h1>Engineering what <em>industry</em> depends on.</h1>
                <p>Industrial products, automation, instrumentation, connectivity, safety and power solutions — backed by system integration, installation, commissioning and technical support.</p>
                <div class="cy-real-actions">
                    <a class="cy-real-btn cy-real-btn-primary" href="/products">Explore the product catalogue <span aria-hidden="true">↗</span></a>
                    <a class="cy-real-btn cy-real-btn-secondary" href="/contact">Request a quotation <span aria-hidden="true">↗</span></a>
                </div>
                <div class="cy-real-hero-foot"><span>PRODUCT CATALOGUE 2026</span><span>BASED IN MIRPUR, DHAKA</span></div>
            </div>
            <div class="cy-real-hero-art">
                <div class="cy-real-hero-art-grid"></div>
                <img src="/assets/cytech-industrial-scene.svg" alt="Illustration of an industrial plant with interconnected engineering systems" width="800" height="680" fetchpriority="high">
                <div class="cy-real-art-caption"><span class="cy-real-pulse"></span> AUTOMATION / POWER / CONNECTIVITY</div>
                <div class="cy-real-art-top"><span>CYTECH / ENGINEERING</span><span>2026</span></div>
            </div>
        </div>
    </section>

    <section class="cy-real-proof" aria-label="Catalogue at a glance">
        <div class="cy-real-shell cy-real-proof-inner">
            <div><strong>38</strong><span>Numbered product sections in our catalogue</span></div>
            <div><strong>05</strong><span>Service areas listed by Cytech</span></div>
            <div><strong>07</strong><span>Industries identified in our catalogue</span></div>
            <a href="/about">Get to know Cytech <span aria-hidden="true">↗</span></a>
        </div>
    </section>

    <section class="cy-real-section cy-real-products-section" id="product-categories">
        <div class="cy-real-shell">
            <div class="cy-real-section-head">
                <div><span class="cy-real-eyebrow">01 / PRODUCT RANGE</span><h2>Industrial equipment.<br><em>Organized for the job.</em></h2></div>
                <div class="cy-real-side-copy"><p>Browse real product types from the Cytech Engineering Industrial Product Catalogue 2026. Share your specifications to discuss suitability and availability.</p><a class="cy-real-text-link" href="/products">View all 38 sections <span aria-hidden="true">↗</span></a></div>
            </div>
            <div class="cy-real-family-grid">
                @foreach (var family in CytechCatalogue.Families)
                {
                    var group = CytechCatalogue.Items.Where(x => x.Family == family).ToList();
                    var familyClass = family == "Automation & Instrumentation" ? "automation"
                        : family == "Electrical & Power" ? "electrical"
                        : family == "Networking & Connectivity" ? "network"
                        : family == "Safety & Security" ? "safety" : "infrastructure";
                    <a class="cy-real-family-card cy-real-family-@familyClass" href="/products?family=@Uri.EscapeDataString(family)">
                        <div class="cy-real-family-top"><span class="cy-real-family-icon" aria-hidden="true"><span></span><span></span><span></span></span><span>@group.Count.ToString("D2") SECTIONS</span></div>
                        <h3>@family</h3><p>@string.Join(" · ", group.Take(3).Select(x => x.Title))</p><span class="cy-real-family-link">Browse category <span aria-hidden="true">↗</span></span>
                    </a>
                }
            </div>
        </div>
    </section>

    <section class="cy-real-section cy-real-dark-section">
        <div class="cy-real-shell">
            <div class="cy-real-section-head"><div><span class="cy-real-eyebrow">02 / SELECTED PRODUCT SECTIONS</span><h2>Built for demanding<br><em>environments.</em></h2></div><div class="cy-real-side-copy"><p>From industrial switches and PLC controls to backup power and surveillance, find the category relevant to your application.</p></div></div>
            <div class="cy-real-featured-grid">
                @foreach (var item in featured)
                {
                    <a class="cy-real-feature-card" href="/products/@item.Slug">
                        <div class="cy-real-feature-top"><span>CATALOGUE / @item.Number.ToString("D2")</span><span class="cy-real-feature-arrow" aria-hidden="true">↗</span></div>
                        <div class="cy-real-feature-symbol" aria-hidden="true"><span class="cy-real-symbol-core"></span><span class="cy-real-symbol-orbit"></span><span class="cy-real-symbol-orbit cy-real-symbol-orbit-second"></span></div>
                        <div><span class="cy-real-feature-family">@item.Family</span><h3>@item.Title</h3><p>@item.Description</p></div>
                    </a>
                }
            </div>
            <div class="cy-real-align-end"><a class="cy-real-btn cy-real-btn-outline" href="/products">See complete catalogue <span aria-hidden="true">↗</span></a></div>
        </div>
    </section>

    <section class="cy-real-section cy-real-services" id="services">
        <div class="cy-real-shell">
            <div class="cy-real-section-head"><div><span class="cy-real-eyebrow">03 / WHAT WE DO</span><h2>Products are only<br><em>part of the solution.</em></h2></div><div class="cy-real-side-copy"><p>Our service offering goes beyond supply. These five services are listed in Cytech's official 2026 catalogue.</p><a class="cy-real-text-link" href="/services">Explore our services <span aria-hidden="true">↗</span></a></div></div>
            <div class="cy-real-services-list">
                @for (var i = 0; i < CytechCatalogue.Services.Count; i++)
                {
                    var item = CytechCatalogue.Services[i];
                    <a href="/services#@item.Slug" class="cy-real-service-row"><span class="cy-real-service-number">@((i + 1).ToString("D2"))</span><div><h3>@item.Name</h3><p>@item.Summary</p></div><span class="cy-real-service-arrow" aria-hidden="true">↗</span></a>
                }
            </div>
        </div>
    </section>

    <section class="cy-real-section cy-real-industry-section">
        <div class="cy-real-shell cy-real-industry-inner">
            <div><span class="cy-real-eyebrow">04 / INDUSTRIES</span><h2>Supporting the systems<br><em>that keep work moving.</em></h2><p>Our catalogue identifies these industries as areas served by Cytech Engineering.</p><a href="/contact" class="cy-real-text-link">Discuss your requirements <span aria-hidden="true">↗</span></a></div>
            <div class="cy-real-industries">
                @for (var i = 0; i < CytechCatalogue.Industries.Count; i++)
                {
                    <div class="cy-real-industry-item"><span>@((i + 1).ToString("D2"))</span><strong>@CytechCatalogue.Industries[i]</strong><span aria-hidden="true">↗</span></div>
                }
            </div>
        </div>
    </section>

    <section class="cy-real-cta">
        <div class="cy-real-shell cy-real-cta-inner">
            <div><span class="cy-real-eyebrow">HAVE A TECHNICAL REQUIREMENT?</span><h2>Let's identify the right<br>product or solution.</h2><p>Send us your specifications, required quantities or project details to start a conversation.</p></div>
            <div class="cy-real-cta-right"><a class="cy-real-btn cy-real-btn-light" href="/contact">Request a quotation <span aria-hidden="true">↗</span></a><a href="mailto:info@cytechbd.com">info@cytechbd.com</a><a href="tel:+8801711015660">+880 1711 015660</a></div>
        </div>
    </section>
</div>
