@{
    var sectionTitle = ViewData["Title"] as string ?? "Cytech Engineering";
    var isCorporateHome = sectionTitle == "Home";
}

<section class="cy-division-placeholder" aria-labelledby="pageTitle">
    <div class="container cy-division-placeholder__inner">
        <span class="cy-division-placeholder__eyebrow"><span aria-hidden="true"></span>CYTECH ENGINEERING / EXPLORE</span>
        <h1 id="pageTitle">@(isCorporateHome ? "Cytech Engineering" : sectionTitle)</h1>
        <div class="cy-division-placeholder__line" aria-hidden="true"></div>
        <p>@(isCorporateHome ? "Corporate homepage content will be added here." : "Page content will be added here.")</p>
    </div>
</section>
