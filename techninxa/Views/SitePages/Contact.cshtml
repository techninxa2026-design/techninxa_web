@model techninxa.Models.CorporateInquiryViewModel
@using Techninxa.Services
@{ ViewData["Title"] = "Contact Cytech Engineering"; }
<div class="cy-real">
    <section class="cy-real-page-hero">
        <div class="cy-real-shell"><span class="cy-real-eyebrow">CONTACT / CYTECH ENGINEERING</span><h1>Tell us what<br><em>your project needs.</em></h1><p>Request industrial products, discuss system integration or share a commissioning, maintenance or technical consultation requirement with our team.</p><div class="cy-real-page-meta"><span>INDUSTRIAL SUPPLY</span><span>ENGINEERING SERVICES</span><span>MIRPUR, DHAKA</span></div></div>
    </section>
    <section class="cy-real-content-section">
        <div class="cy-real-shell cy-real-contact-layout">
            <div class="cy-real-form-card">
                <span class="cy-real-eyebrow">01 / SEND A REQUIREMENT</span>
                <h2>Request information or a quotation</h2>
                <p>Include any model numbers, technical specifications, quantities, project location or required timeline. We will review your inquiry.</p>

                @if (TempData["CorporateInquirySuccess"] != null)
                {
                    <div class="cy-real-success" role="status">@TempData["CorporateInquirySuccess"]</div>
                }
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="cy-real-validation" role="alert">@Html.ValidationSummary(false, "Please check your inquiry and try again.")</div>
                }
                <form id="corporateContactForm" method="post" action="/contact">
                    @Html.AntiForgeryToken()
                    <div class="cy-real-form-grid">
                        <div class="cy-real-field"><label asp-for="Name">Full name *</label><input asp-for="Name" maxlength="100" autocomplete="name" placeholder="Your name" required/><span asp-validation-for="Name" class="cy-real-error"></span></div>
                        <div class="cy-real-field"><label asp-for="Company">Company / organization</label><input asp-for="Company" maxlength="120" autocomplete="organization" placeholder="Optional"/></div>
                        <div class="cy-real-field"><label asp-for="Email">Email address *</label><input asp-for="Email" type="email" maxlength="150" autocomplete="email" placeholder="name@company.com" required/><span asp-validation-for="Email" class="cy-real-error"></span></div>
                        <div class="cy-real-field"><label asp-for="Phone">Phone number *</label><input asp-for="Phone" type="tel" maxlength="45" autocomplete="tel" placeholder="+880 ..." required/><span asp-validation-for="Phone" class="cy-real-error"></span></div>
                        <div class="cy-real-field"><label asp-for="ServiceDivision">Service or product area *</label>
                            <select asp-for="ServiceDivision" required>
                                <option value="">Select a relevant service</option>
                                <optgroup label="Services from the 2026 catalogue">
                                @foreach (var service in CytechCatalogue.Services) { <option value="@service.Name">@service.Name</option> }
                                </optgroup>
                                <optgroup label="Other website divisions">
                                    <option value="Electrical Supply & Installation">Electrical Supply &amp; Installation</option>
                                    <option value="Networking Services">Networking Services</option>
                                    <option value="IT & IoT Services">IT &amp; IoT Services</option>
                                    <option value="Manpower Services">Manpower Services</option>
                                </optgroup>
                            </select>
                            <span asp-validation-for="ServiceDivision" class="cy-real-error"></span>
                        </div>
                        <div class="cy-real-field"><label asp-for="InquiryType">Inquiry type</label>
                            <select asp-for="InquiryType">
                                <option value="Request a quotation">Request a quotation</option>
                                <option value="Installation / project inquiry">Installation / project inquiry</option>
                                <option value="Manpower request">Manpower request</option>
                                <option value="Technical consultation">Technical consultation</option>
                                <option value="Support / maintenance">Support / maintenance</option>
                                <option value="General inquiry">General inquiry</option>
                            </select>
                        </div>
                        <div class="cy-real-field cy-real-field-wide"><label asp-for="Details">Requirement details *</label><textarea asp-for="Details" minlength="10" maxlength="1300" placeholder="Describe the products, model numbers, quantities, installation scope, site requirements and timeline..." required></textarea><span asp-validation-for="Details" class="cy-real-error"></span></div>
                    </div>
                    <div class="cy-real-honeypot" aria-hidden="true"><label for="companyWebsite">Leave this blank</label><input id="companyWebsite" name="Website" autocomplete="off" tabindex="-1" /></div>
                    <button type="submit" class="cy-real-btn cy-real-btn-primary cy-real-form-submit">Send inquiry <span aria-hidden="true">↗</span></button>
                    <p class="cy-real-contact-note">Your inquiry is submitted to Cytech Engineering through this website. Sending the form does not constitute an order or confirm product availability.</p>
                </form>
            </div>
            <aside class="cy-real-contact-card">
                <span class="cy-real-eyebrow">02 / DIRECT CONTACT</span><h2>Reach Cytech Engineering.</h2>
                <div class="cy-real-contact-row"><span>PHONE / PRIMARY</span><a href="tel:+8801711015660">+880 1711 015660</a></div>
                <div class="cy-real-contact-row"><span>PHONE / SECONDARY</span><a href="tel:+8801790379729">+880 1790 379729</a></div>
                <div class="cy-real-contact-row"><span>EMAIL</span><a href="mailto:info@cytechbd.com">info@cytechbd.com</a></div>
                <div class="cy-real-contact-row"><span>WEBSITE</span><a href="https://www.cytechbd.com" rel="noopener noreferrer">www.cytechbd.com</a></div>
                <h3>Office address</h3>
                <address>BSCIC Electronic Complex,<br>Level 6, Avenue 4, Road 3,<br>Section 7, Mirpur, Dhaka,<br>Bangladesh.</address>
                <div class="cy-real-detail-note">Contact information is transcribed from page 40 of the Cytech Engineering Industrial Product Catalogue 2026.</div>
            </aside>
        </div>
    </section>
    <section class="cy-real-quote-band"><div class="cy-real-shell cy-real-quote-band-inner"><div><h2>Exploring industrial equipment?</h2><p>Browse the verified product families and identify the section relevant to your requirements.</p></div><a class="cy-real-btn cy-real-btn-dark" href="/products">View the catalogue <span aria-hidden="true">↗</span></a></div></section>
</div>
