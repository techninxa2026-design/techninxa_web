@using Techninxa.Services
@{
    ViewData["Title"] = "About Cytech Engineering";
}
<div class="cy-real cy-real-about">
    <section class="cy-real-page-hero">
        <div class="cy-real-shell">
            <span class="cy-real-eyebrow">ABOUT / CYTECH ENGINEERING</span>
            <h1>Industrial expertise.<br><em>Practical solutions.</em></h1>
            <p>Cytech Engineering is an industrial products supplier and solutions provider spanning automation, electrical instrumentation, networking, safety and power equipment.</p>
            <div class="cy-real-page-meta"><span>INDUSTRIAL PRODUCT SUPPLY</span><span>SYSTEM INTEGRATION</span><span>DHAKA, BANGLADESH</span></div>
        </div>
    </section>

    <section class="cy-real-content-section">
        <div class="cy-real-shell">
            <div class="cy-real-about-lead">
                <div><span class="cy-real-eyebrow">01 / WHO WE ARE</span><h2>Equipment, expertise and support for industrial work.</h2></div>
                <div><p>Cytech Engineering's official 2026 catalogue describes the company as a supplier and solution provider of industrial automation, electrical instrumentation, networking, safety and power products. It emphasizes product quality, technical expertise and reliable after-sales support.</p><div class="cy-real-about-stat" style="margin-top:30px"><strong>Engineering-led solutions</strong><span>Product supply, integration, installation, commissioning, maintenance, support and consultation.</span></div></div>
            </div>
            <div class="cy-real-about-columns">
                <div>
                    <span class="cy-real-eyebrow">02 / WHAT WE DO</span><h3>Our five services</h3>
                    <ul>@foreach (var service in CytechCatalogue.Services) { <li>@service.Name</li> }</ul>
                    <div style="margin-top:22px"><a class="cy-real-text-link" href="/services">Explore our services <span aria-hidden="true">↗</span></a></div>
                </div>
                <div>
                    <span class="cy-real-eyebrow">03 / WHERE WE WORK</span><h3>Industries we serve</h3>
                    <ul>@foreach (var industry in CytechCatalogue.Industries) { <li>@industry</li> }</ul>
                </div>
            </div>
        </div>
    </section>

    <section class="cy-real-section" style="background:#f4f7fa">
        <div class="cy-real-shell">
            <div class="cy-real-section-head"><div><span class="cy-real-eyebrow">04 / WHAT WE SUPPLY</span><h2>38 product sections.<br><em>One connected catalogue.</em></h2></div><div class="cy-real-side-copy"><p>Discover the product types listed in Cytech Engineering's 2026 industrial catalogue.</p><a class="cy-real-text-link" href="/products">Browse our products <span aria-hidden="true">↗</span></a></div></div>
            <div class="cy-real-family-grid">
                @foreach (var family in CytechCatalogue.Families)
                {
                    var items = CytechCatalogue.Items.Where(x => x.Family == family).ToList();
                    <a class="cy-real-family-card cy-about-family-card" href="/products?family=@Uri.EscapeDataString(family)">
                        <div class="cy-pro-family-image">
                            <img src="@CytechProductMedia.For(items[0].Number).Url" alt="@CytechProductMedia.For(items[0].Number).Alt" width="820" height="520" loading="lazy" decoding="async" data-cy-catalogue-photo data-fallback-src="@CytechVisuals.FamilyImage(family)" />
                            <span class="cy-pro-family-photo-number">@items.Count.ToString("D2") / SECTIONS</span>
                        </div>
                        <div class="cy-pro-family-info">
                            <h3>@family</h3>
                            <p>@string.Join(" · ", items.Take(3).Select(x => x.Title))</p>
                            <span class="cy-real-family-link">Browse category <span aria-hidden="true">↗</span></span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
    <section class="cy-real-section">
        <div class="cy-real-shell">
            <div class="cy-real-section-head"><div><span class="cy-real-eyebrow">05 / GET IN TOUCH</span><h2>Based in Mirpur,<br><em>Dhaka.</em></h2></div><div class="cy-real-side-copy"><p>Reach our team about industrial equipment, system integration, commissioning, maintenance or technical consultation.</p></div></div>
            <div class="cy-real-about-columns" style="margin-top:0">
                <div><span class="cy-real-eyebrow">CONTACT DETAILS</span><h3>Speak with Cytech</h3><p><a href="tel:+8801711015660">+880 1711 015660</a></p><p><a href="tel:+8801790379729">+880 1790 379729</a></p><p><a href="mailto:info@cytechbd.com">info@cytechbd.com</a></p><p>www.cytechbd.com</p></div>
                <div><span class="cy-real-eyebrow">OFFICE LOCATION</span><h3>Cytech Engineering</h3><p>BSCIC Electronic Complex,<br>Level 6, Avenue 4, Road 3,<br>Section 7, Mirpur, Dhaka, Bangladesh.</p><a class="cy-real-text-link" href="/contact">Send an inquiry <span aria-hidden="true">↗</span></a></div>
            </div>
        </div>
    </section>
    <section class="cy-real-cta">
        <div class="cy-real-shell cy-real-cta-inner"><div><span class="cy-real-eyebrow">ENGINEERING / PRODUCT SOLUTIONS</span><h2>Planning an industrial<br>project or purchase?</h2><p>Let us know your equipment list or technical requirements.</p></div><div class="cy-real-cta-right"><a class="cy-real-btn cy-real-btn-light" href="/contact">Contact Cytech <span aria-hidden="true">↗</span></a></div></div>
    </section>
</div>
