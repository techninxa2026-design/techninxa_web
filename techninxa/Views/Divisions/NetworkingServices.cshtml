@using Techninxa.Services
@using System.Linq
@{
    ViewData["Title"] = "Industrial Networking & Structured Cabling";
    var ids = new[] { 1, 7, 8, 9, 12, 13, 18, 19, 26, 27 };
    var categories = CytechCatalogue.Items.Where(x => ids.Contains(x.Number)).ToList();
}
<div class="cy-real">
    <section class="cy-real-page-hero">
        <div class="cy-real-shell"><span class="cy-real-eyebrow">CYTECH / INDUSTRIAL NETWORKING</span><h1>Reliable industrial<br><em>connectivity.</em></h1><p>Explore industrial Ethernet switches, routers, fiber media converters, copper and fiber structured cabling, patch panels and network accessories listed in the Cytech Engineering 2026 product catalogue.</p><div class="cy-real-page-meta"><span>INDUSTRIAL ETHERNET</span><span>FIBER OPTICS</span><span>STRUCTURED CABLING</span></div></div>
    </section>
    <section class="cy-real-content-section">
        <div class="cy-real-shell">
            <div class="cy-real-section-head"><div><span class="cy-real-eyebrow">01 / PRODUCT COVERAGE</span><h2>Products for connected<br><em>industrial systems.</em></h2></div><div class="cy-real-side-copy"><p>Reference the product categories in our 2026 catalogue when discussing your networking and structured cabling requirements.</p></div></div>
            <div class="cy-catalogue-grid">
                @foreach (var item in categories)
                    {
                        <partial name="_CatalogueProductCard" model="item" />
                    }
            </div>
        </div>
    </section>
    <section class="cy-real-section" style="background:#f5f8fb">
        <div class="cy-real-shell cy-real-about-lead"><div><span class="cy-real-eyebrow">02 / ENGINEERING SERVICES</span><h2>Connectivity and integration.</h2></div><div><p>The Cytech catalogue lists system integration, installation and commissioning, maintenance and support, and technical consultation among its core services. Discuss the scope of your specific networking project with our team.</p><a class="cy-real-text-link" href="/services">Explore engineering services <span aria-hidden="true">↗</span></a></div></div>
    </section>
    <section class="cy-real-cta"><div class="cy-real-shell cy-real-cta-inner"><div><span class="cy-real-eyebrow">NETWORK INFRASTRUCTURE</span><h2>Tell us what your<br>network requires.</h2><p>Share the environment, network architecture, port count, transmission medium and required equipment.</p></div><div class="cy-real-cta-right"><a href="/contact?service=Networking%20Services" class="cy-real-btn cy-real-btn-light">Request a networking quote <span aria-hidden="true">↗</span></a></div></div></section>
</div>
